# ---- Servidor ----
PORT=3000
IP_SERVIDOR=localhost
SALT=10

# Clave de firma de los JSON Web Token. Genera una aleatoria, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# ---- Certificado TLS ----
# El servidor arranca sobre HTTPS. Para desarrollo puedes generar uno autofirmado:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout ssl/private.key -out ssl/certificate.crt -days 365
SSL_KEY_PATH=./ssl/private.key
SSL_CERT_PATH=./ssl/certificate.crt

# ---- Base de datos MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=xanadb

# ---- Correo saliente (Gmail) ----
# EMAIL_PASSWORD debe ser una contraseña de aplicación, no la del correo.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SECRET_KEY=

# ---- API CIE-11 de la OMS ----
# Alta gratuita en https://icd.who.int/icdapi
OMS_CLIENT_ID=
OMS_CLIENT_SECRET=

# ---- Google Drive (copias de seguridad automáticas) ----
# Ruta al JSON de la cuenta de servicio e ID de la carpeta destino.
GOOGLE_CREDENTIALS_PATH=./credenciales/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
