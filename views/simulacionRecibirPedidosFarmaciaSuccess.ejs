<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estado de Pedidos</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        background-color: #f0f0f0;
      }
      .container {
        text-align: center;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }
      .success {
        background-color: #d4edda;
        color: #155724;
      }
      .error {
        background-color: #f8d7da;
        color: #721c24;
      }
      img {
        max-width: 300px;
        margin-bottom: 20px;
      }
      h1 {
        font-size: 24px;
        margin-bottom: 20px;
      }
    </style>
  </head>
  <body>
    <% if (success) { %>
    <div class="container success">
      <img
        src="/imagenes/imagenesEnfermeroEncargado/farmacia.png"
        alt="Farmacia"
      />
      <h1>Pedidos enviados con éxito a la planta de <%= especialidad %></h1>
    </div>
    <% } else { %>
    <div class="container error">
      <img
        src="/imagenes/imagenesEnfermeroEncargado/farmacia.png"
        alt="Farmacia"
      />
      <h1>
        Ha habido un problema al enviar los pedidos de la Farmacia de la planta
        de <%= especialidad %>
      </h1>
    </div>
    <% } %>
  </body>
</html>
