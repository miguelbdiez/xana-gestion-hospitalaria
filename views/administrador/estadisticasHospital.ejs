    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Gráfico de Ocupación Total del Hospital
        const totalCamas = <%= info.infoEstadisticas.ocupacionTotal.ocupadas %> + <%= info.infoEstadisticas.ocupacionTotal.libres %>;
        const ocupacionHospitalChart = new Chart(document.getElementById('ocupacionHospitalChart'), {
          type: 'doughnut',
          data: {
            labels: ['Ocupadas', 'Libres'],
            datasets: [{
              data: [
                <%= info.infoEstadisticas.ocupacionTotal.ocupadas %>,
                <%= info.infoEstadisticas.ocupacionTotal.libres %>
              ],
              backgroundColor: ['#007bff', '#e9ecef']
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'bottom', labels: { font: { size: 10 } } },
              title: { 
                display: true, 
                text: totalCamas > 0 
                  ? '<%= ((info.infoEstadisticas.ocupacionTotal.ocupadas / (info.infoEstadisticas.ocupacionTotal.ocupadas + info.infoEstadisticas.ocupacionTotal.libres)) * 100).toFixed(1) %>% Ocupado'
                  : 'Sin datos de camas',
                font: { size: 12 }
              }
            }
          }
        });

        // Gráfico de Camas Ocupadas por Especialidad
        const camasEspecialidadChart = new Chart(document.getElementById('camasEspecialidadChart'), {
          type: 'bar',
          data: {
            labels: <%- JSON.stringify(info.infoEstadisticas.ocupacionPorEspecialidad.map(s => s.especialidad)) %>,
            datasets: [{
              label: 'Camas Ocupadas',
              data: <%- JSON.stringify(info.infoEstadisticas.ocupacionPorEspecialidad.map(s => s.ocupadas)) %>,
              backgroundColor: '#007bff'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: { 
                title: { display: true, text: 'Especialidad', font: { size: 10 } },
                ticks: { font: { size: 9 } }
              },
              y: { 
                title: { display: true, text: 'Camas Ocupadas', font: { size: 10 } }, 
                beginAtZero: true,
                ticks: { font: { size: 9 } }
              }
            },
            plugins: {
              legend: { labels: { font: { size: 10 } } }
            }
          }
        });

        // Gráfico de Ocupación por Especialidad
        let ocupacionEspecialidadChart = new Chart(document.getElementById('ocupacionEspecialidadChart'), {
          type: 'doughnut',
          data: {
            labels: ['Ocupadas', 'Libres'],
            datasets: [{
              data: [0, 1],
              backgroundColor: ['#007bff', '#e9ecef']
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'bottom', labels: { font: { size: 10 } } },
              title: { 
                display: true, 
                text: 'Seleccione una especialidad', 
                font: { size: 12 }
              }
            }
          }
        });

        document.getElementById('especialidadSelect').addEventListener('change', (e) => {
          const especialidad = e.target.value;
          if (!especialidad) {
            ocupacionEspecialidadChart.data.datasets[0].data = [0, 1];
            ocupacionEspecialidadChart.options.plugins.title.text = 'Seleccione una especialidad';
            ocupacionEspecialidadChart.update();
            return;
          }

          const especialidadData = <%- JSON.stringify(info.infoEstadisticas.ocupacionPorEspecialidad) %>
            .find(s => s.especialidad === especialidad);
          const camasOcupadas = especialidadData ? especialidadData.ocupadas : 0;
          const camasLibres = especialidadData ? especialidadData.libres : 0;
          const totalCamas = camasOcupadas + camasLibres;

          ocupacionEspecialidadChart.data.datasets[0].data = [camasOcupadas, camasLibres];
          ocupacionEspecialidadChart.options.plugins.title.text = totalCamas > 0 
            ? `${((camasOcupadas / totalCamas) * 100).toFixed(1)}% Ocupado`
            : 'Sin datos';
          ocupacionEspecialidadChart.update();
        });

        // Gráfico de Ingresos y Altas Totales
        const ingresos = <%- JSON.stringify(info.infoEstadisticas.ingresosPorMes) %>;
        const altas = <%- JSON.stringify(info.infoEstadisticas.altasPorMes) %>;
        const ingresosAltasChart = new Chart(document.getElementById('ingresosAltasChart'), {
          type: 'line',
          data: {
            labels: [...new Set([...ingresos.map(i => i.mes), ...altas.map(a => a.mes)])].sort(),
            datasets: [
              {
                label: 'Ingresos',
                data: ingresos.map(i => ({ x: i.mes, y: i.cantidad })),
                borderColor: '#007bff',
                backgroundColor: 'rgba(0, 123, 255, 0.1)',
                fill: true
              },
              {
                label: 'Altas',
                data: altas.map(a => ({ x: a.mes, y: a.cantidad })),
                borderColor: '#28a745',
                backgroundColor: 'rgba(40, 167, 69, 0.1)',
                fill: true
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: { title: { display: true, text: 'Fecha', font: { size: 10 } } },
              y: { title: { display: true, text: 'Cantidad', font: { size: 10 } }, beginAtZero: true }
            },
            plugins: {
              legend: { labels: { font: { size: 10 } } }
            }
          }
        });

        // Gráfico de Ingresos por Especialidad
        const ingresosPorEspecialidad = <%- JSON.stringify(info.infoEstadisticas.ingresosPorEspecialidad) %>;
        const ingresosEspecialidadChart = new Chart(document.getElementById('ingresosEspecialidadChart'), {
          type: 'bar',
          data: {
            labels: ingresosPorEspecialidad.map(i => i.especialidad),
            datasets: [{
              label: 'Ingresos',
              data: ingresosPorEspecialidad.map(i => i.cantidad),
              backgroundColor: '#007bff'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: { title: { display: true, text: 'Especialidad', font: { size: 10 } }, ticks: { font: { size: 9 } } },
              y: { title: { display: true, text: 'Ingresos', font: { size: 10 } }, beginAtZero: true, ticks: { font: { size: 9 } } }
            },
            plugins: {
              legend: { labels: { font: { size: 10 } } }
            }
          }
        });

        // Gráfico de Altas por Especialidad
        const altasPorEspecialidad = <%- JSON.stringify(info.infoEstadisticas.altasPorEspecialidad) %>;
        const altasEspecialidadChart = new Chart(document.getElementById('altasEspecialidadChart'), {
          type: 'bar',
          data: {
            labels: altasPorEspecialidad.map(a => a.especialidad),
            datasets: [{
              label: 'Altas',
              data: altasPorEspecialidad.map(a => a.cantidad),
              backgroundColor: '#28a745'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: { title: { display: true, text: 'Especialidad', font: { size: 10 } }, ticks: { font: { size: 9 } } },
              y: { title: { display: true, text: 'Altas', font: { size: 10 } }, beginAtZero: true, ticks: { font: { size: 9 } } }
            },
            plugins: {
              legend: { labels: { font: { size: 10 } } }
            }
          }
        });
      
        // Gráfico de Diagnósticos Más Frecuentes
        const diagnosticosFrecuentes = <%- JSON.stringify(info.infoEstadisticas.diagnosticosFrecuentes) %>;
        const diagnosticosFrecuentesChart = new Chart(document.getElementById('diagnosticosFrecuentesChart'), {
        type: 'bar',
        data: {
            labels: diagnosticosFrecuentes.map(d => d.descripcion),
            datasets: [{
            label: 'Frecuencia',
            data: diagnosticosFrecuentes.map(d => d.cantidad),
            backgroundColor: '#ff6384'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
            x: { title: { display: true, text: 'Diagnóstico', font: { size: 10 } }, ticks: { font: { size: 9 } } },
            y: { title: { display: true, text: 'Cantidad', font: { size: 10 } }, beginAtZero: true, ticks: { font: { size: 9 } } }
            },
            plugins: {
            legend: { labels: { font: { size: 10 } } }
            }
        }
        });

        // Gráfico de Ingresos por Médico por Mes
        const ingresosPorMedico = <%- JSON.stringify(info.infoEstadisticas.ingresosPorMedicoMes) %>;
        const medicosUnicos = [...new Set(ingresosPorMedico.map(i => i.medico))];
        const mesesUnicos = [...new Set(ingresosPorMedico.map(i => i.mes))].sort();
        const ingresosPorMedicoChart = new Chart(document.getElementById('ingresosPorMedicoChart'), {
        type: 'line',
        data: {
            labels: mesesUnicos,
            datasets: medicosUnicos.map((medico, index) => ({
            label: medico,
            data: mesesUnicos.map(mes => {
                const entry = ingresosPorMedico.find(i => i.medico === medico && i.mes === mes);
                return entry ? entry.cantidad : 0;
            }),
            borderColor: ['#ff6384', '#36a2eb', '#ffce56', '#4bc0c0', '#9966ff'][index % 5],
            backgroundColor: ['rgba(255, 99, 132, 0.1)', 'rgba(54, 162, 235, 0.1)', 'rgba(255, 206, 86, 0.1)', 'rgba(75, 192, 192, 0.1)', 'rgba(153, 102, 255, 0.1)'][index % 5],
            fill: true
            }))
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
            x: { title: { display: true, text: 'Mes', font: { size: 10 } } },
            y: { title: { display: true, text: 'Ingresos', font: { size: 10 } }, beginAtZero: true }
            },
            plugins: {
            legend: { labels: { font: { size: 10 } } }
            }
        }
        });
        
      });
    </script>
    
   
  </body>
</html>
