              <main>
                <p class="text-center">Nuevo Mensaje</p>
                <form id="messageForm">
                    <div class="form-row mb-3">
                        <label for="from" class="col-2 col-sm-1 col-form-label">De:</label>
                        <div class="col-10 col-sm-11">
                            <input type="email" class="form-control" id="from"  value="<%=info.correo_electronico%>"  placeholder="<%=info.correo_electronico%>" disabled>
                        </div>
                    </div>
                    <div class="form-row mb-3">
                        <label for="to" class="col-2 col-sm-1 col-form-label">Para:</label>
                        <div class="col-10 col-sm-11">
                            <input type="email" class="form-control" id="to" placeholder="Type email" required>
                            <div id="error-message" style="display: none; color: red;"></div>
                        </div>
                    </div>
                    <div class="form-row mb-3">
                        <label for="asunto" class="col-2 col-sm-1 col-form-label">Asunto:</label>
