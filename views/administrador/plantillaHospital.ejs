          <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div
              class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
            >
              <h1 id="nombreDelUsuario">Administración</h1>
              <div class=" d-flex align-items-center">
                <a id="btnVolverLista" class="call-btn btn-img me-2" href="/home">
                  <img
                    src="/imagenes/volver.png"
                    alt="Volver"
                    style="width: 24px; height: 24px"
                  />
                </a>
                <h2 class="m-0">Consultar Empleados</h2>
              </div>
            </div>
            <div class="empleados-section">
              <div class="scrollable-content">
                <div class="container mt-3">
                  <div class="row align-items-center mb-4">
                    <div class="col-auto">
                      <h2>Consultar Empleados</h2>
                    </div>
                    <div class="col-auto ms-auto">
                      <button class="btn btn-primary btn-sm" id="btnRegistrarEmpleado">
                        Registrar Empleado
                      </button>
                    </div>
                  </div>
          
                  <!-- Filtros -->
                  <div class="row mb-4 g-3">
                    <div class="col-md-4">
                      <div class="input-group input-group-sm">
                        <span class="input-group-text bg-primary text-white">
                          <i class="fas fa-user"></i>
                        </span>
                        <input
                          type="text"
                          id="filtroNombre"
                          class="form-control"
                          placeholder="Filtrar por nombre"
                        />
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="input-group input-group-sm">
                        <span class="input-group-text bg-primary text-white">
                          <i class="fas fa-building"></i>
                        </span>
                        <select id="filtroDepartamento" class="form-select">
                          <option value="">Todos los departamentos</option>
                          <% info.especialidades.forEach(espec => { %>
                          <option value="<%= espec.especialidad %>"><%= espec.especialidad %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="input-group input-group-sm">
                        <span class="input-group-text bg-primary text-white">
                          <i class="fas fa-user-tag"></i>
                        </span>
                        <select id="filtroRol" class="form-select">
                          <option value="">Todos los roles</option>
                          <% [...new Set(info.empleadosHospital.map(emp => emp.rol))].sort().forEach(rol => { %>
                          <option value="<%= rol %>"><%= rol %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                  </div>
          
                  <!-- Tabla -->
                  <div class="card shadow empleados-card">
                    <div class="card-body p-0">
                      <div class="table-responsive">
                        <table
                          id="tablaEmpleados"
                          class="table table-striped table-bordered table-hover mb-0"
                          style="width: 100%; min-width: 800px;"
                        >
                          <thead class="bg-primary text-white">
                            <tr>
                              <th>Nombre</th>
                              <th>Departamento</th>
                              <th>Rol</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (info.empleadosHospital && Array.isArray(info.empleadosHospital)) { %>
                              <% info.empleadosHospital.forEach(empleado => { %>
                                <tr
                        Ascendant class="empleado-row" data-empleado='<%- JSON.stringify(empleado) %>'>
                                  <td class="nombre"><%= empleado.empleado_nombre_completo || 'No especificado' %></td>
                                  <td><%= empleado.departamento || 'No especificado' %></td>
                                  <td><%= empleado.rol || 'No especificado' %></td>
                                </tr>
                              <% }) %>
                            <% } else { %>
                              <tr>
                                <td colspan="3" class="empleados-no-data">No hay empleados disponibles.</td>
                              </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                  <div class="bottom-spacer"></div> <!-- Espacio adicional en la parte inferior -->
                </div>
              </div>
            </div>
          </main>
    </div>

    <!-- Modal para detalles del empleado -->
    <div
    class="modal fade"
    id="empleadoModal"
    tabindex="-1"
    aria-labelledby="empleadoModalLabel"
    aria-hidden="true"
    data-id=""
  >
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="empleadoModalLabel">Detalles del Empleado</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <!-- Información del empleado -->
          <div id="infoEmpleado" class="row g-3">
            <div class="col-md-6">
              <p><strong>Nombre:</strong> <span id="modalNombre"></span></p>
              <p><strong>Primer Apellido:</strong> <span id="modalApellido1"></span></p>
              <p><strong>Segundo Apellido:</strong> <span id="modalApellido2"></span></p>
              <p><strong>Rol:</strong> <span id="modalRol"></span></p>
              <p><strong>Teléfono:</strong> <span id="modalTelefono"></span></p>
              <p><strong>Correo Electrónico:</strong> <span id="modalCorreo"></span></p>
            </div>
            <div class="col-md-6">
              <p><strong>Dirección:</strong> <span id="modalDireccion"></span></p>
              <p><strong>Nº Seguridad Social:</strong> <span id="modalSeguridadSocial"></span></p>
              <p><strong>Nº de Cuenta:</strong> <span id="modalCuenta"></span></p>
              <p><strong>Fecha de Nacimiento:</strong> <span id="modalFechaNacimiento"></span></p>
              <p><strong>DNI:</strong> <span id="modalDni"></span></p>
              <p><strong>Especialidad:</strong> <span id="modalEspecialidad"></span></p>
            </div>

            <div class="mt-4" >
              <h6>Trasladar a otro departamento</h6>
              <div class="input-group mb-3">
                <span class="input-group-text bg-primary text-white">
                  <i class="fas fa-building"></i>
                </span>
                <select id="nuevaEspecialidad" class="form-select">
                  <option value="">Seleccionar especialidad</option>
                  <% info.especialidades.forEach(espec => { %>
                  <option value="<%= espec.especialidad %>"><%= espec.especialidad %></option>
                  <% }) %>
                </select>
                <button class="btn btn-primary" id="btnTrasladar">Trasladar</button>
              </div>
            </div>
          </div>
  
          <!-- Formulario para trasladar de departamento -->
          
  
          <!-- Formulario para modificar datos -->
          <div class="mt-4" id="formEditar" style="display: none;">
            <h6>Editar Información del Empleado</h6>
            <form id="formularioEditar" class="row g-3">
              <div class="col-md-6">
                <label for="editNombre" class="form-label">Nombre</label>
                <input type="text" class="form-control" id="editNombre" readonly>
              </div>
              <div class="col-md-6">
                <label for="editApellido1" class="form-label">Primer Apellido</label>
                <input type="text" class="form-control" id="editApellido1" readonly>
              </div>
              <div class="col-md-6">
                <label for="editApellido2" class="form-label">Segundo Apellido</label>
                <input type="text" class="form-control" id="editApellido2" readonly>
              </div>
              <div class="col-md-6">
                <label for="editTelefono" class="form-label">Teléfono</label>
                <input type="text" class="form-control" id="editTelefono" required>
              </div>
              <div class="col-md-6">
                <label for="editCorreo" class="form-label">Correo Electrónico</label>
                <input type="email" class="form-control" id="editCorreo" required>
              </div>
              <div class="col-md-6">
                <label for="editDireccion" class="form-label">Dirección</label>
                <input type="text" class="form-control" id="editDireccion" required>
              </div>
              <div class="col-md-6">
                <label for="editSeguridadSocial" class="form-label">Nº Seguridad Social</label>
                <input type="text" class="form-control" id="editSeguridadSocial" required>
              </div>
              <div class="col-md-6">
                <label for="editCuenta" class="form-label">Nº de Cuenta</label>
                <input type="text" class="form-control" id="editCuenta" required>
              </div>
              <div class="col-md-6">
                <label for="editFechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                <input type="date" class="form-control" id="editFechaNacimiento" readonly>
              </div>
              <div class="col-md-6">
                <label for="editDni" class="form-label">DNI</label>
                <input type="text" class="form-control" id="editDni" readonly>
              </div>
              <div class="col-12">
                <button type="button" class="btn btn-success" id="btnGuardarCambios">Guardar</button>
                <button type="button" class="btn btn-secondary" id="btnDescartarCambios">Descartar</button>
              </div>
            </form>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
          <button type="button" class="btn btn-primary" id="btnModificar">Modificar</button>
        </div>
      </div>
    </div>
  </div>

    <div
      class="modal fade"
      id="modalLlamando"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name">Llamando</p>
                <p
                  data-Persona-a-la-que-se-llama-id=""
                  id="persona_a_la_que_se_llama"
                ></p>
              </div>
            </div>
            <div class="footer">
              <!-- Este bloque contiene el nombre y se coloca encima del segundo footer -->

