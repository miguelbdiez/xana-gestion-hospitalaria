                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Finalizar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalLLamadaEnCurso"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name"></p>
                <p
                  class=""
                  data-Persona-Con-La-Que-Se-Habla-Id=""
                  id="persona_con_la_que_se_habla"
                ></p>
                <!-- Agregamos el cronómetro aquí -->
                <p id="callTimer">00:00</p>
              </div>
            </div>
            <div class="footer">
              <button
                class="bouton raccrocher"
                id="btnFinalizarLLamadaEnCurso"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Finalizar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalLlamandaEntrante"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <!-- Header que ya tenías -->
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name">Llamanda Entrante</p>
                <p
                  class=""
                  data-Persona-que-llama-id=""
                  id="Persona_que_llama"
                ></p>
              </div>
            </div>
            <div class="footer">
              <!-- Segundo bloque de footer con los botones -->
              <button
                class="bouton accepter"
                id="btnAceptarLlamada"
                title="Aceptar"
              >
                <span class="icon green">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M20.707 5.293a1 1 0 00-1.414 0L9 15.586 4.707 11.293a1 1 0 00-1.414 1.414l5 5a1 1 0 001.414 0l11-11a1 1 0 000-1.414z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Aceptar</span>
              </button>

              <button
                class="bouton raccrocher"
                id="btnRechazarLlamada"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Colgar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Modal -->

    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>

    <!-- Scripts necesarios -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
   

    <script>
        const empleados = <%- JSON.stringify(info.empleadosHospital) %>;
      
        document.addEventListener('DOMContentLoaded', () => {
          // Inicializar DataTables
          const table = new DataTable('#tablaEmpleados', {
            language: {
              url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json'
            },
            pageLength: 10,
            order: [[1, 'asc']] // Ordenar por nombre por defecto
          });
      
          // Filtros
          const filtroNombre = document.getElementById('filtroNombre');
          const filtroDepartamento = document.getElementById('filtroDepartamento');
          const filtroRol = document.getElementById('filtroRol');
      
          filtroNombre.addEventListener('input', () => {
            table.column(0).search(filtroNombre.value).draw();
          });
      
          filtroDepartamento.addEventListener('change', () => {
            table.column(1).search(filtroDepartamento.value).draw();
          });
      
          filtroRol.addEventListener('change', () => {
            table.column(2).search(filtroRol.value).draw();
          });
          document.getElementById('btnRegistrarEmpleado').addEventListener('click', () => {
            window.location.href = '/registrarUsuario';
          });

          const tablaEmpleados = document.getElementById('tablaEmpleados');
          const modal = new bootstrap.Modal(document.getElementById('empleadoModal'));
          const modalElement = document.getElementById('empleadoModal');
          const infoEmpleado = document.getElementById('infoEmpleado');
          const formEditar = document.getElementById('formEditar');
          const btnModificar = document.getElementById('btnModificar');
          const btnTrasladar = document.getElementById('btnTrasladar');
          const btnGuardarCambios = document.getElementById('btnGuardarCambios');
          const btnDescartarCambios = document.getElementById('btnDescartarCambios');

          // Evento clic en fila
          tablaEmpleados.querySelector('tbody').addEventListener('click', async (event) => {
            const row = event.target.closest('.empleado-row');
            if (!row) return;

            const empleado = JSON.parse(row.dataset.empleado);
            const id = empleado.id;

            try {
              // Petición GET para obtener información completa del empleado
              const response = await fetch(`/recuperarInformacionEmpleado?id=${id}`);
              if (!response.ok) throw new Error('Error al obtener información del empleado');
              const dataRespuesta = await response.json();
              const data = dataRespuesta[0];

              // Guardar ID en atributo data-id
              modalElement.dataset.id = data.id || '';

              // Rellenar información en el modal
              document.getElementById('modalNombre').textContent = data.nombre || '';
              document.getElementById('modalApellido1').textContent = data.apellido1 || '';
              document.getElementById('modalApellido2').textContent = data.apellido2 || '';
              document.getElementById('modalRol').textContent = data.rol || '';
              document.getElementById('modalTelefono').textContent = data.telefono || 'No especificado';
              document.getElementById('modalCorreo').textContent = data.correo_electronico || '';
              document.getElementById('modalDireccion').textContent = data.direccion || 'No especificado';
              document.getElementById('modalSeguridadSocial').textContent = data.numero_seguridad_social || 'No especificado';
              document.getElementById('modalCuenta').textContent = data.numero_de_cuenta || '';
              document.getElementById('modalFechaNacimiento').textContent = data.fecha_nacimiento ? new Date(data.fecha_nacimiento).toLocaleDateString() : 'No especificado';
              document.getElementById('modalDni').textContent = data.dni || '';
              document.getElementById('modalEspecialidad').textContent = data.departamento || 'No especificado';

              // Rellenar formulario de edición
              document.getElementById('editNombre').value = data.nombre || '';
              document.getElementById('editApellido1').value = data.apellido1 || '';
              document.getElementById('editApellido2').value = data.apellido2 || '';
              document.getElementById('editTelefono').value = data.telefono || '';
              document.getElementById('editCorreo').value = data.correo_electronico || '';
              document.getElementById('editDireccion').value = data.direccion || '';
              document.getElementById('editSeguridadSocial').value = data.numero_seguridad_social || '';
              document.getElementById('editCuenta').value = data.numero_de_cuenta || '';
              document.getElementById('editFechaNacimiento').value = data.fecha_nacimiento ? new Date(data.fecha_nacimiento).toISOString().split('T')[0] : '';
              document.getElementById('editDni').value = data.dni || '';

              // Mostrar modal
              infoEmpleado.style.display = 'block';
              formEditar.style.display = 'none';
              modal.show();
            } catch (error) {
              console.error('Error:', error);
              alert('Error al cargar la información del empleado');
            }
          });

          // Evento para mostrar formulario de edición
          btnModificar.addEventListener('click', () => {
            infoEmpleado.style.display = 'none';
            formEditar.style.display = 'block';
          });

          // Evento para trasladar departamento
          btnTrasladar.addEventListener('click', async () => {
            const nuevaEspecialidad = document.getElementById('nuevaEspecialidad').value;
            const id = modalElement.dataset.id;

            if (!nuevaEspecialidad) {
              alert('Por favor, selecciona una especialidad');
              return;
            }

            try {
              const response = await fetch('/actualizarEspecialidadEmpleado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, nuevaEspecialidad}),
              });

              if (response.ok) {
                window.location.reload();
              } else {
                throw new Error('Error al cambiar la especialidad');
              }
            } catch (error) {
              console.error('Error:', error);
              alert('Error al cambiar la especialidad del empleado');
            }
          });

          // Evento para guardar cambios
          btnGuardarCambios.addEventListener('click', async () => {
            const id = modalElement.dataset.id;
            const updatedData = {
              id,
              nombre: document.getElementById('editNombre').value,
              apellido1: document.getElementById('editApellido1').value,
              apellido2: document.getElementById('editApellido2').value,
              telefono: document.getElementById('editTelefono').value,
              correo_electronico: document.getElementById('editCorreo').value,
              direccion: document.getElementById('editDireccion').value,
              numero_seguridad_social: document.getElementById('editSeguridadSocial').value,
              numero_de_cuenta: document.getElementById('editCuenta').value,
              fecha_nacimiento: document.getElementById('editFechaNacimiento').value,
              dni: document.getElementById('editDni').value,
            };

            try {
              const response = await fetch('/actualizarInformacionEmpleado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(updatedData),
              });

              if (response.ok) {
                window.location.reload();
              } else {
                throw new Error('Error al actualizar la información');
              }
            } catch (error) {
              console.error('Error:', error);
              alert('Error al actualizar la información del empleado');
            }
          });

          // Evento para descartar cambios
          btnDescartarCambios.addEventListener('click', () => {
            infoEmpleado.style.display = 'block';
            formEditar.style.display = 'none';
          });
         
          
      
      
        });
    </script>
   
  </body>
</html>
