  <body class="d-flex align-items-center py-4 bg-body-tertiary">
    <main class="form-signin w-100 m-auto">
      <form id="changePasswordForm">
        <img
          class="mb-4"
          src="../imagenes/xanaLogo.png"
          alt=""
          width="92"
          height="57"
        />
        <h1 class="h3 mb-3 fw-normal" data-id="<%= info.id %>">
          <%= info.nombre %>
        </h1>
        <h1 class="h3 mb-3 fw-normal">Cambie su contraseña</h1>

        <div class="form-floating">
          <input
            type="text"
            class="form-control"
            id="floatingPassword"
            placeholder="name@example.com"
          />
          <label for="floatingInput">Nueva Contraseña</label>
        </div>
        <div class="form-floating">
          <input
            type="password"
            class="form-control"
            id="floatingPasswordConfirm"
            placeholder="Confirmar Contraseña"
          />
          <label for="floatingContraseñaConfirm">Confirmar Contraseña</label>
        </div>
        <p id="error-message" style="color: red; display: none">
          Las contraseñas no coinciden. Intenta de nuevo.
        </p>

        <button
          class="btn btn-primary w-100 py-2"
          id="btmAceptar"
          type="submit"
        >
          Aceptar
        </button>
      </form>
      <!-- Mensaje de éxito oculto -->
      <div id="success-message" style="display: none">
        <h4>¡Contraseña actualizada con éxito!</h4>
        <p>Ahora puedes volver a la página de inicio.</p>
        <a class="btn btn-success" href="/">Volver a Inicio</a>
      </div>

      <p class="mt-5 mb-3 text-body-secondary">
        &copy; TFG 2025 xana Industries
      </p>
    </main>
    <script>
      document
        .getElementById("btmAceptar")
        .addEventListener("click", async function (event) {
          event.preventDefault(); // Evita el envío del formulario si hay errores

          let password = document.getElementById("floatingPassword").value;
          let confirmPassword = document.getElementById(
            "floatingPasswordConfirm"
          ).value;
          let errorMessage = document.getElementById("error-message");
          let successMessage = document.getElementById("success-message");
          let form = document.getElementById("changePasswordForm");

          // Expresión regular para validar la seguridad de la contraseña
          let strongPasswordRegex =
            /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;

          // Verificar si las contraseñas coinciden
          if (password !== confirmPassword) {
            errorMessage.textContent = "Las contraseñas no coinciden.";
            errorMessage.style.display = "block";
            return;
          }

          // Verificar si la contraseña cumple con los requisitos de seguridad
          if (!strongPasswordRegex.test(password)) {
            errorMessage.textContent =
              "La contraseña debe tener al menos 8 caracteres, una mayúscula, una minúscula, un número y un carácter especial.";
            errorMessage.style.display = "block";
            return;
          }
          try {
            const h1 = document.querySelector("h1");
            const id = h1.dataset.id;
            console.log(id);
            console.log("enviado");
            fetch("/resetearContrasena", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ password, id }),
            })
              .then((response) => response.json())
              .then((data) => {
                if (data.success === true) {
                  form.style.display = "none";
                  successMessage.style.display = "block";
                } else {
                  errorMessage.textContent =
                    "Ha ocurrido un error al conectar con el servidor, intentelo de nuevo mas tarde";
                  errorMessage.style.display = "block";
                }
              });
          } catch {
            errorMessage.textContent =
              "Ha ocurrido un error al conectar con el servidor, intentelo de nuevo mas tarde";
            errorMessage.style.display = "block";
            return;
          }
        });
    </script>
  </body>
</html>
