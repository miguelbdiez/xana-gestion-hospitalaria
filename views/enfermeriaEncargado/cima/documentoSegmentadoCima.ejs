    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>


    <script>
      document.addEventListener("DOMContentLoaded", async () => {
        // Configurar exclusión para cada par
        const nregistroInput = document.getElementById("nregistro");
        const searchButton = document.getElementById("search-btn");
        const fichaTecnicaBtn = document.getElementById("fichaTecnicaBtn");
        const prospectoBtn = document.getElementById("prospectoBtn");
        const fichaTecnicaSelect =
          document.getElementById("fichaTecnicaSelect");
        const prospectoSelect = document.getElementById("prospectoSelect");
        const fichaTecnicaSection = document.getElementById(
          "fichaTecnicaSection"
        );
        const prospectoSection = document.getElementById("prospectoSection");
        const resultadoSecciones =
          document.getElementById("resultadoSecciones");
        const resultadoContenido =
          document.getElementById("resultadoContenido");

        function populateSelect(selectElement, data) {
          // Limpiar opciones existentes (excepto "Mostrar todo")
          const option = document.createElement("option");
          option.value = null;
          option.text = `Mostrar Todo`;
          selectElement.appendChild(option);

          // Asumimos que data contiene una lista de secciones con "seccion" y "titulo"
          data.forEach((seccion) => {
            const option = document.createElement("option");
            option.value = seccion.seccion;
            option.text = `${seccion.seccion} - ${seccion.titulo}`;
            selectElement.appendChild(option);
          });
        }
        // const resultadoDiv = document.getElementById("resultadoMedicamento");
        const resultadoDiv = document.getElementById("resultadoContenido");

        searchButton.addEventListener("click", async () => {
          resultadoSecciones.innerHTML = "";
          resultadoContenido.innerHTML = "";
          const nregistro = nregistroInput.value.trim();

          if (!nregistro) {
            resultadoContenido.innerHTML =
              '<p class="error">Por favor, introduce el número de registro.</p>';
            resultadoContenido.style.display = "block";
            fichaTecnicaSection.style.display = "none";
            prospectoSection.style.display = "none";
            return;
          }

          // Mostrar las secciones
          fichaTecnicaSection.style.display = "block";
          prospectoSection.style.display = "block";

          try {
            // Fetch para Ficha Técnica (sección inicial como ejemplo)
            const urlFichaTecnica = `https://cima.aemps.es/cima/rest/docSegmentado/secciones/1?nregistro=${nregistro}`;
            const responseFichaTecnica = await fetch(urlFichaTecnica);
            if (!responseFichaTecnica.ok) {
              throw new Error(
                `Error al obtener ficha técnica: ${responseFichaTecnica.status}`
              );
            }
            const dataFichaTecnica = await responseFichaTecnica.json();
            // Llenar el select de Ficha Técnica con los datos obtenidos
            populateSelect(fichaTecnicaSelect, dataFichaTecnica);

            // Fetch para Prospecto (sección inicial como ejemplo)
            const urlProspecto = `https://cima.aemps.es/cima/rest/docSegmentado/secciones/2?nregistro=${nregistro}`;
            const responseProspecto = await fetch(urlProspecto);
            if (!responseProspecto.ok) {
              throw new Error(
                `Error al obtener prospecto: ${responseProspecto.status}`
              );
            }
            const dataProspecto = await responseProspecto.json();
            // Llenar el select de Prospecto con los datos obtenidos
            populateSelect(prospectoSelect, dataProspecto);

            // Mostrar los resultados iniciales
          } catch (error) {
            resultadoContenido.innerHTML = `<p class="error">${error.message}</p>`;
            resultadoContenido.style.display = "block";
          }
        });

        // Evento para el botón de Ficha Técnica
        fichaTecnicaBtn.addEventListener("click", async () => {
          resultadoSecciones.innerHTML = "";
          resultadoContenido.innerHTML = "";
          const nregistro = nregistroInput.value.trim();
          const selectedSection = fichaTecnicaSelect.value;

          if (!nregistro) {
            resultadoContenido.innerHTML =
              '<p class="error">Por favor, introduce el número de registro.</p>';
            resultadoContenido.style.display = "block";
            return;
          }

          try {
            const urlFichaTecnicaContenido = `https://cima.aemps.es/cima/rest/docSegmentado/contenido/1?nregistro=${nregistro}&seccion=${selectedSection}`;
            const responseFichaTecnica = await fetch(urlFichaTecnicaContenido);
            const dataFichaTecnica = await responseFichaTecnica.json();

            // Crear la tabla con los datos
            let tableHTML = `
            <h3>Ficha Técnica - Sección ${selectedSection}</h3>
            <table class="table-custom">
              <thead>
                <tr>
                  <th>Sección</th>
                  <th>Título</th>
                  <th>Contenido</th>
                </tr>
              </thead>
              <tbody>
          `;
            dataFichaTecnica.forEach((item) => {
              tableHTML += `
              <tr>
                <td>${item.seccion}</td>
                <td class="title-col">${item.titulo}</td>
                <td>${item.contenido !== undefined ? item.contenido : ""}</td>
              </tr>
            `;
            });
            tableHTML += `
              </tbody>
            </table>
          `;

            // Mostrar la tabla en resultadoContenido
            resultadoContenido.innerHTML = tableHTML;
            resultadoContenido.style.display = "block";
          } catch (error) {
            resultadoContenido.innerHTML = `<p class="error">${error.message}</p>`;
            resultadoContenido.style.display = "block";
          }
        });

        // Evento para el botón de Prospecto
        prospectoBtn.addEventListener("click", async () => {
          resultadoContenido.innerHTML = "";
          const nregistro = nregistroInput.value.trim();
          const selectedSection = prospectoSelect.value;

          if (!nregistro) {
            resultadoContenido.innerHTML =
              '<p class="error">Por favor, introduce el número de registro.</p>';
            resultadoContenido.style.display = "block";
            return;
          }

          try {
            const urlFichaTecnicaContenido = `https://cima.aemps.es/cima/rest/docSegmentado/contenido/2?nregistro=${nregistro}&seccion=${selectedSection}`;
            const responseFichaTecnica = await fetch(urlFichaTecnicaContenido);
            const dataFichaTecnica = await responseFichaTecnica.json();

            // Crear la tabla con los datos
            let tableHTML = `
            <h3>Ficha Técnica - Sección ${selectedSection}</h3>
            <table class="table-custom">
              <thead>
                <tr>
                  <th>Sección</th>
                  <th>Título</th>
                  <th>Contenido</th>
                </tr>
              </thead>
              <tbody>
          `;
            dataFichaTecnica.forEach((item) => {
              tableHTML += `
              <tr>
                <td>${item.seccion}</td>
                <td class="title-col">${item.titulo}</td>
                <td>${item.contenido !== undefined ? item.contenido : ""}</td>
              </tr>
            `;
            });
            tableHTML += `
              </tbody>
            </table>
          `;

            // Mostrar la tabla en resultadoContenido
            resultadoContenido.innerHTML = tableHTML;
            resultadoContenido.style.display = "block";
          } catch (error) {
            resultadoContenido.innerHTML = `<p class="error">${error.message}</p>`;
            resultadoContenido.style.display = "block";
          }
        });
      });
    </script>
  </body>
</html>
