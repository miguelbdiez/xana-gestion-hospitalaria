    <div class="modal fade incidencia-modal" id="incidenciaModal" tabindex="-1" aria-labelledby="incidenciaModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="incidenciaModalLabel">Gestión de Incidencias</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Lista de incidencias -->
            <div class="mb-3">
              <h6>Incidencias Asociadas</h6>
              <ul id="incidenciasLista" class="list-group">
                <% if (info.infoIncidencias && info.infoIncidencias.length > 0) { %>
                  <% info.infoIncidencias.forEach(incidencia => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <div data-id_incidencia=" <%= incidencia.id_incidencia %>">
                        <strong>Descripcion: </strong> - <%= incidencia.informacion_incidencia %>
                        <br>
                        <small>
                          Episodio: <%= incidencia.ingreso_id %> | 
                          Estado: <%= incidencia.activa ? 'Activa' : 'Inira' %> | 
                          Fecha de emisión: <%= incidencia.fecha_emision %> 
                          <% if (!incidencia.activa && incidencia.fecha_desactivacion) { %>
                            | Fecha de desactivación: <%= incidencia.fecha_desactivacion %>
                          <% } %>
                        </small>
                      </div>
                      <% if (incidencia.activa) { %>
                        <button class="btn btn-danger btn-sm desactivar-incidencia" data-id-incidencia="<%= incidencia.id_incidencia %>" data-id-ingreso="<%= incidencia.ingreso_id %>">Desactivar</button>
                      <% } %>
                    </li>
                  <% }); %>
                <% } else { %>
                  <li class="list-group-item">No hay incidencias asociadas.</li>
                <% } %>
              </ul>
            </div>
            <!-- Botón para añadir nueva incidencia -->
            <button type="button" class="btn btn-primary mb-3" id="btnNuevaIncidencia">Nueva Incidencia</button>
            <!-- Formulario para nueva incidencia (oculto inicialmente) -->
            <div id="nuevaIncidenciaForm" style="display: none;">
              <div class="mb-3">
                <label for="incidenciaCuerpo" class="form-label">Descripción de la Incidencia:</label>
                <textarea class="form-control" id="incidenciaCuerpo" rows="4" placeholder="Escriba los detalles de la incidencia"></textarea>
              </div>
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" id="btnCancelarIncidencia">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnAceptarIncidencia">Aceptar</button>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
          </div>
        </div>
      </div>
    </div>
    
    <div class="modal fade edit-info-modal" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="editModalLabel">Editar Información del Paciente</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="form-column">
                <!-- Campos no editables -->
                <div class="mb-3">
                  <label>PACIENTE:</label>
                  <p><%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>MÉDICO:</label>
                  <p><%= info.infoCabecera.medico_nombre_completo || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>SERVICIO:</label>
                  <p><%= info.infoCabecera.especialidad || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>FECHA DE INGRESO:</label>
                  <p><%= info.infoCabecera.fecha_ini || 'No disponible' %></p>
                </div>
                <!-- Diagnóstico (solo editable por médico) -->
                <div class="mb-3">
                  <label for="modalDiagnostico">DIAGNÓSTICO:</label>
                  <input type="text" class="form-control" id="modalDiagnostico" value="<%= info.infoCabecera.diagnostico || 'No especificado' %>" 
                         <%= info.rol === 'medico' ? '' : 'disabled' %>>
                </div>
                <!-- Alergias -->
                <div class="mb-3">
                  <label>ALERGIAS:</label>
                  <div class="d-flex flex-wrap">
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaNinguna" value="ninguna" 
                             <%= (!info.infoCabecera.tipo_alergia || info.infoCabecera.tipo_alergia === 'ninguna') ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaNinguna">Ninguna</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaLeve" value="leve" 
                             <%= info.infoCabecera.tipo_alergia === 'leve' ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaLeve">Leve</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaModerada" value="moderada" 
                             <%= info.infoCabecera.tipo_alergia === 'moderada' ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaModerada">Moderada</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaGrave" value="grave" 
                             <%= info.infoCabecera.tipo_alergia === 'grave' ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaGrave">Grave</label>
                    </div>
                  </div>
                  <input type="text" class="form-control mt-2" id="modalAlergia" placeholder="Especifique alergia" 
                         value="<%= info.infoCabecera.alergia || '' %>" 
                         <%= (!info.infoCabecera.tipo_alergia || info.infoCabecera.tipo_alergia === 'ninguna') ? 'disabled' : '' %>>
                </div>
              </div>
              <div class="form-column">
                <!-- Dieta -->
                <div class="mb-3">
                  <label>DIETA:</label>
                  <div class="d-flex flex-wrap">
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaNinguna" value="ninguna" 
                             <%= (!info.infoCabecera.tipo_dieta || info.infoCabecera.tipo_dieta === 'ninguna') ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaNinguna">Ninguna</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaNormal" value="normal" 
                             <%= info.infoCabecera.tipo_dieta === 'normal' ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaNormal">Normal</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaBlanda" value="blanda" 
                             <%= info.infoCabecera.tipo_dieta === 'blanda' ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaBlanda">Blanda</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaLiquida" value="liquidos" 
                             <%= info.infoCabecera.tipo_dieta === 'liquidos' ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaLiquida">Líquida</label>
                    </div>
                  </div>
                  <input type="text" class="form-control mt-2" id="modalDieta" placeholder="Especifique dieta" 
                         value="<%= info.infoCabecera.dieta || '' %>" 
                         <%= (!info.infoCabecera.tipo_dieta || info.infoCabecera.tipo_dieta === 'ninguna') ? 'disabled' : '' %>>
                </div>
                <!-- Aislamiento -->
                <div class="mb-3">
                  <label>AISLAMIENTO:</label>
                  <div class="d-flex">
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="aislamiento" id="aislamientoNo" value="no" 
                             <%= info.infoCabecera.aislamiento ? '' : 'checked' %>>
                      <label class="form-check-label" for="aislamientoNo">No</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="aislamiento" id="aislamientoSi" value="si" 
                             <%= info.infoCabecera.aislamiento ? 'checked' : '' %>>
                      <label class="form-check-label" for="aislamientoSi">Sí</label>
                    </div>
                  </div>
                </div>
                <!-- Grupo Sanguíneo (Select) -->
                <div class="mb-3">
                  <label for="modalGrupoSanguineo">GRUPO SANGUÍNEO:</label>
                  <select class="form-control" id="modalGrupoSanguineo">
                    <option value="No especificado" <%= info.infoCabecera.grupo_rh === 'No especificado' || !info.infoCabecera.grupo_rh ? 'selected' : '' %>>No especificado</option>
                    <option value="A+" <%= info.infoCabecera.grupo_rh === 'A+' ? 'selected' : '' %>>A+</option>
                    <option value="A-" <%= info.infoCabecera.grupo_rh === 'A-' ? 'selected' : '' %>>A-</option>
                    <option value="B+" <%= info.infoCabecera.grupo_rh === 'B+' ? 'selected' : '' %>>B+</option>
                    <option value="B-" <%= info.infoCabecera.grupo_rh === 'B-' ? 'selected' : '' %>>B-</option>
                    <option value="AB+" <%= info.infoCabecera.grupo_rh === 'AB+' ? 'selected' : '' %>>AB+</option>
                    <option value="AB-" <%= info.infoCabecera.grupo_rh === 'AB-' ? 'selected' : '' %>>AB-</option>
                    <option value="O+" <%= info.infoCabecera.grupo_rh === 'O+' ? 'selected' : '' %>>O+</option>
                    <option value="O-" <%= info.infoCabecera.grupo_rh === 'O-' ? 'selected' : '' %>>O-</option>
                  </select>
                </div>
                <!-- Campos no editables -->
                <div class="mb-3">
                  <label>HISTORIA:</label>
                  <p><%= info.infoCabecera.historia || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>EPISODIO:</label>
                  <p><%= info.infoCabecera.ingreso_id || 'No disponible' %></p>
                </div>
                <!-- Antecedentes (No editable) -->
                <div class="mb-3">
                  <label>ANTECEDENTES (AT):</label>
                  <p><%= info.infoCabecera.antecedentes || 'No disponible' %></p>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
              <button type="button" class="btn btn-primary" onclick="aplicarCambiosPanel('<%= info.infoCabecera.ingreso_id || 'unknown' %>')">Aplicar Cambios</button>
            </div>
          </div>
        </div>
    </div>


