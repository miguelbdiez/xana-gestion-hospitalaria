        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario">Enfermería | Balance Paciente</h1>
            <div class=" d-flex align-items-center">
              <a id="btnVolverLista" class="call-btn btn-img me-2" href="/planta">
                <img
                  src="/imagenes/volver.png"
                  alt="Volver"
                  style="width: 24px; height: 24px"
                />
              </a>
            </div>
           
          </div>
          <% if (info && info.infoCabecera) { %>
            <div class="patient-info-container container" 
                 data-documento-identificacion="<%= info.infoCabecera.documento_identificacion_paciente || 'unknown' %>" 
                 data-id-medico="<%= info.infoCabecera.medico_id || 'unknown' %>"
                 data-cama-id="<%= info.infoCabecera.cama_id || 'unknown' %>"
                 data-ingreso-id="<%= info.infoCabecera.ingreso_id || 'unknown' %>">
              <div class="header">
                <!-- Botón para abrir el modal -->
                <button class="edit-button incidence-button" data-bs-toggle="modal" data-bs-target="#incidenciaModal">Incidencia</button>
                <button class="edit-button" data-bs-toggle="modal" data-bs-target="#editModal">Editar</button>
                <!-- Panel del paciente a la izquierda -->
                <div class="panel-paciente">
                  <% if (info.infoCabecera.panelPaciente) { %>
                    <img src="<%= info.infoCabecera.panelPaciente %>" 
                         alt="Panel Paciente" />
                  <% } else { %>
                    <p>Sin imagen de panel</p>
                  <% } %>
                </div>
                
                <!-- Campos de la cabecera en columnas -->
                <div class="info-paciente">
                  <div class="info-column">
                    <p>
                      <strong>PACIENTE:</strong> 
                      <span id="paciente-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %>">
                        <%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.paciente_nombre_completo && info.infoCabecera.paciente_nombre_completo.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('paciente-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.paciente_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>MÉDICO:</strong> 
                      <span id="medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>">
                        <%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.medico_nombre_completo && info.infoCabecera.medico_nombre_completo.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.medico_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>SERVICIO:</strong> 
                      <span id="servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.especialidad || 'No disponible' %>">
                        <%= info.infoCabecera.especialidad || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.especialidad && info.infoCabecera.especialidad.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.especialidad.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>FECHA DE INGRESO:</strong> <span class="text-limited" title="<%= info.infoCabecera.fecha_ini || 'No disponible' %>"><%= info.infoCabecera.fecha_ini || 'No disponible' %></span></p>
                    <p>
                      <strong>DIAGNÓSTICO:</strong> 
                      <span id="diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.diagnostico || 'No especificado' %>">
                        <%= info.infoCabecera.diagnostico || 'No especificado' %>
                      </span>
                      <% if (info.infoCabecera.diagnostico && info.infoCabecera.diagnostico.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.diagnostico.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>ALERGIAS:</strong> 
                      <span id="alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>
                      </span>
                      <% 
                        const alergiasText = `(${info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna'}) ${info.infoCabecera.alergia || 'Ninguna'}`;
                        if (alergiasText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= alergiasText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                  <div class="info-column">
                    <p>
                      <strong>DIETA:</strong> 
                      <span id="dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>
                      </span>
                      <% 
                        const dietaText = `(${info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna'}) ${info.infoCabecera.dieta || 'Ninguna'}`;
                        if (dietaText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= dietaText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>AISLAMIENTO:</strong> <span class="text-limited" id="aislamiento-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %>"><%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %></span></p>
                    <p><strong>GRUPO SANGUÍNEO:</strong> <span class="text-limited" id="grupoSanguineo-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.grupo_rh || 'No especificado' %>"><%= info.infoCabecera.grupo_rh || 'No especificado' %></span></p>
                    <p>
                      <strong>HISTORIA:</strong> 
                      <span id="historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.historia || 'No disponible' %>">
                        <%= info.infoCabecera.historia || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.historia && info.infoCabecera.historia.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.historia.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>EPISODIO:</strong> <span class="text-limited" title="<%= info.infoCabecera.ingreso_id || 'No disponible' %>"><%= info.infoCabecera.ingreso_id || 'No disponible' %></span></p>
                    <p>
                      <strong>AT:</strong> 
                      <span id="antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.antecedentes || 'No disponible' %>">
                        <%= info.infoCabecera.antecedentes || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.antecedentes && info.infoCabecera.antecedentes.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.antecedentes.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="patient-info-container container">
              <p class="error-message">No se encontró información para el ingreso especificado.</p>
            </div>
          <% } %>
               
              
              <div class="balance-section">
                  <!-- Título y botones -->
                  <div class="d-flex justify-content-between align-items-center mb-3">
                      <h2 class="balance-title">Balance Hídrico</h2>
                      <div class="d-flex align-items-center">
                          <div class="balance-checkbox-container me-3">
                              <input
                                  class="balance-checkbox"
                                  type="checkbox"
                                  id="activarBalancePaciente"
                                  value="activar"
                                  <%= info.balanceActivo === 1 ? 'checked' : info.balanceActivo === 0 ? '' : '' %>
                              >
                              <label class="balance-checkbox-label" for="activarBalancePaciente">
                                  Activar balance paciente
                              </label>
                          </div>
                          <button
                              type="button"
                              class="balance-btn-primary btn-sm"
                              data-bs-toggle="modal"
                              data-bs-target="#addBalanceModal"
                          >
                              <i class="fas fa-plus"></i> Agregar Nuevo Balance
                          </button>
                      </div>
                  </div>
              
                  <!-- Tabla de balances -->
                  <div class="card shadow">
                      <div class="card-body p-0">
                          <div class="table-container">
                              <table id="tablaBalances">
                                  <thead class="bg-light text-dark">
                                      <tr>
                                          <th>FECHA</th>
                                          <th>ENTRADAS (ML)</th>
                                          <th>SALIDAS (ML)</th>
                                          <th>BALANCE (ML)</th>
                                      </tr>
                                  </thead>
                                  <tbody id="tablaBalancesBody">
                                      <% if (info && info.balancePaciente) { %>
                                          <% info.balancePaciente.forEach((balance, index) => { %>
                                          <tr
                                              class="balance-row"
                                              data-id="<%= balance.id %>"
                                              data-ingreso_id="<%= info.ingreso_id %>"
                                              data-id_trabajador="<%= balance.id_trabajador %>"
                                              data-nombre_trabajador="<%= balance.nombre_trabajador %>"
                                              data-documento_identificacion="<%= balance.documento_identificacion %>"
                                          >
                                              <td id="fechaEmision_<%= index %>"><%= balance.fecha_emision %></td>
                                              <td id="entradas_<%= index %>"><%= parseFloat(balance.entradas).toFixed(2) %></td>
                                              <td id="salidas_<%= index %>"><%= parseFloat(balance.salidas).toFixed(2) %></td>
                                              <td id="balance_<%= index %>"><%= parseFloat(balance.balance_total).toFixed(2) %></td>
                                          </tr>
                                          <% }) %>
                                      <% } %>
                                  </tbody>
                              </table>
                          </div>
                      </div>
                  </div>
              </div>
              <div class="chart-container mt-4">
                <canvas id="balanceChart" style="max-height: 400px;"></canvas>
              </div>
              
              
            

              
          
        </main>
      </div>
    </div>
    <div class="modal fade incidencia-modal" id="incidenciaModal" tabindex="-1" aria-labelledby="incidenciaModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="incidenciaModalLabel">Gestión de Incidencias</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Lista de incidencias -->
            <div class="mb-3">
              <h6>Incidencias Asociadas</h6>
              <ul id="incidenciasLista" class="list-group">
                <% if (info.infoIncidencias && info.infoIncidencias.length > 0) { %>
                  <% info.infoIncidencias.forEach(incidencia => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <div data-id_incidencia=" <%= incidencia.id_incidencia %>">
                        <strong>Descripcion: </strong> - <%= incidencia.informacion_incidencia %>
                        <br>
                        <small>
                          Episodio: <%= incidencia.ingreso_id %> | 
                          Estado: <%= incidencia.activa ? 'Activa' : 'Inira' %> | 
                          Fecha de emisión: <%= incidencia.fecha_emision %> 
                          <% if (!incidencia.activa && incidencia.fecha_desactivacion) { %>
                            | Fecha de desactivación: <%= incidencia.fecha_desactivacion %>
                          <% } %>
                        </small>
                      </div>
                      <% if (incidencia.activa) { %>
                        <button class="btn btn-danger btn-sm desactivar-incidencia" data-id-incidencia="<%= incidencia.id_incidencia %>" data-id-ingreso="<%= incidencia.ingreso_id %>">Desactivar</button>
                      <% } %>
                    </li>
                  <% }); %>
                <% } else { %>
                  <li class="list-group-item">No hay incidencias asociadas.</li>
                <% } %>
              </ul>
            </div>
            <!-- Botón para añadir nueva incidencia -->
            <button type="button" class="btn btn-primary mb-3" id="btnNuevaIncidencia">Nueva Incidencia</button>
            <!-- Formulario para nueva incidencia (oculto inicialmente) -->
            <div id="nuevaIncidenciaForm" style="display: none;">
              <div class="mb-3">
                <label for="incidenciaCuerpo" class="form-label">Descripción de la Incidencia:</label>
                <textarea class="form-control" id="incidenciaCuerpo" rows="4" placeholder="Escriba los detalles de la incidencia"></textarea>
              </div>
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" id="btnCancelarIncidencia">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnAceptarIncidencia">Aceptar</button>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
          </div>
        </div>
      </div>
    </div>
    
    <div class="modal fade edit-info-modal" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="editModalLabel">Editar Información del Paciente</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="form-column">
                <!-- Campos no editables -->
                <div class="mb-3">
                  <label>PACIENTE:</label>
                  <p><%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>MÉDICO:</label>
                  <p><%= info.infoCabecera.medico_nombre_completo || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>SERVICIO:</label>
                  <p><%= info.infoCabecera.especialidad || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>FECHA DE INGRESO:</label>
                  <p><%= info.infoCabecera.fecha_ini || 'No disponible' %></p>
                </div>
                <!-- Diagnóstico (solo editable por médico) -->
                <div class="mb-3">
                  <label for="modalDiagnostico">DIAGNÓSTICO:</label>
                  <input type="text" class="form-control" id="modalDiagnostico" value="<%= info.infoCabecera.diagnostico || 'No especificado' %>" 
                         <%= info.rol === 'medico' ? '' : 'disabled' %>>
                </div>
                <!-- Alergias -->
                <div class="mb-3">
                  <label>ALERGIAS:</label>
                  <div class="d-flex flex-wrap">
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaNinguna" value="ninguna" 
                             <%= (!info.infoCabecera.tipo_alergia || info.infoCabecera.tipo_alergia === 'ninguna') ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaNinguna">Ninguna</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaLeve" value="leve" 
                             <%= info.infoCabecera.tipo_alergia === 'leve' ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaLeve">Leve</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaModerada" value="moderada" 
                             <%= info.infoCabecera.tipo_alergia === 'moderada' ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaModerada">Moderada</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="tipoAlergia" id="alergiaGrave" value="grave" 
                             <%= info.infoCabecera.tipo_alergia === 'grave' ? 'checked' : '' %>>
                      <label class="form-check-label" for="alergiaGrave">Grave</label>
                    </div>
                  </div>
                  <input type="text" class="form-control mt-2" id="modalAlergia" placeholder="Especifique alergia" 
                         value="<%= info.infoCabecera.alergia || '' %>" 
                         <%= (!info.infoCabecera.tipo_alergia || info.infoCabecera.tipo_alergia === 'ninguna') ? 'disabled' : '' %>>
                </div>
              </div>
              <div class="form-column">
                <!-- Dieta -->
                <div class="mb-3">
                  <label>DIETA:</label>
                  <div class="d-flex flex-wrap">
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaNinguna" value="ninguna" 
                             <%= (!info.infoCabecera.tipo_dieta || info.infoCabecera.tipo_dieta === 'ninguna') ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaNinguna">Ninguna</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaNormal" value="normal" 
                             <%= info.infoCabecera.tipo_dieta === 'normal' ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaNormal">Normal</label>
                    </div>
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaBlanda" value="blanda" 
                             <%= info.infoCabecera.tipo_dieta === 'blanda' ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaBlanda">Blanda</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="tipoDieta" id="dietaLiquida" value="liquidos" 
                             <%= info.infoCabecera.tipo_dieta === 'liquidos' ? 'checked' : '' %>>
                      <label class="form-check-label" for="dietaLiquida">Líquida</label>
                    </div>
                  </div>
                  <input type="text" class="form-control mt-2" id="modalDieta" placeholder="Especifique dieta" 
                         value="<%= info.infoCabecera.dieta || '' %>" 
                         <%= (!info.infoCabecera.tipo_dieta || info.infoCabecera.tipo_dieta === 'ninguna') ? 'disabled' : '' %>>
                </div>
                <!-- Aislamiento -->
                <div class="mb-3">
                  <label>AISLAMIENTO:</label>
                  <div class="d-flex">
                    <div class="form-check me-2">
                      <input class="form-check-input" type="radio" name="aislamiento" id="aislamientoNo" value="no" 
                             <%= info.infoCabecera.aislamiento ? '' : 'checked' %>>
                      <label class="form-check-label" for="aislamientoNo">No</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="aislamiento" id="aislamientoSi" value="si" 
                             <%= info.infoCabecera.aislamiento ? 'checked' : '' %>>
                      <label class="form-check-label" for="aislamientoSi">Sí</label>
                    </div>
                  </div>
                </div>
                <!-- Grupo Sanguíneo (Select) -->
                <div class="mb-3">
                  <label for="modalGrupoSanguineo">GRUPO SANGUÍNEO:</label>
                  <select class="form-control" id="modalGrupoSanguineo">
                    <option value="No especificado" <%= info.infoCabecera.grupo_rh === 'No especificado' || !info.infoCabecera.grupo_rh ? 'selected' : '' %>>No especificado</option>
                    <option value="A+" <%= info.infoCabecera.grupo_rh === 'A+' ? 'selected' : '' %>>A+</option>
                    <option value="A-" <%= info.infoCabecera.grupo_rh === 'A-' ? 'selected' : '' %>>A-</option>
                    <option value="B+" <%= info.infoCabecera.grupo_rh === 'B+' ? 'selected' : '' %>>B+</option>
                    <option value="B-" <%= info.infoCabecera.grupo_rh === 'B-' ? 'selected' : '' %>>B-</option>
                    <option value="AB+" <%= info.infoCabecera.grupo_rh === 'AB+' ? 'selected' : '' %>>AB+</option>
                    <option value="AB-" <%= info.infoCabecera.grupo_rh === 'AB-' ? 'selected' : '' %>>AB-</option>
                    <option value="O+" <%= info.infoCabecera.grupo_rh === 'O+' ? 'selected' : '' %>>O+</option>
                    <option value="O-" <%= info.infoCabecera.grupo_rh === 'O-' ? 'selected' : '' %>>O-</option>
                  </select>
                </div>
                <!-- Campos no editables -->
                <div class="mb-3">
                  <label>HISTORIA:</label>
                  <p><%= info.infoCabecera.historia || 'No disponible' %></p>
                </div>
                <div class="mb-3">
                  <label>EPISODIO:</label>
                  <p><%= info.infoCabecera.ingreso_id || 'No disponible' %></p>
