    <script src="/public/scripts/comunicacion.js"></script>

 

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const now = new Date();
        const fechaEmision = now.toISOString().slice(0, 16).replace('T', ' ');
        document.getElementById('fechaEmision').textContent = fechaEmision;
        document.getElementById('fecha_emision').value = fechaEmision;





          // Preparar los datos desde info.balancePaciente
          const balances = <%- JSON.stringify(info.balancePaciente) %>;
          const cama_id = '<%= info.infoCabecera.cama_id || 'unknown' %>';
          const ingresoId = '<%= info.infoCabecera.ingreso_id || 'unknown' %>';
          let balance;

          // Extraer fechas y balances totales
          const fechas = balances.map(balance => new Date(balance.fecha_emision).toLocaleString('es-ES', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).replace(',', ''));
          const balancesTotales = balances.map(balance => parseFloat(balance.balance_total));
  
          // Obtener el contexto del canvas
          const ctx = document.getElementById('balanceChart').getContext('2d');
  
          // Crear el gráfico de barras vertical
          new Chart(ctx, {
              type: 'bar', // Cambia a 'bar' con indexAxis: 'y' para barras horizontales
              data: {
                  labels: fechas,
                  datasets: [{
                      label: 'Balance Total (mL)',
                      data: balancesTotales,
                      backgroundColor: 'rgba(16, 185, 129, 0.6)', // Verde claro con opacidad
                      borderColor: 'rgba(16, 185, 129, 1)', // Verde sólido
                      borderWidth: 1
                  }]
              },
              options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  scales: {
                      x: {
                          title: {
                              display: true,
                              text: 'Fecha de Emisión',
                              font: {
                                  size: 14,
                                  family: 'Arial'
                              },
                              color: '#1f2937'
                          },
                          ticks: {
                              maxRotation: 45,
                              minRotation: 45,
                              font: {
                                  size: 12
                              }
                          }
                      },
                      y: {
                          title: {
                              display: true,
                              text: 'Balance Total (mL)',
                              font: {
                                  size: 14,
                                  family: 'Arial'
                              },
                              color: '#1f2937'
                          },
                          beginAtZero: true,
                          ticks: {
                              font: {
                                  size: 12
                              }
                          }
                      }
                  },
