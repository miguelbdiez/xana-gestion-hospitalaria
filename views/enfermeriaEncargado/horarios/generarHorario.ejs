        <!-- Sidebar Chat -->
        <div
        class="offcanvas offcanvas-end"
        id="sidebarChat"
        tabindex="-1"
        aria-labelledby="sidebarLeftLabel"
        >
        <div id="plist" class="people-list">
          <div class="offcanvas-header border-bottom bg-primary text-white">
            <h5 class="offcanvas-title" id="sidebarLeftLabel">Chats</h5>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="offcanvas"
              aria-label="Cerrar"
            ></button>
          </div>
          <div class="input-group p-3">
            <input
              type="text"
              class="form-control"
              id="searchInput"
              placeholder="Buscar..."
            />
          </div>
          <ul class="list-unstyled chat-list mb-0">
            <% info.listaPersonasChat.forEach(persona => { %>
            <li
              class="clearfix usuario-chat d-flex align-items-center p-3"
              data-user-id="<%= persona.id %>"
            >
              <img src="/imagenes/user.png" alt="Avatar" class="avatar" />
              <div class="about flex-grow-1">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="name"><%= persona.nombre %></div>
                  <% if (persona.mensajes_no_leidos > 0) { %>
                  <div class="mensaje-no-leido" style="display: block"></div>
                  <% } %>
                </div>
                <div class="last-message">
                  <%= persona.ultimo_mensaje || '' %>
                </div>
                <div class="message-data-time">
                  <%= persona.fecha_ultimo_mensaje || '' %>
                </div>
              </div>
            </li>
            <% }) %>
          </ul>
        </div>
    
        <div class="chat" style="display: none">
          <div class="chat-header bg-primary text-white">
            <div
              class="row align-items-center d-flex justify-content-between p-3"
            >
              <div class="col-lg-6 d-flex align-items-center">
                <img src="/imagenes/user.png" alt="Avatar" class="avatar me-2" />
                <div class="chat-about" data-user-id="">
                  <h6 class="m-0"></h6>
                </div>
              </div>
              <div class="col-lg-6 text-end d-flex justify-content-end gap-2">
                <button class="call-btn btn-img">
                  <img src="/imagenes/llamada.png" alt="Llamar" />
                </button>
                <button id="btnVolverLista" class="call-btn btn-img">
                  <img src="/imagenes/volver.png" alt="Volver" />
                </button>
              </div>
            </div>
          </div>
    
          <div class="chat-history" id="chat-box">
            <ul class="m-b-0"></ul>
          </div>
          <div class="chat-message">
            <div class="input-group">
              <input
                id="mensajeInput"
                type="text"
                class="form-control"
                placeholder="Escribe un mensaje..."
              />
              <button class="btn btn-primary" id="enviarBtn">Enviar</button>
            </div>
          </div>
        </div>
        </div>
    
        <!-- Sidebar Notificaciones -->
    
        <div
        class="offcanvas offcanvas-end bg-light"
        id="sidebarNotificaciones"
        tabindex="-1"
        aria-labelledby="sidebarRightLabel"
        >
        <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="sidebarRightLabel">Notificaciones</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          aria-label="Cerrar"
        ></button>
        </div>
        <div class="offcanvas-body p-0">
        <ul class="list-unstyled m-0" id="notificaciones">
          <% info.notificaciones.forEach(notificacion => { %>
          <li
            class="p-3 border-bottom <%= notificacion.tipo_notificacion %>"
            data-notificacion-id="<%= notificacion.id %>"
          >
            <small class="text-muted"
              ><%= notificacion.fecha_formateada %></small
            >
            <div class="fw-bold">
              <% if (notificacion.tipo_notificacion === 'tipo_mensaje') { %>
              Mensaje Nuevo <% } else if (notificacion.tipo_notificacion ===
              'tipo_horario') { %> Cambio de Horario <% } else if
              (notificacion.tipo_notificacion === 'tipo_llamada') { %> Llamada
              Perdida <% } else if (notificacion.tipo_notificacion ===
              'tipo_mail') { %> Nuevo Email <% } else if
              (notificacion.tipo_notificacion === 'tipo_bandeja_documentos') {
              %> Bandeja Documentos <% } else if (notificacion.tipo_notificacion
              === 'tipo_caducidad_3_dias_lote') { %> Lote Próximo a Caducar (3
              días) <% } else if (notificacion.tipo_notificacion ===
              'tipo_caducidad_1_dias_lote') { %> Lote a Punto de Caducar (1 día)
              <% } else { %> Notificación <% } %>
            </div>
            <div><%= notificacion.contenido_notificacion %></div>
            <button
              type="button"
              class="btn btn-sm btn-danger mt-1 borrar-notificacion"
              data-notificacion-id="<%= notificacion.id %>"
            >
              Borrar
            </button>
          </li>
          <% }) %>
        </ul>
        <div class="p-3">
          <a
            href="/enfermeria/notificaciones"
            class="btn btn-outline-primary w-100"
          >
            Ver todas las notificaciones
          </a>
        </div>
        </div>
