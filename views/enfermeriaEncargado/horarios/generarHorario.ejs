    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>


    <script>
  // Obtener la lista de trabajadores desde el DOM
  const trabajadoresElements = document.querySelectorAll('.lista-trabajadores span');
  const nombresPlantilla = Array.from(trabajadoresElements).map(span => ({
    id: span.getAttribute('data-id'),
    nombre_completo: span.textContent.trim()
  }));

  // Función para generar el calendario
  function generarCalendario(mes, año) {
    fetch('/enfermeriaEncargado/horarios/horarioExiste', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mes, año })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success === true) {
        const confirmacion = confirm(`Ya existe un horario para ${mes} ${año}. Si creas uno nuevo, el anterior se perderá. ¿Deseas continuar?`);
        if (!confirmacion) {
          // Restaurar el mes y año anteriores si el usuario cancela
          document.getElementById('selectorMes').value = mesInicial;
          document.getElementById('selectorAño').value = añoInicial;
          return;
        }
      }
      // Si no existe horario o el usuario confirma, generar el calendario
      const calendarioGrid = document.getElementById('calendarioGrid');
      while (calendarioGrid.children.length > 7) {
        calendarioGrid.removeChild(calendarioGrid.lastChild);
      }

      const diasEnMes = {
        'Enero': 31, 'Febrero': 28, 'Marzo': 31, 'Abril': 30, 'Mayo': 31, 'Junio': 30,
        'Julio': 31, 'Agosto': 31, 'Septiembre': 30, 'Octubre': 31, 'Noviembre': 30, 'Diciembre': 31
      };

      const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
      const mesIndex = meses.indexOf(mes);
      const primerDia = new Date(año, mesIndex, 1);
      const offset = primerDia.getDay() === 0 ? 6 : primerDia.getDay() - 1;

      if (mes === 'Febrero') {
        diasEnMes['Febrero'] = (año % 4 === 0 && (año % 100 !== 0 || año % 400 === 0)) ? 29 : 28;
      }

      for (let i = 0; i < offset; i++) {
        const diaVacio = document.createElement('div');
        diaVacio.className = 'dia-vacio';
        calendarioGrid.appendChild(diaVacio);
      }

      const dias = diasEnMes[mes];
      for (let dia = 1; dia <= dias; dia++) {
        const diaDiv = document.createElement('div');
        diaDiv.className = 'dia';

        const numeroDia = document.createElement('div');
        numeroDia.className = 'numero-dia';
        numeroDia.textContent = dia;
        diaDiv.appendChild(numeroDia);

        const turnoMañana = document.createElement('div');
        turnoMañana.className = 'turno mañana';
        turnoMañana.setAttribute('data-bs-toggle', 'modal');
        turnoMañana.setAttribute('data-bs-target', '#turnoModal');
        turnoMañana.setAttribute('data-info', JSON.stringify([{ turno: 'Mañana', dia: dia, mes: mes, año: año, nombre_trabajador: '-', id: null }]));
        turnoMañana.innerHTML = '<div>-</div>';
        diaDiv.appendChild(turnoMañana);

        const turnoTarde = document.createElement('div');
        turnoTarde.className = 'turno tarde';
        turnoTarde.setAttribute('data-bs-toggle', 'modal');
        turnoTarde.setAttribute('data-bs-target', '#turnoModal');
        turnoTarde.setAttribute('data-info', JSON.stringify([{ turno: 'Tarde', dia: dia, mes: mes, año: año, nombre_trabajador: '-', id: null }]));
        turnoTarde.innerHTML = '<div>-</div>';
        diaDiv.appendChild(turnoTarde);

        const turnoNoche = document.createElement('div');
        turnoNoche.className = 'turno noche';
        turnoNoche.setAttribute('data-bs-toggle', 'modal');
        turnoNoche.setAttribute('data-bs-target', '#turnoModal');
        turnoNoche.setAttribute('data-info', JSON.stringify([{ turno: 'Noche', dia: dia, mes: mes, año: año, nombre_trabajador: '-', id: null }]));
        turnoNoche.innerHTML = '<div>-</div>';
        diaDiv.appendChild(turnoNoche);

        calendarioGrid.appendChild(diaDiv);
      }

      actualizarEventosTurnos();
      actualizarTablaResumen(mes, año);
    })
    .catch(error => {
      console.error('Error al consultar el servidor:', error);
      alert('Hubo un error al verificar el horario. Intenta de nuevo.');
    });
  }
  // Función para actualizar los eventos de los turnos
  function actualizarEventosTurnos() {
    document.querySelectorAll('.turno').forEach(turno => {
      turno.addEventListener('click', function() {
        const info = JSON.parse(this.getAttribute('data-info'));
        const turnoElement = this;

        document.getElementById('modalDia').textContent = `${info[0].dia} de ${info[0].mes} ${info[0].año}`;
        document.getElementById('modalTurno').textContent = info[0].turno;
        document.getElementById('modalHora').textContent = info[0].turno === 'Mañana' ? '08:00 - 14:00' : 
                                                          info[0].turno === 'Tarde' ? '14:00 - 20:00' : '20:00 - 08:00';

        const trabajadoresList = document.getElementById('modalTrabajadoresList');
        trabajadoresList.innerHTML = '';
        if (info.length === 1 && info[0].nombre_trabajador === '-' && info[0].id === null) {
          const li = document.createElement('li');
          li.textContent = 'No asignado';
          trabajadoresList.appendChild(li);
        } else {
          info.forEach(trabajador => {
            const li = document.createElement('li');
            li.textContent = trabajador.nombre_trabajador;
            const btnEliminar = document.createElement('button');
            btnEliminar.className = 'btn-eliminar';
            btnEliminar.textContent = 'Eliminar';
            btnEliminar.onclick = function() {
              li.remove();
            };
            li.appendChild(btnEliminar);
            trabajadoresList.appendChild(li);
          });
        }

        document.getElementById('btnNuevoTrabajador').onclick = function() {
          const li = document.createElement('li');
          const select = document.createElement('select');
          select.innerHTML = '<option value="">Selecciona un empleado</option>';
          nombresPlantilla.forEach(empleado => {
            const option = document.createElement('option');
            option.value = empleado.id;
            option.textContent = empleado.nombre_completo;
            select.appendChild(option);
          });

          const btnEliminar = document.createElement('button');
          btnEliminar.className = 'btn-eliminar';
          btnEliminar.textContent = 'Eliminar';
          btnEliminar.onclick = function() {
            li.remove();
          };

          li.appendChild(select);
          li.appendChild(btnEliminar);
          trabajadoresList.appendChild(li);
        };

        document.getElementById('btnAplicar').onclick = function() {
          const nuevosTrabajadores = [];
          trabajadoresList.querySelectorAll('li').forEach(li => {
            const select = li.querySelector('select');
            const textContent = li.textContent.replace('Eliminar', '').trim();
            if (select && select.value) {
              const empleado = nombresPlantilla.find(e => e.id == select.value);
              nuevosTrabajadores.push({
                turno: info[0].turno,
                dia: info[0].dia,
                mes: info[0].mes,
                año: info[0].año,
                nombre_trabajador: empleado.nombre_completo,
                id: empleado.id
              });
            } else if (textContent && textContent !== 'No asignado') {
              const empleadoExistente = info.find(t => t.nombre_trabajador === textContent);
              if (empleadoExistente) {
                nuevosTrabajadores.push(empleadoExistente);
              }
            }
          });

          if (nuevosTrabajadores.length === 0) {
            nuevosTrabajadores.push({
              turno: info[0].turno,
              dia: info[0].dia,
              mes: info[0].mes,
              año: info[0].año,
              nombre_trabajador: '-',
              id: null
            });
          }

          turnoElement.setAttribute('data-info', JSON.stringify(nuevosTrabajadores));
          turnoElement.innerHTML = '';
          nuevosTrabajadores.forEach(trabajador => {
            const div = document.createElement('div');
            div.textContent = trabajador.nombre_trabajador;
            turnoElement.appendChild(div);
          });

          const modal = bootstrap.Modal.getInstance(document.getElementById('turnoModal'));
          modal.hide();

          // Actualizar la tabla después de aplicar cambios
          actualizarTablaResumen(info[0].mes, info[0].año);
        };
      });
    });
  }

  // Función para actualizar la tabla de resumen
  function actualizarTablaResumen(mes, año) {
    const turnos = document.querySelectorAll('.turno');
    const diasEnMes = {
      'Enero': 31, 'Febrero': (año % 4 === 0 && (año % 100 !== 0 || año % 400 === 0)) ? 29 : 28, 'Marzo': 31, 'Abril': 30,
      'Mayo': 31, 'Junio': 30, 'Julio': 31, 'Agosto': 31, 'Septiembre': 30, 'Octubre': 31, 'Noviembre': 30, 'Diciembre': 31
    };
    const totalDias = diasEnMes[mes];
    const tablaBody = document.getElementById('tablaResumenBody');
    tablaBody.innerHTML = '';

    // Inicializar asignaciones con valores por defecto
    const asignaciones = {};
    nombresPlantilla.forEach(trabajador => {
      asignaciones[trabajador.id] = {
        nombre: trabajador.nombre_completo,
        mañana: 0,
        tarde: 0,
        diasTrabajados: new Set()
      };
    });

    // Actualizar asignaciones basadas en los turnos
    turnos.forEach(turno => {
      const info = JSON.parse(turno.getAttribute('data-info'));
      info.forEach(trabajador => {
        if (trabajador.id !== null) {
          if (trabajador.turno === 'Mañana') {
            asignaciones[trabajador.id].mañana++;
          } else if (trabajador.turno === 'Tarde') {
            asignaciones[trabajador.id].tarde++;
          }
          asignaciones[trabajador.id].diasTrabajados.add(trabajador.dia);
        }
      });
    });

    // Generar filas de la tabla
    Object.keys(asignaciones).forEach(id => {
      const datos = asignaciones[id];
      const diasDescanso = totalDias - datos.diasTrabajados.size;
      const row = document.createElement('tr');
      row.innerHTML = `
        <td>${datos.nombre}</td>
        <td>${datos.mañana}</td>
        <td>${datos.tarde}</td>
        <td>${diasDescanso}</td>
      `;
      tablaBody.appendChild(row);
    });
  }

  // Generar calendario inicial
  const mesInicial = document.getElementById('selectorMes').value;
  const añoInicial = parseInt(document.getElementById('selectorAño').value);
  generarCalendario(mesInicial, añoInicial);

  // Escuchar cambios en el selector de mes
  document.getElementById('selectorMes').addEventListener('change', function() {
    const mesSeleccionado = this.value;
    const añoSeleccionado = parseInt(document.getElementById('selectorAño').value);
    generarCalendario(mesSeleccionado, añoSeleccionado);
  });

  // Escuchar cambios en el selector de año
  document.getElementById('selectorAño').addEventListener('change', function() {
    const añoSeleccionado = parseInt(this.value);
    const mesSeleccionado = document.getElementById('selectorMes').value;
    generarCalendario(mesSeleccionado, añoSeleccionado);
  });

 

  // Script para el botón Confirmar Horario
  document.getElementById('btnConfirmarHorario').addEventListener('click', function() {
    const mes = document.getElementById('selectorMes').value;
    const año = parseInt(document.getElementById('selectorAño').value);
    const turnos = document.querySelectorAll('.turno');
    const horarioConfirmado = [];
    const diasSemana = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
    const especialidad = "<%= info.especialidad %>"

   /* let turnosVacios = [];
    turnos.forEach(turno => {
      const info = JSON.parse(turno.getAttribute('data-info'));
      if (info.length === 1 && info[0].nombre_trabajador === '-' && info[0].id === null) {
        turnosVacios.push(`${info[0].dia} de ${info[0].mes} - ${info[0].turno}`);
      }
    });

    if (turnosVacios.length > 0) {
      alert(`No se puede confirmar el horario. Los siguientes turnos están vacíos:\n${turnosVacios.join('\n')}\nPor favor, asigna al menos un empleado a cada turno.`);
      return;
    }*/

    turnos.forEach(turno => {
      const info = JSON.parse(turno.getAttribute('data-info'));
      info.forEach(trabajador => {
        const fecha = new Date(año, ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'].indexOf(mes), trabajador.dia);
        const diaSemana = diasSemana[fecha.getDay()];
        
        horarioConfirmado.push({
          año: trabajador.año,
          mes: trabajador.mes,
          dia: trabajador.dia,
          turno: trabajador.turno,
          nombre_trabajador: trabajador.nombre_trabajador,
          id_empleado: trabajador.id,
          dia_semana: diaSemana
        });
      });
    });

    console.log('Horario confirmado:', horarioConfirmado);
    // Verificar que cada turno tenga al menos un empleado
    
    fetch('/enfermeriaEncargado/horarios/confirmarHorario', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({horarioConfirmado, especialidad})
    })
    .then(response => response.json())
    .then(data => {
      if (data.success === true) {
        alert(`Horario creado`);
        window.location.href="/enfermeria/horarios"
       
        }
    })
    
  });
</script>
