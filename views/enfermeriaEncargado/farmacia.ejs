                      </thead>
                      <% if (info && info.pedidos) { %>
                      <tbody>
                        <% info.pedidos.forEach(pedido => { %>
                        <tr
                          class="pedido-row"
                          data-pedido="<%- JSON.stringify(pedido) %>"
                        >
                          <td><%= pedido.nombre %></td>
                          <td><%= pedido.tipo %></td>
                          <td><%= pedido.estado %></td>
                          <td><%= pedido.fecha_pedido %></td>
                          <td><%= pedido.notas %></td>
                        </tr>
                        <% }) %>
                      </tbody>
                      <% } %>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
