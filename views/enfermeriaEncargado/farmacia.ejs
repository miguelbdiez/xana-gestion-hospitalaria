    <div
      class="modal fade"
      id="nuevoPedidoModal"
      tabindex="-1"
      aria-labelledby="nuevoPedidoModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content pedido-section">
          <div class="modal-header">
            <h5 class="modal-title" id="nuevoPedidoModalLabel">Nuevo Pedido</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
