    <!-- Scripts necesarios -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <link
      rel="stylesheet"
      href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <script>
                  const farmacos = <%- JSON.stringify(info.farmacos || []) %>;
      const pedidos = <%- JSON.stringify(info.pedidos || []) %>;

      document.addEventListener('DOMContentLoaded', function () {
        const tablaFarmacosElement = document.getElementById('tablaFarmacos');
        const tablaPedidosElement = document.getElementById('tablaPedidos');
        if (!tablaFarmacosElement || !tablaPedidosElement) {
          console.error('Error: No se encontraron los elementos tablaFarmacos o tablaPedidos');
          return;
        }

        const tablaFarmacos = new DataTable(tablaFarmacosElement, {
          language: {
            url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json'
          },
          pageLength: 10,
          order: [[2, 'asc']],
          columnDefs: [
            {
              targets: 4,
              render: function (data) {
                return data ? data.split(' ')[0] : 'No especificada';
              }
            },
            {
              targets: 5,
              render: function (data) {
                return data || 'No especificada';
              }
            }
          ]
        });

        const filtroNombre = document.getElementById('filtroNombre');
        const filtroFechaCaducidad = document.getElementById('filtroFechaCaducidad');
        const filtroTipo = document.getElementById('filtroTipo');

        if (filtroNombre) {
          filtroNombre.addEventListener('keyup', function () {
            console.log('Filtering nombre (inventario):', this.value);
            tablaFarmacos.column(2).search(this.value).draw();
          });
        } else {
          console.warn('Elemento filtroNombre no encontrado');
        }

        if (filtroFechaCaducidad) {
          filtroFechaCaducidad.addEventListener('change', function () {
            const value = this.value;
            console.log('Filtering fecha_caducidad (inventario):', value);
            tablaFarmacos.column(4).search(value).draw();
          });
        } else {
          console.warn('Elemento filtroFechaCaducidad no encontrado');
        }

        if (filtroTipo) {
          filtroTipo.addEventListener('change', function () {
            console.log('Filtering tipo (inventario):', this.value);
            tablaFarmacos.column(3).search(this.value).draw();
          });
        } else {
          console.warn('Elemento filtroTipo no encontrado');
        }

        const tablaPedidos = new DataTable(tablaPedidosElement, {
          language: {
            url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json'
          },
          pageLength: 10,
          order: [[3, 'desc']],
          columnDefs: [
            {
              targets: 3,
              render: function (data) {
                return data ? data : 'No especificada';
              }
            },
            {
              targets: 4,
              render: function (data) {
                return data || 'Sin notas';
              }
            }
          ]
        });

        const filtroPedidoNombre = document.getElementById('filtroPedidoNombre');
        const filtroPedidoEstado = document.getElementById('filtroPedidoEstado');

        if (filtroPedidoNombre) {
          filtroPedidoNombre.addEventListener('keyup', function () {
            console.log('Filtering nombre (pedidos):', this.value);
            tablaPedidos.column(1).search(this.value).draw();
          });
        } else {
          console.warn('Elemento filtroPedidoNombre no encontrado');
        }

        if (filtroPedidoEstado) {
          filtroPedidoEstado.addEventListener('change', function () {
            console.log('Filtering estado (pedidos):', this.value);
            tablaPedidos.column(5).search(this.value).draw();
          });
        } else {
          console.warn('Elemento filtroPedidoEstado no encontrado');
        }



                // Handle form submission for new pedido
                document.getElementById('enviarPedido').addEventListener('click', async function () {
                  console.log("ENTRA")
                    const formData = {
                        nombre: document.getElementById('pedidoNombre').value,
                        tipo: document.getElementById('pedidoTipo').value,
                        notas: document.getElementById('pedidoNotas').value || null,
                        fecha_pedido: new Date().toISOString().slice(0, 19).replace('T', ' '),
                        especialidad:'<%=info.especialidad%>'
                    };
                    console.log('Datos del pedido:', formData);
                    try {
                          const response = await fetch('/enfermeria/nuevoPedidoFarmacia', {
                          method: 'POST',
                          headers: {
                              'Content-Type': 'application/json',
                          },
                          body: JSON.stringify({ formData }),
                      });
                      const result= response.json();
                      if(response.ok){
                          window.location.href="/enfermeria/farmacia"
                      }else{
                          alert(result.message)
                      }

                  } catch (error) {
                      console.error('Error al buscar:', error);
                      alert('Error al realizar envio');
                  }


                });
            });
    </script>


  </body>
</html>
