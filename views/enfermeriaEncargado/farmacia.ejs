        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario">Farmacia</h1>
            <div class=" d-flex align-items-center">
              <a id="btnVolverLista" class="call-btn btn-img me-2" href="/home">
                <img
                  src="/imagenes/volver.png"
                  alt="Volver"
                  style="width: 24px; height: 24px"
                />
              </a>
              <h2 class="m-0"></h2>
            </div>
          </div>
          <div class="album py-5 bg-body-tertiary">
            <div class="container mt-4">
              <h1
                class="text-center mb-4"
                style="color: #1e90ff; font-weight: bold"
              >
                Consultar Inventario de Farmacia
              </h1>

              <!-- Filtros -->
              <div class="row mb-4 g-3">
                <div class="col-md-4">
                  <div class="input-group">
                    <span class="input-group-text bg-primary text-white">
                      <i class="fas fa-pills"></i>
                    </span>
                    <input
                      type="text"
                      id="filtroNombre"
                      class="form-control"
                      placeholder="Filtrar por nombre"
                    />
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="input-group">
                    <span class="input-group-text bg-primary text-white">
                      <i class="fas fa-calendar-alt"></i>
                    </span>
                    <input
                      type="date"
                      id="filtroFechaCaducidad"
                      class="form-control"
                      placeholder="Filtrar por fecha de caducidad"
                    />
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="input-group">
                    <span class="input-group-text bg-primary text-white">
                      <i class="fas fa-filter"></i>
                    </span>
                    <select id="filtroTipo" class="form-select">
                      <option value="">Todos los tipos</option>
                      <option value="Medicamento">Medicamento</option>
                      <option value="Material Sanitario">
                        Material Sanitario
                      </option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Tabla -->
              <div class="card shadow">
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table
                      id="tablaFarmacos"
                      class="table table-striped table-bordered table-hover mb-0"
                      style="width: 100%"
                    >
                      <thead class="bg-primary text-white">
                        <tr>
                          <th>Lote</th>
                          <th>Nombre</th>
                          <th>Tipo</th>
                          <th>Cantidad</th>
                          <th>Fecha de Caducidad</th>
                          <th>Ubicación</th>
                        </tr>
                      </thead>
                      <% if (info && info.farmacos) { %>
                      <tbody>
                        <% info.farmacos.forEach(farmaco => { %>
                        <tr
                          class="farmaco-row"
                          data-farmaco="<%- JSON.stringify(farmaco) %>"
                        >
                          <td><%= farmaco.lote %></td>
                          <td><%= farmaco.nombre %></td>
                          <td><%= farmaco.tipo %></td>
                          <td><%= farmaco.cantidad %></td>
                          <td><%= farmaco.fecha_caducidad %></td>
                          <td><%= farmaco.ubicacion || 'No especificada' %></td>
                        </tr>
                        <% }) %>
                      </tbody>
                      <% } %>
                    </table>
                  </div>
                </div>
              </div>
