            receptorIdTurno,
            receptorIdEmpleado,
            receptorDia,
            receptorTurno,
            receptorNombre,
            miTurnoId,
            miIdEmpleado,
            miTurnoTexto,
            miNombreUsuario,
            comentarios
        };

        try {
            const response = await fetch('/enfermeria/horariosHome/solicitarCambioDeTurno', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(solicitudCambio)
