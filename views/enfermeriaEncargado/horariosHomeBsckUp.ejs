    color: #666;
    font-style: italic;
    text-align: center;
    padding: 20px;
  }

  /* Colores según el tipo de solicitud */
  .solicitudCambio {
    background: #eef2ff;
    border-left: 5px solid #1e3a8a;
  }
  .confirmacionCambio {
    background: #e6f9e6;
