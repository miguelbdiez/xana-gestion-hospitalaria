                successDiv.textContent = data.message;
                document.querySelector('.solicitud-info').appendChild(successDiv);
                setTimeout(() => {
                    successDiv.remove();
                }, 3000);
            }
        } catch (error) {
            console.error('Error en la solicitud de cambio:', error);
