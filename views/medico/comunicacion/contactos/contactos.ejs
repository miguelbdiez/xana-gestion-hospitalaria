            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacionMasContactos.js"></script>
 
    <script>




    const contactos = [
      <% if (info.listaContactos && Array.isArray(info.listaContactos)) { %>
        <% info.listaContactos.forEach(contacto => { %>
          {
            idUsuario: "<%= contacto.idUsuario %>",
            usuario_nombre_completo: "<%= contacto.usuario_nombre_completo %>",
            rol: "<%= contacto.rol %>",
            departamento: "<%= contacto.departamento %>",
            foto_perfil: "<%= contacto.foto_perfil || '/imagenes/user.png' %>"
          },
        <% }); %>
      <% } %>
    ];

    console.log(contactos);

    // Filter function
    function filtrarContactos() {
      const nombreInput = document.getElementById('nombreUsuarioInput').value.toLowerCase();
      console.log(nombreInput);
      const especialidad = document.getElementById('especialidadUsuario').value;
      console.log(especialidad);

      const candidateBoxes = document.querySelectorAll('.candidate-list-box');
      console.log(candidateBoxes);

      candidateBoxes.forEach((box, index) => {
        const contacto = contactos[index];
        const nombreMatches = contacto.usuario_nombre_completo.toLowerCase().includes(nombreInput);
        const especialidadMatches = especialidad === "Cualquiera" || contacto.departamento === especialidad;

        if (nombreInput === "") {
          // If name is empty, filter only by specialty
          box.style.display = especialidadMatches ? 'block' : 'none';
        } else {
          // If name is not empty, filter by both name and specialty
          box.style.display = (nombreMatches && especialidadMatches) ? 'block' : 'none';
        }
      });
    }

    // Event listeners
    document.getElementById('especialidadUsuario').addEventListener('change', filtrarContactos);
    document.getElementById('nombreUsuarioInput').addEventListener('input', filtrarContactos);


    </script>




   
  </body>
</html>
