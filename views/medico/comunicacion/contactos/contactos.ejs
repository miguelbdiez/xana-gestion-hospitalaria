          <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
              <h1 id="nombreDelUsuario"><%= info.nombre %></h1>
              <div class="d-flex align-items-center">
                <a id="btnVolverLista" class="call-btn btn-img me-2" href="/comunicacionHome">
                  <img src="/imagenes/volver.png" alt="Volver" class="action-img" />
                </a>
                <h2 class="m-0">Contactos</h2>
              </div>
            </div>
            <div class="container">
              <div class="row justify-content-center" style="margin-top: 10px;">
                <div class="col-lg-12">
                  <div class="candidate-list-widgets mb-4">
                    <div class="g-2 row">
                      <div class="col-lg-3">
                        <div class="filler-job-form">
                          <input id="nombreUsuarioInput" placeholder="Nombre de usuario..." type="search" class="form-control filler-job-input-box form-control" />
                        </div>
                      </div>
                      <div class="col-lg-3">
                        <div class="filler-job-form">
                          <select class="form-select" data-trigger="true" id="especialidadUsuario" aria-label="Default select example">
                            <option value="Cualquiera">Cualquiera</option>
                            <% info.especialidades.forEach(op => { %>
                              <option value="<%= op.especialidad %>"><%= op.especialidad %></option>
                            <% }) %>
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-lg-12">
                  <div class="candidate-list">
                    <% info.listaContactos.forEach(contacto => { %>
                      <div class="candidate-list-box card mt-2" data-id-user="<%= contacto.id %>">
                        <div class="p-2 card-body">
                          <div class="align-items-center row">
                            <div class="col-auto">
                              <div class="candidate-list-images">
                                <img src="<%= contacto.foto_perfil ? contacto.foto_perfil : '/imagenes/user.png' %>" alt="<%= contacto.nombre || 'Usuario' %>" class="avatar-md img-thumbnail rounded-circle" />
                              </div>
                            </div>
                            <div class="col-lg-5">
                              <div class="candidate-list-content mt-1 mt-lg-0">
                                <h5 class="fs-19 mb-0">
                                  <a class="primary-link"><%= contacto.usuario_nombre_completo %></a>
                                </h5>
                                <p class="text-muted mb-1"><%= contacto.rol %></p>
                                <p class="text-muted mb-1"><%= contacto.departamento %></p>
                                <p class="text-muted mb-1"><%= contacto.correo_electronico %></p>
                              </div>
                            </div>
                            <div class="col-lg-4">
                              <div class="col-lg-4">



                                <div class="mt-2 mt-lg-0 d-flex flex-wrap align-items-start gap-1">


                                  <button class="badge bg-soft-secondary fs-14 mt-1" id="btnLlamar-<%= contacto.id %>" data-id-user="<%= contacto.id %>" data-nombre-user="<%= contacto.usuario_nombre_completo %>">


                                    <img src="/imagenes/llamada.png" alt="Llamada" class="avatar-md img-thumbnail " />


                                  </button>


                                  <button class="badge bg-soft-secondary fs-14 mt-1" id="btnMail-<%= contacto.id %>" data-correo-user ="<%= contacto.correo_electronico %>">


                                    <img src="/imagenes/imagenesSecretaria/mail.png" alt="Mail" class="avatar-md img-thumbnail " />


                                  </button>


                                  <button class="badge bg-soft-secondary fs-14 mt-1" id="btnChat-<%= contacto.id %>" data-id-user="<%= contacto.id %>">


                                    <img src="/imagenes/imagenesSecretaria/chats.png" alt="Chat" class="avatar-md img-thumbnail " />


                                  </button>


                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                </div>
              </div>
            </div>
          </main>
        </div>
      </div>

    <div
