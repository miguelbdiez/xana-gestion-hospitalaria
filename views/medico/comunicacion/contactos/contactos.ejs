    <style>
   /* Keep existing card styling */
.card {
  box-shadow: 0 20px 27px 0 rgba(0, 0, 0, 0.05);
}

/* Profile image styling */
.avatar-md {
  height: 4rem; /* Slightly smaller for consistency */
  width: 4rem;
}

/* Font size for name */
.fs-19 {
  font-size: 19px;
}

/* Link styling */
.primary-link {
  color: #314047;
  transition: all 0.5s ease;
}

a {
  color: #02af74;
  text-decoration: none;
}

/* Favorite icon (if used elsewhere) */
.favorite-icon a {
  display: inline-block;
  width: 30px;
  height: 30px;
  font-size: 18px;
  line-height: 30px;
  text-align: center;
  border: 1px solid #eff0f2;
  border-radius: 6px;
  color: rgba(173, 181, 189, 0.55);
  transition: all 0.5s ease;
}

.candidate-list-box .favorite-icon {
  position: absolute;
  right: 22px;
  top: 22px;
}

/* New class for action images */
.action-img {
  width: 32px; /* Smaller size */
  height: 32px;
  transition: all 0.3s ease;
}

/* Hover effect for action images */
.action-img-link:hover .action-img {
  opacity: 0.7; /* Subtle hover effect */
  transform: scale(1.1); /* Slight zoom on hover */
}

/* Reduce padding and margins for compact list items */
.candidate-list-box .card-body {
  padding: 1rem !important; /* Reduced padding */
}

.candidate-list-content {
  margin-top: 0.5rem !important; /* Reduced margin */
}

.candidate-list-content p {
  margin-bottom: 0.25rem !important; /* Tighter spacing between text */
}

/* Ensure the card has minimal top margin */
.candidate-list-box {
  margin-top: 0.5rem !important; /* Reduced from 4 to make list tighter */
}

/* Remove button-specific styling */
.bg-soft-secondary {
  background-color: transparent !important;
  border: none !important;
}

/* Ensure action images are spaced nicely */
.action-img-link {
  display: inline-block;
  margin-right: 0.5rem; /* Space between images */
}
    </style>

