      .alta-button {
    background-color: #13df00; /* Rojo Bootstrap para errores o alertas */
    color: white;
    border: none;
    margin-right:  170px; /* Desplaza el botón de Incidencia a la izquierda */
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 12px;
    padding: 5px 10px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.alta-button:hover {
    background-color: #3cbb0a; /* Un rojo más oscuro para el hover */
}/* Modal para alta médica */
#altaModal.alta-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1055;
}

#altaModal.alta-modal .alta-dialog {
  max-width: 95%;
  max-height: 90vh;
  margin: 1rem auto;
}

#altaModal.alta-modal .alta-content {
  background-color: #fefefe;
  border-radius: 12px;
  box-shadow: 0 6px 16px rgba(45, 212, 191, 0.2);
  border: 2px solid #5eead4;
  overflow: hidden;
}

#altaModal.alta-modal .alta-header {
  background: linear-gradient(to right, #2dd4bf, #6ee7b7);
  padding: 18px 24px;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #5eead4;
}

#altaModal.alta-modal .alta-title {
  font-family: 'Roboto', Arial, sans-serif;
  font-size: 1.3rem;
  font-weight: 600;
  color: #064e3b;
  margin: 0;
  display: flex;
  align-items: center;
}

#altaModal.alta-modal .alta-title::before {
  content: '🩺';
  margin-right: 8px;
  font-size: 1.2rem;
}

#altaModal.alta-modal .alta-close {
  background: none;
  border: none;
  font-size: 1.4rem;
  color: #064e3b;
  cursor: pointer;
  padding: 0;
  line-height: 1;
}

#altaModal.alta-modal .alta-close:hover {
  color: #047857;
}

#altaModal.alta-modal .alta-body {
  padding: 20px;
  display: flex;
  flex-direction: row;
  gap: 20px;
}

#altaModal.alta-modal .alta-form-container {
  flex: 1 1 auto;
  overflow-y: auto;
}

#altaModal.alta-modal .alta-section {
  margin-bottom: 20px;
}

#altaModal.alta-modal .alta-section h6 {
  font-family: 'Roboto', Arial, sans-serif;
  font-size: 1rem;
  font-weight: 600;
  color: #064e3b;
  margin-bottom: 10px;
}

#altaModal.alta-modal .alta-row {
  display: grid;
  gap: 10px;
  grid-template-columns: 1fr;
}

#altaModal.alta-modal .alta-row.general-info {
  grid-template-columns: repeat(2, 1fr);
}

#altaModal.alta-modal .alta-row.traslado-info {
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}

#altaModal.alta-modal .alta-field {
  display: flex;
  flex-direction: column;
}

#altaModal.alta-modal .alta-field label {
  font-family: 'Roboto', Arial, sans-serif;
  font-size: 0.7rem;
  font-weight: 700;
  color: #064e3b;
  text-transform: uppercase;
  margin-bottom: 4px;
}

#altaModal.alta-modal .alta-field p {
  font-family: 'Roboto', Arial, sans-serif;
  font-size: 0.85rem;
  color: #1f2937;
  margin: 0;
}

#altaModal.alta-modal .alta-field input,
#altaModal.alta-modal .alta-field select,
#altaModal.alta-modal .alta-field textarea {
  width: 100%;
  padding: 8px;
  background-color: #ecfdf5;
  border: 1px solid #5eead4;
  border-radius: 6px;
  font-family: 'Roboto', Arial, sans-serif;
  font-size: 0.85rem;
  color: #1f2937;
  transition: border-color 0.3s, box-shadow 0.3s;
}

#altaModal.alta-modal .alta-field textarea {
  min-height: 200px;
  resize: vertical;
}

#altaModal.alta-modal .alta-field input:focus,
#altaModal.alta-modal .alta-field select:focus,
#altaModal.alta-modal .alta-field textarea:focus {
  outline: none;
  border-color: #047857;
  box-shadow: 0 0 0 3px rgba(4, 120, 87, 0.15);
}

#altaModal.alta-modal .alta-field input::placeholder,
#altaModal.alta-modal .alta-field select::placeholder,
#altaModal.alta-modal .alta-field textarea::placeholder {
  color: #6b7280;
}

#altaModal.alta-modal .alta-footer {
  background-color: #f1f5f9;
  border-top: 1px solid #d1fae5;
  padding: 18px 24px;
  display: flex;
  justify-content: flex-end;
  gap: 14px;
}

#altaModal.alta-modal .alta-footer button {
  padding: 10px 20px;
  font-family: 'Roboto', Arial, sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: background-color 0.3s, transform 0.1s;
}

#altaModal.alta-modal .alta-btn-secondary {
  background-color: #475569;
  color: #ffffff;
}

#altaModal.alta-modal .alta-btn-secondary:hover {
  background-color: #334155;
  transform: translateY(-1px);
}

#altaModal.alta-modal .alta-btn-primary {
  background-color: #047857;
  color: #ffffff;
}

#altaModal.alta-modal .alta-btn-primary:hover {
  background-color: #065f46;
  transform: translateY(-1px);
}

#altaModal.alta-modal .hidden {
  display: none;
}

@media (max-width: 992px) {
  #altaModal.alta-modal .alta-body {
    flex-direction: column;
  }

  #altaModal.alta-modal .alta-row {
    grid-template-columns: 1fr;
  }

  #altaModal.alta-modal .alta-row.general-info {
    grid-template-columns: 1fr;
  }

  #altaModal.alta-modal .alta-row.traslado-info {
    grid-template-columns: 1fr;
  }

  #altaModal.alta-modal .alta-field textarea {
    min-height: 150px;
  }
}
    </style>





