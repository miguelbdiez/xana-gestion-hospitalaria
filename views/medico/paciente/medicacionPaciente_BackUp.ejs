    align-items: center;
    padding: 10px;
    border-bottom: 1px solid #e5e7eb;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    color: #1f2937;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .medicacion-item:hover {
    background-color: #e6fffa;
  }

  .medicacion-btn-primary {
    background-color: #2dd4bf;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .medicacion-btn-primary:hover {
    background-color: #26a69a;
    transform: translateY(-1px);
  }

  .medicacion-btn-secondary {
    background-color: #6b7280;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .medicacion-btn-secondary:hover {
    background-color: #4b5563;
  }

  .form-group {
    margin-bottom: 10px;
    flex: 1;
    min-width: 200px;
  }

  .form-group label {
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 5px;
    display: block;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 8px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    color: #1f2937;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #2dd4bf;
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.1);
  }

  .busqueda-medicamento {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
  }

  .busqueda-input {
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }

  .busqueda-input input {
    max-width: 300px;
  }

  .resultados-busqueda {
    background-color: #ffffff;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    min-height: 120px;
    max-height: 240px;
    overflow-y: auto;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .resultado-item {
    padding: 8px;
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .resultado-item:hover {
    background-color: #e6fffa;
  }

  .resultado-item:last-child {
    border-bottom: none;
  }

  .modal-footer {
    border-top: 1px solid #e5e7eb;
    padding: 15px 20px;
    background-color: #f8fafc;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .hidden {
    display: none;
  }

  .form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 10px;
  }
  
