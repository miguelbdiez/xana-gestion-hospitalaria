                </div>
              </div>
              <div class="last-message" style="color: #808080; font-size: 12px">
                <%= persona.ultimo_mensaje || '' %>
              </div>
              <div class="message-time" style="color: #808080; font-size: 10px">
                <%= persona.fecha_ultimo_mensaje || '' %>
              </div>
            </div>
          </li>
          <!-- Botón de llamada -->

          <% }) %>
