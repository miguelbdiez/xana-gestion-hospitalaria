    padding: 10px 20px;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

#medicacionModal .medicacion-btn-primary:hover {
    background-color: #26a69a;
    transform: translateY(-1px);
}

#medicacionModal .medicacion-btn-secondary {
    background-color: #6b7280;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

#medicacionModal .medicacion-btn-secondary:hover {
    background-color: #4b5563;
}

#medicacionModal .form-group {
    margin-bottom: 10px;
    flex: 1;
    min-width: 200px;
}

#medicacionModal .form-group label {
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 5px;
    display: block;
}

#medicacionModal .form-group input,
#medicacionModal .form-group select,
#medicacionModal .form-group textarea {
    width: 100%;
    padding: 8px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    color: #1f2937;
    transition: border-color 0.2s ease;
}

#medicacionModal .form-group input:focus,
#medicacionModal .form-group select:focus,
#medicacionModal .form-group textarea:focus {
    outline: none;
    border-color: #2dd4bf;
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.1);
}

#medicacionModal .busqueda-medicamento {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
}

#medicacionModal .busqueda-input {
    display: flex;
    gap: 10px;
    align-items: flex-end;
}

#medicacionModal .busqueda-input input {
    max-width: 300px;
}

#medicacionModal .resultados-busqueda {
    background-color: #ffffff;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    min-height: 120px;
    max-height: 240px;
    overflow-y: auto;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

#medicacionModal .resultado-item {
    padding: 8px;
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

#medicacionModal .resultado-item:hover {
    background-color: #e6fffa;
}

#medicacionModal .resultado-item:last-child {
    border-bottom: none;
}

#medicacionModal .modal-footer {
    border-top: 1px solid #e5e7eb;
    padding: 15px 20px;
    background-color: #f8fafc;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

#medicacionModal .hidden {
    display: none;
}

#medicacionModal .form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 10px;
}

#medicacionModal .form-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

#medicacionModal .form-control-static {
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    color: #1f2937;
    padding: 8px;
    background-color: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 6px;
}
      
