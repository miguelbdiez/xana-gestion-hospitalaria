                <div class="collapse" id="documentos-collapse">
                  <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                    <li><a href="/documentos/listaEmitirDocumento" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Emitir Documento</a></li>
                    <li><a href="/documentos/listaDocumentos" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Imprimir Documento</a></li>
                    <li><a href="/documentos/todosDocumentos" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Ver Documentos</a></li>
                  </ul>
                </div>
              </li>
              <li class="border-top my-3"></li>
              <li class="mb-1">
                <div class="d-flex align-items-center">
                  <a href="/comunicacionHome" class="btn d-inline-flex align-items-center rounded border-0 text-decoration-none text-primary fw-semibold">Comunicación</a>
                  <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed" data-bs-toggle="collapse" data-bs-target="#comunicacion-collapse" aria-expanded="false">
                    <svg class="bi pe-none" width="16" height="16"><use xlink:href="#chevron-down"/></svg>
                  </button>
                </div>
                <div class="collapse" id="comunicacion-collapse">
                  <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                    <li><a href="/comunicacion/chat" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Chat</a></li>
                    <li><a href="/comunicacion/contactos" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Contactos</a></li>
                    <li><a href="/comunicacion/mail/bandeja" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Mail</a></li>
                  </ul>
                </div>
              </li>
              <li class="border-top my-3"></li>
              <li class="mb-1">
                <div class="d-flex align-items-center">
                  <a href="/medicina/consultarExpedientes" class="btn d-inline-flex align-items-center rounded border-0 text-decoration-none text-primary fw-semibold">Expedientes</a>
                </div>
              </li>
              <li class="border-top my-3"></li>
            </ul>
          </div>
        </div>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario">Medicina | Medicación</h1>
            <div class="d-flex align-items-center">
              <a id="btnVolverLista" class="call-btn btn-img me-2" href="/planta">
                <img
                  src="/imagenes/volver.png"
                  alt="Volver"
                  style="width: 24px; height: 24px"
                />
              </a>
            </div>
           
          </div>
          <% if (info && info.infoCabecera) { %>
            <div class="patient-info-container container" 
                 data-documento-identificacion="<%= info.infoCabecera.documento_identificacion_paciente || 'unknown' %>" 
                 data-id-medico="<%= info.infoCabecera.medico_id || 'unknown' %>"
                 data-cama-id="<%= info.infoCabecera.cama_id || 'unknown' %>"
                 data-ingreso-id="<%= info.infoCabecera.ingreso_id || 'unknown' %>">
              <div class="header">
                <!-- Botón para abrir el modal -->
                <button class="edit-button incidence-button" data-bs-toggle="modal" data-bs-target="#incidenciaModal">Incidencia</button>
                <button class="edit-button" data-bs-toggle="modal" data-bs-target="#editModal">Editar</button>
                <!-- Panel del paciente a la izquierda -->
                <div class="panel-paciente">
                  <% if (info.infoCabecera.panelPaciente) { %>
                    <img src="<%= info.infoCabecera.panelPaciente %>" 
                         alt="Panel Paciente" />
                  <% } else { %>
                    <p>Sin imagen de panel</p>
                  <% } %>
                </div>
                
                <!-- Campos de la cabecera en columnas -->
                <div class="info-paciente">
                  <div class="info-column">
                    <p>
                      <strong>PACIENTE:</strong> 
                      <span id="paciente-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %>">
                        <%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.paciente_nombre_completo && info.infoCabecera.paciente_nombre_completo.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('paciente-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.paciente_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>MÉDICO:</strong> 
                      <span id="medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>">
                        <%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.medico_nombre_completo && info.infoCabecera.medico_nombre_completo.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.medico_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>SERVICIO:</strong> 
                      <span id="servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.especialidad || 'No disponible' %>">
                        <%= info.infoCabecera.especialidad || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.especialidad && info.infoCabecera.especialidad.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.especialidad.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>FECHA DE INGRESO:</strong> <span class="text-limited" title="<%= info.infoCabecera.fecha_ini || 'No disponible' %>"><%= info.infoCabecera.fecha_ini || 'No disponible' %></span></p>
                    <p>
                      <strong>DIAGNÓSTICO:</strong> 
                      <span id="diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.diagnostico || 'No especificado' %>">
                        <%= info.infoCabecera.diagnostico || 'No especificado' %>
                      </span>
                      <% if (info.infoCabecera.diagnostico && info.infoCabecera.diagnostico.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.diagnostico.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>ALERGIAS:</strong> 
                      <span id="alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>
                      </span>
                      <% 
                        const alergiasText = `(${info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna'}) ${info.infoCabecera.alergia || 'Ninguna'}`;
                        if (alergiasText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= alergiasText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                  <div class="info-column">
                    <p>
                      <strong>DIETA:</strong> 
                      <span id="dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>
                      </span>
                      <% 
                        const dietaText = `(${info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna'}) ${info.infoCabecera.dieta || 'Ninguna'}`;
                        if (dietaText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= dietaText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>AISLAMIENTO:</strong> <span class="text-limited" id="aislamiento-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %>"><%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %></span></p>
                    <p><strong>GRUPO SANGUÍNEO:</strong> <span class="text-limited" id="grupoSanguineo-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.grupo_rh || 'No especificado' %>"><%= info.infoCabecera.grupo_rh || 'No especificado' %></span></p>
                    <p>
                      <strong>HISTORIA:</strong> 
                      <span id="historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.historia || 'No disponible' %>">
                        <%= info.infoCabecera.historia || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.historia && info.infoCabecera.historia.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.historia.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>EPISODIO:</strong> <span class="text-limited" title="<%= info.infoCabecera.ingreso_id || 'No disponible' %>"><%= info.infoCabecera.ingreso_id || 'No disponible' %></span></p>
                    <p>
                      <strong>AT:</strong> 
                      <span id="antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.antecedentes || 'No disponible' %>">
                        <%= info.infoCabecera.antecedentes || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.antecedentes && info.infoCabecera.antecedentes.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.antecedentes.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="patient-info-container container">
              <p class="error-message">No se encontró información para el ingreso especificado.</p>
            </div>
          <% } %>

          <div class="container-medicacion">
            <div class="medicacion-header">
              <h2>Medicación Activa del Paciente</h2>
              <button type="button" class="medicacion-btn-primary" data-bs-toggle="modal" data-bs-target="#medicacionModal">
                Recetar/Modificar Medicación
              </button>
            </div>
          
            <!-- Verificar si hay medicación -->
            <% if (!info.medicacion || info.medicacion.length <= 0) { %>
              <div class="no-medicacion">
                <p>El paciente aún no tiene ninguna medicación recetada.</p>
              </div>
            <% } else { %>
              <!-- Lista de medicación en filas alargadas -->
              <div class="medicacion-list">
                <div class="medicacion-row medicacion-row-header">
                  <div class="medicacion-col">Medicamento</div>
                  <div class="medicacion-col">Vía</div>
                  <div class="medicacion-col">Dosis</div>
                  <div class="medicacion-col">Frecuencia</div>
                  <div class="medicacion-col">Duración</div>
                  <div class="medicacion-col">Inicio</div>
                  <div class="medicacion-col">Fin</div>
                  <div class="medicacion-col">Estado</div>
                </div>
                <% info.medicacion.forEach((medicacion, index) => { %>
                  <div class="medicacion-row <%= index % 2 === 0 ? 'medicacion-row-even' : 'medicacion-row-odd' %>">
                    <div class="medicacion-col"><%= medicacion.nombre_medicamento %></div>
                    <div class="medicacion-col"><%= medicacion.via_administracion %></div>
                    <div class="medicacion-col">
                      <%= medicacion.dosis %> <%= medicacion.via_administracion === 'Oral' ? 'comprimido(s)' : 'unidad(es)' %>
                    </div>
                    <div class="medicacion-col">Cada <%= medicacion.frecuencia_horas %> horas</div>
                    <div class="medicacion-col">
                      <% if (medicacion.fecha_fin) { %>
                        <% 
                          const inicio = new Date(medicacion.fecha_inicio);
                          const fin = new Date(medicacion.fecha_fin);
                          const dias = Math.ceil((fin - inicio) / (1000 * 60 * 60 * 24)) + 1;
                        %>
                        <%= dias %> día<%= dias > 1 ? 's' : '' %>
                      <% } else if (medicacion.numero_dosis) { %>
                        <%= medicacion.numero_dosis %> dosis
                      <% } else { %>
                        No especificada
                      <% } %>
                    </div>
                    <div class="medicacion-col"><%= medicacion.fecha_inicio.split(' ')[0] %></div>
                    <div class="medicacion-col">
                      <% if (medicacion.fecha_fin) { %>
                        <%= medicacion.fecha_fin.split(' ')[0] %>
                      <% } else if (medicacion.numero_dosis) { %>
                        Hasta <%= medicacion.numero_dosis %> dosis
                      <% } else { %>
                        No especificado
                      <% } %>
                    </div>
                    <div class="medicacion-col">
                      <span class="medicacion-badge <%= medicacion.estado === 'Activa' ? 'medicacion-badge-active' : 'medicacion-badge-paused'%>">
                        <%= medicacion.estado %>
                      </span>
                    </div>
                    
                  </div>
                <% }) %>
              </div>
            <% } %>
            

            <div class="medicacion-header">
              <h2>Historial De Administración De Medicación</h2>
            </div>
            
            <!-- Verificar si hay historial de administración -->
            <% if (!info.historialDeAdministracion || info.historialDeAdministracion.length <= 0) { %>
              <div class="no-medicacion">
                <p>Al paciente aún no se le ha administrado ninguna medicación durante este episodio.</p>
              </div>
            <% } else { %>
              <!-- Lista de administraciones en una sola línea -->
              <div class="medicacion-list">
                <% info.historialDeAdministracion.forEach((admin, index) => { %>
                  <div class="medicacion-entry-line <%= index % 2 === 0 ? 'medicacion-entry-line-even' : 'medicacion-entry-line-odd' %>">
                    <span class="medicacion-entry-line-field">
                      <% 
                        const fecha = new Date(admin.fecha_administracion);
                        const formattedDate = fecha.toLocaleString('es-ES', { 
                          day: '2-digit', 
                          month: '2-digit', 
                          year: 'numeric', 
                          hour: '2-digit', 
                          minute: '2-digit',
                          timeZone: 'Europe/Madrid' 
                        }).replace(',', '');
                      %>
                      <%= formattedDate %>
                    </span>
                    <span class="medicacion-entry-line-delimiter">·</span>
                    <span class="medicacion-entry-line-field"><%= admin.nombre_medicamento %></span>
                    <span class="medicacion-entry-line-delimiter">·</span>
                    <span class="medicacion-entry-line-field"><%= admin.notas || 'Sin notas' %></span>
                    <span class="medicacion-entry-line-delimiter">·</span>
                    <span class="medicacion-entry-line-field"><%= admin.nombre_enfermero %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>


            <div class="medicacion-header">
              <h2>Historial - Medicación Activa del Paciente</h2>
             
            </div>


            <!-- Verificar si hay historial de medicación -->
            <% if (!info.medicacionActivaHistorial || info.medicacionActivaHistorial.length <= 0) { %>
              <div class="no-medicacion">
                <p>El paciente aún no tiene ninguna medicación en su historial de medicacion activa.</p>
              </div>
            <% } else { %>
              
              <!-- Lista de medicación en filas alargadas -->
              <div class="medicacion-list">
                <div class="medicacion-row medicacion-row-header">
                  <div class="medicacion-col">Medicamento</div>
                  <div class="medicacion-col">Vía</div>
                  <div class="medicacion-col">Dosis</div>
                  <div class="medicacion-col">Frecuencia</div>
                  <div class="medicacion-col">Duración</div>
                  <div class="medicacion-col">Inicio</div>
                  <div class="medicacion-col">Fin</div>
                  <div class="medicacion-col">Estado</div>
                </div>
                <% info.medicacionActivaHistorial.forEach((medicacion, index) => { %>
                  <div class="medicacion-row <%= index % 2 === 0 ? 'medicacion-row-even' : 'medicacion-row-odd' %>">
                    <div class="medicacion-col"><%= medicacion.nombre_medicamento %></div>
                    <div class="medicacion-col"><%= medicacion.via_administracion %></div>
                    <div class="medicacion-col">
                      <%= medicacion.dosis %> <%= medicacion.via_administracion === 'Oral' ? 'comprimido(s)' : 'unidad(es)' %>
                    </div>
                    <div class="medicacion-col">Cada <%= medicacion.frecuencia_horas %> horas</div>
                    <div class="medicacion-col">
                      <% if (medicacion.fecha_fin) { %>
                        <% 
                          const inicio = new Date(medicacion.fecha_inicio);
                          const fin = new Date(medicacion.fecha_fin);
                          const dias = Math.ceil((fin - inicio) / (1000 * 60 * 60 * 24)) + 1;
                        %>
                        <%= dias %> día<%= dias > 1 ? 's' : '' %>
                      <% } else if (medicacion.numero_dosis) { %>
                        <%= medicacion.numero_dosis %> dosis
                      <% } else { %>
                        No especificada
                      <% } %>
                    </div>
                    <div class="medicacion-col"><%= medicacion.fecha_inicio.split(' ')[0] %></div>
                    <div class="medicacion-col">
                      <% if (medicacion.fecha_fin) { %>
                        <%= medicacion.fecha_fin.split(' ')[0] %>
                      <% } else if (medicacion.numero_dosis) { %>
                        Hasta <%= medicacion.numero_dosis %> dosis
                      <% } else { %>
                        No especificado
                      <% } %>
                    </div>
                    <div class="medicacion-col">
                      <span class="medicacion-badge-inactive">
                        <%= medicacion.estado %>
                      </span>
                    </div>
                    
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
           

      
        </main>
      </div>
    </div>

    <div class="modal fade" id="medicacionModal" tabindex="-1" aria-labelledby="medicacionModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="medicacionModalLabel">Gestionar Medicación</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Lista de medicación activa -->
            <h6>Medicación Activa</h6>
            <div class="medicacion-activa" id="medicacionList">
              <% if (info.medicacion && info.medicacion.length > 0) { %>
                <% info.medicacion.forEach(medicamento => { %>
                  <div class="medicacion-item" data-id="<%= medicamento.id_medicacion %>" onclick="editarMedicacion('<%= medicamento.id_medicacion %>')">
                    <span>Medicamento: <%= medicamento.nombre_medicamento %> | Pauta: (<%= medicamento.dosis %> und) - Cada <%= medicamento.frecuencia_horas %> horas - <%= medicamento.estado %></span>
                  </div>
                <% }) %>
              <% } else { %>
                <p>No hay medicación recetada.</p>
              <% } %>
            </div>
    
            <!-- Botón para recetar nuevo medicamento -->
            <button class="medicacion-btn-primary mt-3" id="btnRecetarNuevo" onclick="mostrarFormulario('agregar')">Recetar Nuevo Medicamento</button>
    
            <!-- Formulario para añadir medicamento (original) -->
            <form id="formAgregarMedicacion" class="hidden">
              <h6 class="mt-4">Añadir Medicamento</h6>
              <!-- Búsqueda de medicamento -->
              <div class="busqueda-medicamento">
                <div class="busqueda-input">
                  <div class="form-group">
                    <label for="buscar-medicamento">Buscar Medicamento</label>
                    <input type="text" id="buscar-medicamento" class="form-control" placeholder="Paracetamol, Ibuprofeno" maxlength="50">
                  </div>
                  <button type="button" class="medicacion-btn-primary" onclick="buscarMedicamentos()">Buscar</button>
                </div>
                <div class="resultados-busqueda" id="resultados-busqueda"></div>
              </div>
    
              <!-- Campos del medicamento -->
              <div class="form-group">
                <label for="nombre_medicamento">Medicamento</label>
                <input type="text" class="form-control" id="nombre_medicamento" name="nombre_medicamento" readonly required>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="dosis">Dosis</label>
                  <input type="text" class="form-control" id="dosis" name="dosis" required>
                </div>
                <div class="form-group">
                  <label for="frecuencia_horas">Cada (horas)</label>
                  <input type="text" class="form-control" id="frecuencia_horas" name="frecuencia_horas" required>
                </div>
                <div class="form-group">
                  <label for="via_administracion">Vía Administración</label>
                  <input type="text" class="form-control" id="via_administracion" name="via_administracion" required>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="fecha_inicio">Desde (fecha)</label>
                  <input type="date" class="form-control" id="fecha_inicio" name="fecha_inicio" required>
                </div>
                <div class="form-group">
                  <label for="fecha_fin">Hasta (fecha, opcional)</label>
                  <input type="date" class="form-control" id="fecha_fin" name="fecha_fin">
                </div>
                <div class="form-group">
                  <label for="numero_dosis">O Número de Dosis</label>
                  <input type="number" class="form-control" id="numero_dosis" name="numero_dosis" min="1">
                </div>
              </div>
              <div class="form-actions">
                <button type="submit" class="medicacion-btn-primary" id="btnAñadirMedicamento">Añadir a Medicación Activa</button>
                <button type="button" class="medicacion-btn-secondary" onclick="cancelarFormulario()">Cancelar</button>
              </div>
            </form>
    
            <!-- Formulario para editar medicamento -->
            <form id="formEditarMedicacion" class="hidden">
              <h6 class="mt-4">Editar Medicación</h6>
              <div class="form-group">
                <label>Medicamento</label>
                <p class="form-control-static" id="edit_nombre_medicamento"></p>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="edit_via_administracion">Vía de Administración</label>
                  <input type="text" class="form-control" id="edit_via_administracion" name="via_administracion" required>
                </div>
                <div class="form-group">
                  <label for="edit_dosis">Dosis</label>
                  <input type="number" class="form-control" id="edit_dosis" name="dosis" min="1" required>
                </div>
                <div class="form-group">
                  <label for="edit_frecuencia_horas">Frecuencia (horas)</label>
                  <input type="number" class="form-control" id="edit_frecuencia_horas" name="frecuencia_horas" required>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="edit_fecha_inicio">Fecha de Inicio</label>
                  <input type="date" class="form-control" id="edit_fecha_inicio" name="fecha_inicio" required>
                </div>
                <div class="form-group">
                  <label for="edit_fecha_fin">Fecha de Fin (opcional)</label>
                  <input type="date" class="form-control" id="edit_fecha_fin" name="fecha_fin">
                </div>
                <div class="form-group">
                  <label for="edit_numero_dosis">Número de Dosis (opcional)</label>
                  <input type="number" class="form-control" id="edit_numero_dosis" name="numero_dosis" min="1">
                </div>
              </div>
              <div class="form-group">
                <label for="edit_estado">Estado</label>
                <select class="form-control" id="edit_estado" name="estado" required>
                  <option value="Activa">Activa</option>
                  <option value="Pausada">Pausada</option>
                  <option value="Finalizada">Finalizada</option>
                </select>
              </div>
              <div class="form-actions">
                <button type="submit" class="medicacion-btn-primary" id="btnActualizarMedicamento">Actualizar Medicación</button>
                <button type="button" class="medicacion-btn-secondary" onclick="cancelarFormulario()">Cancelar</button>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="medicacion-btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            <button type="button" class="medicacion-btn-primary" id="btnGuardarCambios" onclick="guardarCambios()">Guardar Cambios</button>
          </div>
        </div>
      </div>
