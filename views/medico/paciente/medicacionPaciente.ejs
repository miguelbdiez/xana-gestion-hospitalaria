    <script>
      // Almacenar medicación inicial y medicamento seleccionado
      const medicacionInicial = <%- JSON.stringify(info.medicacion || []) %>;
      let medicacionesModificadas = [];
      let medicacionEditandoId = null;
      let medicamentoSeleccionado = null;
      let tempIdCounter = -1; // Para IDs temporales de nuevas medicaciones
    
      // Mostrar formulario (tipo: 'agregar' o 'editar')
      function mostrarFormulario(tipo) {
        const formAgregar = document.getElementById('formAgregarMedicacion');
        const formEditar = document.getElementById('formEditarMedicacion');
        const btnRecetar = document.getElementById('btnRecetarNuevo');
    
        formAgregar.classList.add('hidden');
        formEditar.classList.add('hidden');
        btnRecetar.classList.add('hidden');
    
        if (tipo === 'agregar') {
          formAgregar.classList.remove('hidden');
          formAgregar.reset();
          document.getElementById('nombre_medicamento').value = medicamentoSeleccionado ? medicamentoSeleccionado.nombre : '';
          document.getElementById('estado').value = 'Activa';
          medicacionEditandoId = null;
          document.getElementById('btnAñadirMedicamento').textContent = 'Añadir a Medicación Activa';
        } else if (tipo === 'editar') {
          formEditar.classList.remove('hidden');
        }
      }
    
      // Cancelar formulario y volver al estado inicial
      function cancelarFormulario() {
        const formAgregar = document.getElementById('formAgregarMedicacion');
        const formEditar = document.getElementById('formEditarMedicacion');
        const btnRecetar = document.getElementById('btnRecetarNuevo');
    
        formAgregar.classList.add('hidden');
        formEditar.classList.add('hidden');
        btnRecetar.classList.remove('hidden');
        formAgregar.reset();
        formEditar.reset();
        medicacionEditandoId = null;
        medicamentoSeleccionado = null;
      }
    
      // Buscar medicamentos
      async function buscarMedicamentos() {
        const query = document.getElementById('buscar-medicamento').value;
        const resultados = document.getElementById('resultados-busqueda');
        try {
          const response = await fetch(`/buscarMedicamentosCoincidenciaNombre?q=${encodeURIComponent(query)}`);
          if (!response.ok) throw new Error('Error al buscar medicamentos');
          const data = await response.json();
          const medicamentos = data.data;
          resultados.innerHTML = medicamentos.length > 0
            ? medicamentos.map(med => `
                <div data-id_medicamento="${med.id}"  class="resultado-item" onclick="seleccionarMedicamento('${med.nombre}', ${med.cantidad}, ${med.id}, '${med.lote}')">
                  ${med.nombre} (Lote: ${med.lote}, Cantidad: ${med.cantidad})
                </div>
              `).join('')
            : '<p>No se encontraron medicamentos.</p>';
        } catch (error) {
          console.error('Error:', error);
          resultados.innerHTML = '<p>Error al buscar medicamentos.</p>';
        }
      }
    
      // Seleccionar un medicamento
      function seleccionarMedicamento(nombre, cantidad, id_medicamento, lote) {
        console.log(lote)
        medicamentoSeleccionado = { nombre, cantidad, id_medicamento, lote };
        document.getElementById('nombre_medicamento').value = nombre;
        document.getElementById('resultados-busqueda').innerHTML = '';
        document.getElementById('buscar-medicamento').value = '';
      }
    
      // Editar una medicación
      function editarMedicacion(id_medicacion) {
        const medicacion = medicacionesModificadas.find(m => m.id_medicacion == id_medicacion) || 
                           medicacionInicial.find(m => m.id_medicacion == id_medicacion);
        if (!medicacion) return;
    
        mostrarFormulario('editar');
        medicacionEditandoId = id_medicacion;
    
        document.getElementById('edit_nombre_medicamento').textContent = medicacion.nombre_medicamento;
        document.getElementById('edit_via_administracion').value = medicacion.via_administracion;
        document.getElementById('edit_dosis').value = medicacion.dosis;
        document.getElementById('edit_frecuencia_horas').value = medicacion.frecuencia_horas;
        document.getElementById('edit_fecha_inicio').value = medicacion.fecha_inicio.split(' ')[0];
        document.getElementById('edit_fecha_fin').value = medicacion.fecha_fin ? medicacion.fecha_fin.split(' ')[0] : '';
        document.getElementById('edit_numero_dosis').value = medicacion.numero_dosis || '';
        document.getElementById('edit_estado').value = medicacion.estado || 'Activa';
        medicamentoSeleccionado = { 
          nombre: medicacion.nombre_medicamento, 
          id_medicamento: medicacion.id_medicamento 
        };
      }
    
      // Actualizar la lista de medicaciones en el modal
      function actualizarListaMedicaciones() {
        const list = document.getElementById('medicacionList');
        // Combinar medicaciones no modificadas de medicacionInicial con medicacionesModificadas
        const medicaciones = [
          ...medicacionInicial.filter(m => !medicacionesModificadas.some(mod => mod.id_medicacion == m.id_medicacion)),
          ...medicacionesModificadas
        ];
        list.innerHTML = medicaciones.length > 0
          ? medicaciones.map(med => `
              <div class="medicacion-item" data-id="${med.id_medicacion}" onclick="editarMedicacion('${med.id_medicacion}')">
                <span>Medicamento: ${med.nombre_medicamento} | Pauta: ${med.dosis}  - Cada ${med.frecuencia_horas} horas - ${med.estado}</span>
              </div>
            `).join('')
          : '<p>No hay medicación recetada.</p>';
      }
    
      // Manejar formulario de añadir
      document.getElementById('formAgregarMedicacion').addEventListener('submit', (event) => {
        event.preventDefault();
        const formData = new FormData(event.target);
        const data = Object.fromEntries(formData);
    
        // Validar número de dosis si no hay fecha_fin
        if (!data.fecha_fin && !data.numero_dosis) {
          alert('Debe proporcionar el número de dosis si no hay fecha de fin.');
          return;
        }
    
        
    
        const medicacion = {
          id_medicacion: medicacionEditandoId || tempIdCounter--, // ID temporal para nuevas medicaciones
          nombre_medicamento: data.nombre_medicamento,
          via_administracion: data.via_administracion,
          id_medicamento: medicamentoSeleccionado.id_medicamento,
          lote_medicamento:medicamentoSeleccionado.lote,
          dosis: data.dosis,
          frecuencia_horas: data.frecuencia_horas,
          fecha_inicio: data.fecha_inicio,
          fecha_fin: data.fecha_fin || null,
          numero_dosis: data.numero_dosis ? data.numero_dosis : null,
          paciente_id: '<%= info.infoCabecera.documento_identificacion_paciente || " " %>',
          medico_id: '<%= info.id || "" %>',
          ingreso_id: '<%= info.ingreso_id || "" %>',
          estado:"Activa"
        };
        medicacionesModificadas.push(medicacion);

    
        // Actualizar o añadir medicación
        if (medicacionEditandoId) {
          const index = medicacionesModificadas.findIndex(m => m.id_medicacion == medicacionEditandoId);
          if (index !== -1) {
            medicacionesModificadas[index] = medicacion;
          } else {
            medicacionesModificadas.push(medicacion);
          }
        } else {
        }
    
        // Actualizar la lista en el modal
        actualizarListaMedicaciones();
    
        // Ocultar formulario y mostrar botón
        document.getElementById('formAgregarMedicacion').classList.add('hidden');
        document.getElementById('btnRecetarNuevo').classList.remove('hidden');
        event.target.reset();
        medicamentoSeleccionado = null;
      });
    
      // Manejar formulario de editar
      document.getElementById('formEditarMedicacion').addEventListener('submit', (event) => {
        event.preventDefault();
        const formData = new FormData(event.target);
        const data = Object.fromEntries(formData);
    
        // Validar número de dosis si no hay fecha_fin
        if (!data.fecha_fin && !data.numero_dosis) {
          alert('Debe proporcionar el número de dosis si no hay fecha de fin.');
          return;
        }
    
        const medicacion = {
          id_medicacion: medicacionEditandoId,
          nombre_medicamento: document.getElementById('edit_nombre_medicamento').textContent,
          via_administracion: data.via_administracion,
          id_medicamento: medicamentoSeleccionado.id_medicamento,
          dosis: data.dosis,
          frecuencia_horas: parseFloat(data.frecuencia_horas),
          fecha_inicio: data.fecha_inicio,
          fecha_fin: data.fecha_fin || null,
          numero_dosis: data.numero_dosis ? parseInt(data.numero_dosis) : null,
          paciente_id: '<%= info.infoCabecera.documento_identificacion_paciente || "" %>',
          medico_id: '<%= info.id || "" %>',
          ingreso_id: '<%= info.ingreso_id || "" %>',
          estado: data.estado
        };
    
        const index = medicacionesModificadas.findIndex(m => m.id_medicacion == medicacionEditandoId);
        if (index !== -1) {
          medicacionesModificadas[index] = medicacion;
        } else {
          medicacionesModificadas.push(medicacion);
        }
    
        // Actualizar la lista en el modal
        actualizarListaMedicaciones();
    
        // Volver al estado inicial
        cancelarFormulario();
      });
    
      // Guardar cambios en el servidor
      async function guardarCambios() {
        const pacienteId = '<%= info.infoCabecera.documento_identificacion_paciente || "" %>';
        const ingresoId = '<%= info.ingreso_id || "" %>';
        if (!pacienteId || !ingresoId) {
          alert('Error: ID del paciente o ingreso no definido');
          return;
        }
    
        try {
          for (const medicacion of medicacionesModificadas) {
            const response = await fetch(
              !medicacion.id_medicacion || medicacion.id_medicacion < 0 ? '/paciente/agregarMedicacion' : `/paciente/actualizarMedicacion`,
              {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(medicacion)
              }
            );
            if (!response.ok) {
              throw new Error('Error al guardar medicación');
            }
          }
          alert('Cambios guardados correctamente');
          medicacionesModificadas = [];
          document.getElementById('medicacionModal').querySelector('.btn-close').click();
          window.location.reload();
        } catch (error) {
          console.error('Error:', error);
          alert('Error al guardar los cambios');
        }
      }
    </script>
   
   <script>
      document.addEventListener('DOMContentLoaded', () => {
    const nuevaIncidenciaBtn = document.getElementById('btnNuevaIncidencia');
    const nuevaIncidenciaForm = document.getElementById('nuevaIncidenciaForm');
    const cancelarIncidenciaBtn = document.getElementById('btnCancelarIncidencia');
    const aceptarIncidenciaBtn = document.getElementById('btnAceptarIncidencia');
    const incidenciaCuerpo = document.getElementById('incidenciaCuerpo');
    const incidenciasLista = document.getElementById('incidenciasLista');

    // Mostrar/ocultar formulario de nueva incidencia
    nuevaIncidenciaBtn.addEventListener('click', () => {
      nuevaIncidenciaForm.style.display = 'block';
      nuevaIncidenciaBtn.style.display = 'none';
    });

    cancelarIncidenciaBtn.addEventListener('click', () => {
      nuevaIncidenciaForm.style.display = 'none';
      nuevaIncidenciaBtn.style.display = 'block';
      incidenciaCuerpo.value = '';
    });

    // Añadir nueva incidencia
    aceptarIncidenciaBtn.addEventListener('click', async () => {
      const cuerpo = incidenciaCuerpo.value.trim();
      const cama_id = '<%= info.infoCabecera.cama_id || 'unknown' %>';
      const documento_identificacion_paciente ='<%= info.infoCabecera.documento_identificacion_paciente || 'unknown' %>';
     
      const ingresoId = '<%= info.infoCabecera.ingreso_id || 'unknown' %>';
      if (!cuerpo) {
        alert('Por favor, ingrese una descripción para la incidencia.');
        return;
      }

      try {
        const response = await fetch('/enfermeria/reportarIncidencia', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ingreso_id: ingresoId, cuerpo, activa: 1 ,cama_id:cama_id, documento_identificacion_paciente: documento_identificacion_paciente})
        });
       if (response.ok) {
          const nuevaIncidencia = await response.json();
          console.log(nuevaIncidencia)
          const listItem = document.createElement('li');
          listItem.className = 'list-group-item d-flex justify-content-between align-items-center';
          listItem.innerHTML = `
            <div>
              <strong>Descripcion: ${nuevaIncidencia.informacion_incidencia}</strong>
              <br>
              <small>Episodio: ${nuevaIncidencia.ingreso_id} | Estado: Activa | Fecha: ${nuevaIncidencia.fecha_emision}</small>
            </div>
            <button class="btn btn-danger btn-sm desactivar-incidencia" 
                    data-id-incidencia="${nuevaIncidencia.id_incidencia}" 
                    data-id-ingreso="${nuevaIncidencia.ingreso_id}">Desactivar</button>
          `;
          incidenciasLista.appendChild(listItem);
          incidenciaCuerpo.value = '';
          nuevaIncidenciaForm.style.display = 'none';
          nuevaIncidenciaBtn.style.display = 'block';

          // Si la lista estaba vacía, remover el mensaje de "No hay incidencias"
          const noIncidenciasItem = incidenciasLista.querySelector('li');
          if (noIncidenciasItem && noIncidenciasItem.textContent === 'No hay incidencias asociadas.') {
            noIncidenciasItem.remove();
          }

          const panel = document.querySelector('.panel-paciente img');
          panel.src = nuevaIncidencia.panelPaciente;
        }
         else {
          alert('Error al añadir la incidencia.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al conectar con el servidor.');
      }
    });

    // Desactivar incidencia
    incidenciasLista.addEventListener('click', async (e) => {
      if (e.target.classList.contains('desactivar-incidencia')) {
        const idIncidencia = e.target.dataset.idIncidencia;
        const idIngreso = e.target.dataset.idIngreso;
        const cama_id = '<%= info.infoCabecera.cama_id || 'unknown' %>';

        console.log(`Desactivando incidencia - ID Ingreso: ${idIngreso}, ID Incidencia: ${idIncidencia}`);

        try {
          const response = await fetch(`/enfermeria/desactivarIncidencia`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idIncidencia,activa: 0,cama_id, ingreso_id:idIngreso })
          });

          if (response.ok) {
            const nuevaIncidenciaDesactivada = await response.json();
            console.log(nuevaIncidenciaDesactivada);

            // Actualizar la lista de incidencias
            const listItem = e.target.closest('.list-group-item');
            listItem.querySelector('small').textContent = `Episodio: ${nuevaIncidenciaDesactivada.ingreso_id} | Estado: Inactiva | Fecha de desactivación: ${nuevaIncidenciaDesactivada.fecha_desactivacion}`;
            e.target.remove();

            // Actualizar el panel del paciente si panelPaciente no es null
            if (nuevaIncidenciaDesactivada.panelPaciente) {
              const panel = document.querySelector('.panel-paciente img');
              if (panel) {
                panel.src = nuevaIncidenciaDesactivada.panelPaciente;
              } else {
                console.warn('No se encontró el elemento .panel-paciente img en el DOM');
              }
            }
          }else {
            alert('Error al desactivar la incidencia.');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error al conectar con el servidor.');
        }
      }
    });

  })
      // Función para expandir/colapsar texto
      function expandirTexto(id, fullText) {
        const element = document.getElementById(id);
        const button = element.nextElementSibling;
        if (element.classList.contains('text-limited')) {
          element.classList.remove('text-limited');
          element.classList.add('text-full');
          element.innerText = fullText;
          button.innerText = 'Ver menos';
        } else {
          element.classList.remove('text-full');
          element.classList.add('text-limited');
          element.innerText = fullText;
          button.innerText = 'Ver más';
        }
      }
  
      // Función para inicializar el estado de los campos de alergias y dieta
      function initializarModalInputs() {
        const tipoAlergia = document.querySelector('input[name="tipoAlergia"]:checked');
        const alergiaInput = document.getElementById('modalAlergia');
        if (tipoAlergia) {
          alergiaInput.disabled = tipoAlergia.value === 'ninguna';
          if (tipoAlergia.value === 'ninguna') alergiaInput.value = '';
        }
  
        const tipoDieta = document.querySelector('input[name="tipoDieta"]:checked');
        const dietaInput = document.getElementById('modalDieta');
        if (tipoDieta) {
          dietaInput.disabled = tipoDieta.value === 'ninguna';
          if (tipoDieta.value === 'ninguna') dietaInput.value = '';
        }
      }
  
      // Habilitar/deshabilitar campos de alergias y dieta al cambiar selección
      document.querySelectorAll('input[name="tipoAlergia"]').forEach(radio => {
        radio.addEventListener('change', function() {
          const alergiaInput = document.getElementById('modalAlergia');
          alergiaInput.disabled = this.value === 'ninguna';
          if (this.value === 'ninguna') alergiaInput.value = '';
        });
      });
  
      document.querySelectorAll('input[name="tipoDieta"]').forEach(radio => {
        radio.addEventListener('change', function() {
          const dietaInput = document.getElementById('modalDieta');
          dietaInput.disabled = this.value === 'ninguna';
          if (this.value === 'ninguna') dietaInput.value = '';
        });
      });
  
      // Inicializar el estado al abrir el modal
      document.getElementById('editModal').addEventListener('shown.bs.modal', function () {
        initializarModalInputs();
      });
  
      // Aplicar cambios
      async function aplicarCambiosPanel(ingresoId) {
        console.log('Ingreso ID:', ingresoId); // Depuración
  
        const diagnostico = document.getElementById('modalDiagnostico').value;
        let tipoAlergiaInput = document.querySelector('input[name="tipoAlergia"]:checked');
        let tipoAlergia = tipoAlergiaInput ? tipoAlergiaInput.value : 'ninguna';
        let alergia = document.getElementById('modalAlergia').value;
        let tipoDietaInput = document.querySelector('input[name="tipoDieta"]:checked');
        let tipoDieta = tipoDietaInput ? tipoDietaInput.value : 'ninguna';
        let dieta = document.getElementById('modalDieta').value;
        const aislamientoInput = document.querySelector('input[name="aislamiento"]:checked');
        const aislamiento = aislamientoInput ? aislamientoInput.value === 'si' : false;
        const grupoSanguineo = document.getElementById('modalGrupoSanguineo').value;
        const cama_id = '<%= info.infoCabecera.cama_id || 'unknown' %>';
        const medico_id = '<%= info.infoCabecera.medico_id || 'unknown' %>';
        const documento_identificacion_paciente = '<%= info.infoCabecera.documento_identificacion_paciente || 'unknown' %>';
        console.log("cama_id", cama_id)
  
        // Ajustar valores según las condiciones
        if (tipoDieta === "ninguna") {
          tipoDieta = "non";
