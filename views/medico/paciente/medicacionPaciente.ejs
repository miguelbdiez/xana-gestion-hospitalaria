            const alergiasElement = document.getElementById(`alergias-${ingresoId}`);
            if (alergiasElement) {
              const alergiasText = `(${tipoAlergia === 'grave' ? 'Grave' : tipoAlergia === 'moderada' ? 'Moderada' : tipoAlergia === 'leve' ? 'Leve' : 'Ninguna'}) ${alergia || 'Ninguna'}`;
