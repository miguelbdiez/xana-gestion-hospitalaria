    cursor: pointer;
    transition: background-color 0.2s ease;
}

#medicacionModal .medicacion-item:hover {
    background-color: #e6fffa;
}

#medicacionModal .medicacion-btn-primary {
    background-color: #2dd4bf;
    color: #ffffff;
