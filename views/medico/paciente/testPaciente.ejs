    <script>
      // Global variables (set these from server or context)
    const ingreso_id = "<%= info.ingreso_id %>"; // Replace with actual ingreso_id
    const paciente_id = "<%= info.infoCabecera.documento_identificacion_paciente %>"; // Replace with actual paciente_id
    const cama_id = "<%= info.infoCabecera.cama_id %>"
    const pruebas = <%- JSON.stringify(info.infoTestPaciente) %>;

// Función para filtrar la tabla
    function filtrarTabla() {
      const filtroTipoPrueba = document
        .getElementById("filtroTipoPrueba")
        .value.toLowerCase();
      const tbody = document.getElementById("tablaPruebasBody");
      const filas = tbody.getElementsByClassName("prueba-row");

      for (let i = 0; i < filas.length; i++) {
        const tipoPrueba = (filas[i].getAttribute("data-tipo") || "").toLowerCase();

        const coincideTipo =
          filtroTipoPrueba === "" || tipoPrueba === filtroTipoPrueba;

        if (coincideTipo) {
          filas[i].style.display = "";
        } else {
          filas[i].style.display = "none";
        }
      }
    }

    // Añadir evento al filtro
    document.getElementById("filtroTipoPrueba").addEventListener("change", function () {
      filtrarTabla();
    });

// Añadir evento de clic a las filas
document.querySelectorAll(".prueba-row").forEach((row) => {
  row.addEventListener("click", async function () {
    // Extract row data from attributes and text content
    const rowData = {
      id: this.getAttribute("data-id"),
      ingreso_id: this.getAttribute("data-ingreso_id"),
      id_trabajador: this.getAttribute("data-id_trabajador"),
      nombre_trabajador: this.getAttribute("data-nombre_trabajador"),
      tipo_prueba: this.getAttribute("data-tipo"),
      documento_identificacion: this.getAttribute("data-documento_identificacion"),
      id_del_test: this.getAttribute("data-id_del_test"),
      fecha_emision: this.querySelector(`#fechaEmision_${this.rowIndex - 1}`).textContent,
      resultado: this.querySelector(`#resultado_${this.rowIndex - 1}`).textContent,
      interpretacion: this.querySelector(`#interpretacion_${this.rowIndex - 1}`).textContent,
    };
    console.log("Datos de la fila:", rowData);

    try {
      // Fetch test-specific details from the server
      const response = await fetch(`/enfermeria/recuperarVariablesTest?ingreso_id=${encodeURIComponent(rowData.ingreso_id)}&id_del_test=${encodeURIComponent(rowData.id_del_test)}&tipo_prueba=${encodeURIComponent(rowData.tipo_prueba)}`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          // Add authentication headers if needed, e.g., 'Authorization': 'Bearer <token>'
        },
      });

      if (!response.ok) {
        throw new Error(`Error fetching test details: ${response.statusText}`);
