          document.getElementById('norton_condicion_fisica').textContent = testDetails.condicion_fisica !== undefined && testDetails.condicion_fisica !== null ? testDetails.condicion_fisica : 'N/A';
          document.getElementById('norton_condicion_mental').textContent = testDetails.condicion_mental !== undefined && testDetails.condicion_mental !== null ? testDetails.condicion_mental : 'N/A';
          document.getElementById('norton_actividad').textContent = testDetails.actividad !== undefined && testDetails.actividad !== null ? testDetails.actividad : 'N/A';
          document.getElementById('norton_movilidad').textContent = testDetails.movilidad !== undefined && testDetails.movilidad !== null ? testDetails.movilidad : 'N/A';
          document.getElementById('norton_incontinencia').textContent = testDetails.incontinencia !== undefined && testDetails.incontinencia !== null ? testDetails.incontinencia : 'N/A';
          break;

        case 'Braden':
          modalId = 'bradenModal';
          modal = document.getElementById(modalId);
          if (!modal) throw new Error(`Modal with ID ${modalId} not found in DOM`);

          // Populate general information
          document.getElementById('braden_paciente_nombre').textContent = rowData.documento_identificacion ?? 'N/A';
          document.getElementById('braden_nombre_trabajador').textContent = rowData.nombre_trabajador ?? 'N/A';
          document.getElementById('braden_ingreso_id').textContent = rowData.ingreso_id ?? 'N/A';
          document.getElementById('braden_fecha_emision').textContent = rowData.fecha_emision ?? 'N/A';
          document.getElementById('braden_tipo_prueba').textContent = rowData.tipo_prueba ?? 'N/A';
          document.getElementById('braden_resultado').textContent = rowData.resultado ?? 'N/A';
          document.getElementById('braden_interpretacion').textContent = rowData.interpretacion ?? 'N/A';

          // Populate Braden-specific fields
          document.getElementById('braden_percepcion_sensorial').textContent = testDetails.percepcion_sensorial !== undefined && testDetails.percepcion_sensorial !== null ? testDetails.percepcion_sensorial : 'N/A';
          document.getElementById('braden_humedad').textContent = testDetails.humedad !== undefined && testDetails.humedad !== null ? testDetails.humedad : 'N/A';
          document.getElementById('braden_actividad').textContent = testDetails.actividad !== undefined && testDetails.actividad !== null ? testDetails.actividad : 'N/A';
          document.getElementById('braden_movilidad').textContent = testDetails.movilidad !== undefined && testDetails.movilidad !== null ? testDetails.movilidad : 'N/A';
          document.getElementById('braden_nutricion').textContent = testDetails.nutricion !== undefined && testDetails.nutricion !== null ? testDetails.nutricion : 'N/A';
          document.getElementById('braden_friccion_cizallamiento').textContent = testDetails.friccion_cizallamiento !== undefined && testDetails.friccion_cizallamiento !== null ? testDetails.friccion_cizallamiento : 'N/A';
          break;

        default:
          throw new Error(`Unknown test type: ${rowData.tipo_prueba}`);
      }

      // Show the modal
      const bootstrapModal = new bootstrap.Modal(modal);
      bootstrapModal.show();
      console.log(`Modal ${modalId} shown`);
    } catch (error) {
      console.error('Error loading test details:', error);
      alert('No se pudieron cargar los detalles del test. Por favor, intenta de nuevo.');
    }
  });
