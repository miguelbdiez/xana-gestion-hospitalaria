                        <button class="toggle-button" onclick="expandirTexto('paciente-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.paciente_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>MÉDICO:</strong> 
                      <span id="medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>">
                        <%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.medico_nombre_completo && info.infoCabecera.medico_nombre_completo.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.medico_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>SERVICIO:</strong> 
                      <span id="servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.especialidad || 'No disponible' %>">
                        <%= info.infoCabecera.especialidad || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.especialidad && info.infoCabecera.especialidad.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.especialidad.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>FECHA DE INGRESO:</strong> <span class="text-limited" title="<%= info.infoCabecera.fecha_ini || 'No disponible' %>"><%= info.infoCabecera.fecha_ini || 'No disponible' %></span></p>
                    <p>
                      <strong>DIAGNÓSTICO:</strong> 
                      <span id="diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.diagnostico || 'No especificado' %>">
                        <%= info.infoCabecera.diagnostico || 'No especificado' %>
                      </span>
                      <% if (info.infoCabecera.diagnostico && info.infoCabecera.diagnostico.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.diagnostico.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>ALERGIAS:</strong> 
                      <span id="alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>
                      </span>
                      <% 
                        const alergiasText = `(${info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna'}) ${info.infoCabecera.alergia || 'Ninguna'}`;
                        if (alergiasText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= alergiasText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                  <div class="info-column">
                    <p>
                      <strong>DIETA:</strong> 
                      <span id="dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>
                      </span>
                      <% 
                        const dietaText = `(${info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna'}) ${info.infoCabecera.dieta || 'Ninguna'}`;
                        if (dietaText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= dietaText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>AISLAMIENTO:</strong> <span class="text-limited" id="aislamiento-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %>"><%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %></span></p>
                    <p><strong>GRUPO SANGUÍNEO:</strong> <span class="text-limited" id="grupoSanguineo-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.grupo_rh || 'No especificado' %>"><%= info.infoCabecera.grupo_rh || 'No especificado' %></span></p>
                    <p>
                      <strong>HISTORIA:</strong> 
                      <span id="historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.historia || 'No disponible' %>">
                        <%= info.infoCabecera.historia || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.historia && info.infoCabecera.historia.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.historia.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>EPISODIO:</strong> <span class="text-limited" title="<%= info.infoCabecera.ingreso_id || 'No disponible' %>"><%= info.infoCabecera.ingreso_id || 'No disponible' %></span></p>
                    <p>
                      <strong>AT:</strong> 
                      <span id="antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.antecedentes || 'No disponible' %>">
                        <%= info.infoCabecera.antecedentes || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.antecedentes && info.infoCabecera.antecedentes.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.antecedentes.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="patient-info-container container">
              <p class="error-message">No se encontró información para el ingreso especificado.</p>
            </div>
          <% } %>

              <div class="test-section">
                <h1 class="test-title">Test Del Paciente</h1>

              
                <!-- Filtros -->
                <div class="row mb-4 g-3 align-items-center">
                  <div class="col-md-4">
                    <div class="input-group">
                      <span class="input-group-text bg-primary text-white">
                        <i class="fas fa-file-alt"></i>
                      </span>
                      <select id="filtroTipoPrueba" class="form-select">
                        <option value="">Todos los tipos</option>
                        <option value="barthel">Barthel</option>
                        <option value="eva">EVA</option>
                        <option value="downtown">Downtown</option>
                        <option value="norton">Norton</option>
                        <option value="braden">Braden</option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <button
                      type="button"
                      class="btn add-test-btn"
                      data-bs-toggle="modal"
                      data-bs-target="#addTestModal"
                    >
                      <i class="fas fa-plus"></i> Agregar Nuevo Test
                    </button>
                  </div>
                </div>

                <!-- Tabla -->
                <div class="card shadow">
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table
                        id="tablaPruebas"
                        class="table table-striped table-bordered table-hover mb-0"
                        style="width: 100%"
                      >
                        <thead class="bg-primary text-white">
                          <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Resultado</th>
                            <th>Interpretación</th>
                          </tr>
                        </thead>
                        <tbody id="tablaPruebasBody">
                          <% info.infoTestPaciente.forEach((prueba, index) => { %>
                          <tr
                            class="prueba-row"
                            data-id="<%= prueba.id %>"
                            data-ingreso_id="<%= prueba.ingreso_id %>"
                            data-id_trabajador="<%= prueba.id_trabajador %>"
                            data-nombre_trabajador="<%= prueba.nombreTrabajador %>"
                            data-tipo="<%= prueba.tipo_prueba %>"
                            data-documento_identificacion="<%= prueba.documento_identificacion %>"
                            data-id_del_test="<%= prueba.id_del_test %>"
                          >
                            <td id="fechaEmision_<%= index %>"><%= prueba.fecha_emision %></td>
                            <td id="tipoPrueba_<%= index %>"><%= prueba.tipo_prueba %></td>
                            <td id="resultado_<%= index %>"><%= prueba.resultado %></td>
                            <td id="interpretacion_<%= index %>"><%= prueba.interpretacion %></td>
                          </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
              
          
          </div>
        </main>
      </div>
    </div>

    <div class="modal fade incidencia-modal" id="incidenciaModal" tabindex="-1" aria-labelledby="incidenciaModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="incidenciaModalLabel">Gestión de Incidencias</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Lista de incidencias -->
            <div class="mb-3">
              <h6>Incidencias Asociadas</h6>
              <ul id="incidenciasLista" class="list-group">
                <% if (info.infoIncidencias && info.infoIncidencias.length > 0) { %>
                  <% info.infoIncidencias.forEach(incidencia => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <div data-id_incidencia=" <%= incidencia.id_incidencia %>">
                        <strong>Descripcion: </strong> - <%= incidencia.informacion_incidencia %>
                        <br>
                        <small>
                          Episodio: <%= incidencia.ingreso_id %> | 
                          Estado: <%= incidencia.activa ? 'Activa' : 'Inira' %> | 
                          Fecha de emisión: <%= incidencia.fecha_emision %> 
                          <% if (!incidencia.activa && incidencia.fecha_desactivacion) { %>
                            | Fecha de desactivación: <%= incidencia.fecha_desactivacion %>
                          <% } %>
                        </small>
                      </div>
                      <% if (incidencia.activa) { %>
                        <button class="btn btn-danger btn-sm desactivar-incidencia" data-id-incidencia="<%= incidencia.id_incidencia %>" data-id-ingreso="<%= incidencia.ingreso_id %>">Desactivar</button>
                      <% } %>
                    </li>
                  <% }); %>
                <% } else { %>
                  <li class="list-group-item">No hay incidencias asociadas.</li>
                <% } %>
              </ul>
            </div>
            <!-- Botón para añadir nueva incidencia -->
            <button type="button" class="btn btn-primary mb-3" id="btnNuevaIncidencia">Nueva Incidencia</button>
            <!-- Formulario para nueva incidencia (oculto inicialmente) -->
            <div id="nuevaIncidenciaForm" style="display: none;">
              <div class="mb-3">
                <label for="incidenciaCuerpo" class="form-label">Descripción de la Incidencia:</label>
                <textarea class="form-control" id="incidenciaCuerpo" rows="4" placeholder="Escriba los detalles de la incidencia"></textarea>
              </div>
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" id="btnCancelarIncidencia">Cancelar</button>
