    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>


    <script>
        document.addEventListener('DOMContentLoaded', function() {
  const pacientes = <%- JSON.stringify(info.pacientes) %>;

  const table = new DataTable('#tablaPacientes', {
    language: {
      url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json'
    },
    pageLength: 10,
    order: [[1, 'asc']]
  });

  // Filtros
  const filtroNombre = document.getElementById('filtroNombre');
  const filtroNumExpediente = document.getElementById('filtroNumExpediente');

  if (filtroNombre) {
    filtroNombre.addEventListener('input', function() {
      table.column(1).search(this.value).draw();
    });
  }

  if (filtroNumExpediente) {
    filtroNumExpediente.addEventListener('input', function() {
      table.column(2).search(this.value).draw();
    });
  }

  // Función para decodificar entidades HTML
  function decodeHtml(html) {
    const txt = document.createElement('textarea');
    txt.innerHTML = html;
    return txt.value;
  }

  // Evento click en fila
  const tbody = document.querySelector('#tablaPacientes tbody');
  if (tbody) {
    tbody.addEventListener('click', function(e) {
      const row = e.target.closest('.paciente-row');
      if (row) {
        const pacienteStr = row.dataset.paciente;
        try {
          const decodedStr = decodeHtml(pacienteStr);
          const paciente = JSON.parse(decodedStr);
          console.log('Paciente seleccionado:', paciente);
          // Ejemplo: redirigir a una página de detalles
           window.location.href = `/medicina/consultarEpisodiosPaciente?historia_id=${paciente.historia_id}`;
        } catch (error) {
          console.error('Error al parsear paciente:', error, 'Valor:', pacienteStr);
        }
      }
    });
  }
});
    </script>
   
