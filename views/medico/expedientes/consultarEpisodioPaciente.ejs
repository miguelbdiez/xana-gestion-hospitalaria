                </span>
                <span class="btn-text">Aceptar</span>
              </button>

              <button
                class="bouton raccrocher"
                id="btnRechazarLlamada"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Colgar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    
    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>


    <!-- Scripts necesarios -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

<script>
 document.addEventListener('DOMContentLoaded',  () => {
      const episodeItems = document.querySelectorAll('.list-group-item');
      episodeItems.forEach(item => {
        item.addEventListener('click', async () => {
          const episode = item.getAttribute('data-episode');
          try {
        const response = await fetch(`/medicina/episodioPaciente?episodio=${episode}`, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            // Add any additional headers if needed (e.g., authorization)
          },
        });

        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();
        console.log('Respuesta del servidor:', data);
      } catch (error) {
        console.error('Error al hacer la solicitud:', error.message);
      }

        });
      });
    });
</script>
   
  </body>
</html>
