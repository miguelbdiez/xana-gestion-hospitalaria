        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario">Medicina</h1>
            <div class=" d-flex align-items-center">
              <a id="btnVolverLista" class="call-btn btn-img me-2" href="/medicina/consultarEpisodiosPaciente?historia_id=<%= info.historia_id %>">
                <img
                  src="/imagenes/volver.png"
                  alt="Volver"
                  style="width: 24px; height: 24px"
                />
              </a>
              <h2 class="m-0">Episodio</h2>
            </div>
          </div>
          <div class="container-informacionEpisodio">
            <div class="container mt-4">
              <h2 class="mb-4">Información del Episodio</h2>
          
              <!-- Diagnósticos Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Diagnósticos</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.diagnostico && info.infoEpisodio.diagnostico.length > 0) { %>
                    <% info.infoEpisodio.diagnostico.forEach(diag => { %>
                      <div class="entry-card">
                        <div class="entry-header">Diagnóstico: <%= diag.descripcion || 'No especificado' %></div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Código:</strong> <%= diag.codigo || 'No especificado' %></p>
                              <p><strong>Descripción:</strong> <%= diag.descripcion || 'No especificado' %></p>
                              <p><strong>Diagnóstico Escrito:</strong> <%= diag.diagnosticoEscrito || 'No especificado' %></p>
                              <p><strong>Estado:</strong> <%= diag.estadoDiagnostico || 'No especificado' %></p>
                              <p><strong>Gravedad:</strong> <%= diag.gravedad || 'No especificado' %></p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Síntomas Asociados:</strong> <%= diag.sintomasAsociados || 'No especificado' %></p>
                              <p><strong>Pruebas Diagnósticas:</strong> <%= diag.pruebasDiagnostico || 'No especificado' %></p>
                              <p><strong>Plan de Tratamiento:</strong> <%= diag.planTratamiento || 'No especificado' %></p>
                              <p><strong>Médico:</strong> <%= diag.nombre_medico || 'No especificado' %></p>
                              <p><strong>Fecha Emisión:</strong> <%= diag.fecha_emision || 'No especificado' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay diagnósticos disponibles.</p>
                  <% } %>
                </div>
              </details>
              <!-- Alta del Paciente Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Alta del Paciente</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.altaPaciente) { %>
                    <div class="entry-card">
                      <div class="entry-header">Alta (Fecha: <%= info.infoEpisodio.altaPaciente.fecha_alta || 'En curso' %>)</div>
                      <div class="entry-body">
                        <div class="entry-row">
                          <div class="entry-col">
                            <p><strong>Tipo de Alta:</strong> <%= info.infoEpisodio.altaPaciente.tipo_alta || 'No especificado' %></p>
                            <p><strong>Destino:</strong> <%= info.infoEpisodio.altaPaciente.destino_alta || 'No especificado' %></p>
                            <p><strong>Profesional:</strong> <%= info.infoEpisodio.altaPaciente.profesional_nombre || 'No especificado' %></p>
                            <p><strong>Diagnóstico Principal:</strong> <%= info.infoEpisodio.altaPaciente.diagnostico_principal || 'No especificado' %></p>
                            <p><strong>Evolución Clínica:</strong> <%= info.infoEpisodio.altaPaciente.evolucion_clinica || 'No especificado' %></p>
                          </div>
                          <div class="entry-col">
                            <p><strong>Diagnósticos Secundarios:</strong> <%= info.infoEpisodio.altaPaciente.diagnosticos_secundarios || 'No especificado' %></p>
                            <p><strong>Procedimientos:</strong> <%= info.infoEpisodio.altaPaciente.procedimientos || 'No especificado' %></p>
                            <p><strong>Motivo Ingreso:</strong> <%= info.infoEpisodio.altaPaciente.motivo_ingreso || 'No especificado' %></p>
                            <p><strong>Tratamiento Realizado:</strong> <%= info.infoEpisodio.altaPaciente.tratamiento_realizado || 'No especificado' %></p>
                          </div>
                        </div>
                        <div class="entry-row">
                          <div class="entry-col">
                            <p><strong>Tratamiento Alta:</strong> <%= info.infoEpisodio.altaPaciente.tratamiento_alta || 'No especificado' %></p>
                            <p><strong>Plan Seguimiento:</strong> <%= info.infoEpisodio.altaPaciente.plan_seguimiento || 'No especificado' %></p>
                            <p><strong>Indicaciones Paciente:</strong> <%= info.infoEpisodio.altaPaciente.indicaciones_paciente || 'No especificado' %></p>
                            <p><strong>Nivel Dependencia:</strong> <%= info.infoEpisodio.altaPaciente.nivel_dependencia || 'No especificado' %></p>
                          </div>
                          <div class="entry-col">
                            <p><strong>Riesgos Alta:</strong> <%= info.infoEpisodio.altaPaciente.riesgos_alta || 'No especificado' %></p>
                            <p><strong>Paciente:</strong> <%= info.infoEpisodio.altaPaciente.paciente_nombre_completo || 'No especificado' %></p>
                            <p><strong>Cama:</strong> <%= info.infoEpisodio.altaPaciente.cama_id || 'No especificado' %></p>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% } else { %>
                    <p class="expedientes-no-data">El paciente sigue ingresado o no hay alta registrada.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Incidencias Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Incidencias</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.incidencias && info.infoEpisodio.incidencias.length > 0) { %>
                    <% info.infoEpisodio.incidencias.forEach(inc => { %>
                      <div class="entry-card">
                        <div class="entry-header"> </div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Cama:</strong> <%= inc.cama_id || 'No especificado' %></p>
                              <p><strong>Activa:</strong> <%= inc.activa ? 'Sí' : 'No' %></p>
                              <p><strong>Fecha Emisión:</strong> <%= inc.fecha_emision || 'No especificado' %></p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Información:</strong> <%= inc.informacion_incidencia || 'No especificado' %></p>
                              <p><strong>Fecha Desactivación:</strong> <%= inc.fecha_desactivacion ? inc.fecha_desactivacion : 'En curso' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay incidencias disponibles.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Vías del Paciente Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Vías del Paciente</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.viasPaciente && info.infoEpisodio.viasPaciente.length > 0) { %>
                    <% info.infoEpisodio.viasPaciente.forEach(via => { %>
                      <div class="entry-card">
                        <div class="entry-header"></div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Fecha Emisión:</strong> <%= via.fecha_emision || 'No especificado' %></p>
                              <p><strong>Fecha Fin:</strong> <%= via.fecha_fin ? via.fecha_fin : 'En curso' %></p>
                              <p><strong>Tipo Vía:</strong> <%= via.tipo_via || 'No especificado' %></p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Descripción:</strong> <%= via.descripcion || 'No especificado' %></p>
                              <p><strong>Trabajador:</strong> <%= via.nombre_trabajador || 'No especificado' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay vías disponibles.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Constantes del Paciente Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Constantes del Paciente</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.constantesPaciente && info.infoEpisodio.constantesPaciente.length > 0) { %>
                    <% info.infoEpisodio.constantesPaciente.forEach(constante => { %>
                      <div class="entry-card">
                        <div class="entry-header">Constante: <%= constante.id %> (Fecha: <%= constante.fecha_emision || 'No especificado' %>)</div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Temperatura:</strong> <%= constante.temperatura || 'No especificado' %> °C</p>
                              <p><strong>Tos:</strong> <%= constante.tos || 'No especificado' %></p>
                              <p><strong>Disnea:</strong> <%= constante.disnea || 'No especificado' %></p>
                              <p><strong>Saturación O₂:</strong> <%= constante.saturacionO2 || 'No especificado' %> %</p>
                              <p><strong>Frecuencia Cardíaca:</strong> <%= constante.frecCardiaca || 'No especificado' %> bpm</p>
                            </div>
                            <div class="entry-col">
                              <p><strong>TAS:</strong> <%= constante.tas || 'No especificado' %> mmHg</p>
                              <p><strong>TAD:</strong> <%= constante.tad || 'No especificado' %> mmHg</p>
                              <p><strong>Frecuencia Respiratoria:</strong> <%= constante.frecRespiratoria || 'No especificado' %> rpm</p>
                              <p><strong>Glucemia:</strong> <%= constante.glucemia || 'No especificado' %> mg/dL</p>
                              <p><strong>Insulina Basal:</strong> <%= constante.insulinaBasal || 'No especificado' %> U</p>
                            </div>
                          </div>
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Insulina Rápida:</strong> <%= constante.insulinaRapida || 'No especificado' %> U</p>
                              <p><strong>Concentración O₂:</strong> <%= constante.concO2 || 'No especificado' %> %</p>
                              <p><strong>Oxígeno:</strong> <%= constante.oxigeno || 'No especificado' %> L/min</p>
                              <p><strong>Peso:</strong> <%= constante.peso || 'No especificado' %> kg</p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Talla:</strong> <%= constante.talla || 'No especificado' %> m</p>
                              <p><strong>Perímetro Abdominal:</strong> <%= constante.perimetroAbdominal || 'No especificado' %> cm</p>
                              <p><strong>IMC:</strong> <%= constante.imc || 'No especificado' %></p>
                              <p><strong>Peso Ingreso:</strong> <%= constante.pesoIngreso || 'No especificado' %> kg</p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay constantes disponibles.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Balances del Paciente Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Balances del Paciente</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.balancesPaciente && info.infoEpisodio.balancesPaciente.length > 0) { %>
                    <% info.infoEpisodio.balancesPaciente.forEach(balance => { %>
                      <div class="entry-card">
                        <div class="entry-header">Balance (Fecha: <%= balance.fecha_emision || 'No especificado' %>)</div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Entradas:</strong> <%= balance.entradas || 'No especificado' %> mL</p>
                              <p><strong>Salidas:</strong> <%= balance.salidas || 'No especificado' %> mL</p>
                              <p><strong>Balance Total:</strong> <%= balance.balance_total || 'No especificado' %> mL</p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Trabajador:</strong> <%= balance.nombre_trabajador || 'No especificado' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay balances disponibles.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Evolutivo de Enfermería Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Evolutivo de Enfermería</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.evolutivoEnfermeria && info.infoEpisodio.evolutivoEnfermeria.length > 0) { %>
                    <% info.infoEpisodio.evolutivoEnfermeria.forEach(evol => { %>
                      <div class="entry-card">
                        <div class="entry-header">Entrada: (Fecha: <%= evol.fecha_emision || 'No especificado' %>)</div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Enfermero:</strong> <%= evol.nombreTrabajador || 'No especificado' %></p>
                              <p><strong>Turno:</strong> <%= evol.turno || 'No especificado' %></p>
                              <p><strong>Paciente:</strong> <%= evol.paciente_nombre_completo || 'No especificado' %></p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Especialidad:</strong> <%= evol.especialidad || 'No especificado' %></p>
                              <p><strong>Información:</strong> <%= evol.informacion_evolutivo || 'No especificado' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay evolutivos de enfermería disponibles.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Evolutivo Médico Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Evolutivo Médico</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.evolutivoMedico && info.infoEpisodio.evolutivoMedico.length > 0) { %>
                    <% info.infoEpisodio.evolutivoMedico.forEach(evol => { %>
                      <div class="entry-card">
                        <div class="entry-header">Entrada: (Fecha: <%= evol.fecha_emision || 'No especificado' %>)</div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Médico:</strong> <%= evol.nombreTrabajador || 'No especificado' %></p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Información:</strong> <%= evol.informacion_evolutivo || 'No especificado' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay evolutivos médicos disponibles.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Tests del Paciente Section -->
              <details class="expedientes-section">
                <summary class="section-header">
                  <span class="section-title">Tests del Paciente</span>
                  <span class="disclosure-arrow"></span>
                </summary>
                <div class="section-content">
                  <% if (info && info.infoEpisodio.testPaciente && info.infoEpisodio.testPaciente.length > 0) { %>
                    <% info.infoEpisodio.testPaciente.forEach(test => { %>
                      <div class="entry-card">
                        <div class="entry-header">Test: (Fecha: <%= test.fecha_emision || 'No especificado' %>)</div>
                        <div class="entry-body">
                          <div class="entry-row">
                            <div class="entry-col">
                              <p><strong>Tipo de Prueba:</strong> <%= test.tipo_prueba || 'No especificado' %></p>
                              <p><strong>Resultado:</strong> <%= test.resultado || 'No especificado' %></p>
                              <p><strong>Interpretación:</strong> <%= test.interpretacion || 'No especificado' %></p>
                            </div>
                            <div class="entry-col">
                              <p><strong>Trabajador:</strong> <%= test.nombreTrabajador || 'No especificado' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="expedientes-no-data">No hay tests disponibles.</p>
                  <% } %>
                </div>
              </details>
          
              <!-- Medicación del Paciente Section -->
                <details class="expedientes-section">
                    <summary class="section-header">
                    <span class="section-title">Medicación del Paciente</span>
                    <span class="disclosure-arrow"></span>
                    </summary>
                    <div class="section-content">
                    <% if (info && info.infoEpisodio.medicacionPaciente && info.infoEpisodio.medicacionPaciente.length > 0) { %>
                        <% info.infoEpisodio.medicacionPaciente.forEach(med => { %>
                        <div class="entry-card">
                            <div class="entry-header">Medicación: (<%= med.nombre_medicamento || 'No especificado' %>)</div>
                            <div class="entry-body">
                            <div class="entry-row">
                                <div class="entry-col">
                                <p><strong>Frecuencia (horas):</strong> <%= med.frecuencia_horas || 'No especificado' %> h</p>
                                <p><strong>Vía Administración:</strong> <%= med.via_administracion || 'No especificado' %></p>
                                <p><strong>Dosis:</strong> <%= med.dosis || 'No especificado' %></p>
                                <p><strong>Estado:</strong> <%= med.estado || 'No especificado' %></p>
                                <p><strong>Fecha Emisión:</strong> <%= med.fecha_emision || 'No especificado' %></p>
                                <p><strong>Fecha Inicio:</strong> <%= med.fecha_inicio || 'No especificado' %></p>
                                </div>
                                <div class="entry-col">
                                <p><strong>Fecha Fin:</strong> <%= med.fecha_fin ? med.fecha_fin : 'En curso' %></p>
                                <p><strong>Número de Dosis:</strong> <%= med.numero_dosis || 'No especificado' %></p>
                                </div>
                            </div>
                            </div>
                        </div>
                        <% }) %>
                    <% } else { %>
                        <p class="expedientes-no-data">No hay medicación disponible.</p>
                    <% } %>
                    </div>
                </details>
          
              
            </div>
          </div>
        </main>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalLlamando"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name">Llamando</p>
                <p
                  data-Persona-a-la-que-se-llama-id=""
                  id="persona_a_la_que_se_llama"
                ></p>
              </div>
            </div>
            <div class="footer">
              <!-- Este bloque contiene el nombre y se coloca encima del segundo footer -->

              <!-- Segundo bloque de footer con los botones -->
