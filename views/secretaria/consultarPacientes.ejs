                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Colgar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
   <!-- Modal -->
<div class="modal fade" id="pacienteModal" tabindex="-1" aria-labelledby="pacienteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="pacienteModalLabel">Información del Paciente</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title" id="modalNombre"></h5>
            <div class="row">
              <div class="col-md-6">
                <p class="card-text">
                  <strong>Documento:</strong>
                  <span id="modalDocumento"></span>
                </p>
                <p class="card-text">
                  <strong>Fecha Nacimiento:</strong>
                  <span id="modalFecha" class="editable" data-field="fecha_nacimiento"></span>
                  <input type="date" id="modalFechaInput" class="form-control d-none" />
                </p>
                <p class="card-text">
                  <strong>Dirección:</strong>
                  <span id="modalDireccion" class="editable" data-field="direccion"></span>
                  <input type="text" id="modalDireccionInput" class="form-control d-none" />
                </p>
                <p class="card-text">
                  <strong>Teléfono:</strong>
                  <span id="modalTelefono" class="editable" data-field="telefono"></span>
                  <input type="text" id="modalTelefonoInput" class="form-control d-none" />
                </p>
                <p class="card-text">
                  <strong>Email:</strong>
                  <span id="modalEmail" class="editable" data-field="correo_electronico"></span>
                  <input type="email" id="modalEmailInput" class="form-control d-none" />
                </p>
              </div>
              <div class="col-md-6">
                <p class="card-text">
                  <strong>Persona Emergencia:</strong>
                  <span id="modalEmergencia" class="editable" data-field="persona_emergencia"></span>
                  <input type="text" id="modalEmergenciaInput" class="form-control d-none" />
                </p>
                <p class="card-text">
                  <strong>Tel. Emergencia:</strong>
                  <span id="modalTelEmergencia" class="editable" data-field="telefono_emergencia"></span>
                  <input type="text" id="modalTelEmergenciaInput" class="form-control d-none" />
                </p>
                <p class="card-text">
                  <strong>Nacionalidad:</strong>
                  <span id="modalNacionalidad" class="editable" data-field="nacionalidad"></span>
                  <input type="text" id="modalNacionalidadInput" class="form-control d-none" />
                </p>
                <p class="card-text">
                  <strong>Sexo:</strong>
                  <span id="modalSexo" class="editable" data-field="sexo"></span>
                  <select id="modalSexoInput" class="form-control d-none">
                    <option value="Hombre">Hombre</option>
                    <option value="Mujer">Mujer</option>
                    <option value="Otro">Otro</option>
                  </select>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="btnModificar">Modificar Datos</button>
        <button type="button" class="btn btn-success d-none" id="btnGuardar">Guardar</button>
        <button type="button" class="btn btn-danger d-none" id="btnDescartar">Descartar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
