    <!-- Scripts necesarios -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <link
      rel="stylesheet"
      href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <script>
     const pacientes = JSON.parse(document.currentScript.dataset.pacientes || '[]');

document.addEventListener('DOMContentLoaded', () => {
  const table = new DataTable('#tablaPacientes', {
    language: {
      url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json'
    },
    pageLength: 10,
    order: [[1, 'asc']]
  });

  // Filtros
  document.getElementById('filtroNombre').addEventListener('keyup', (e) => {
    table.column(1).search(e.target.value).draw();
  });

  document.getElementById('filtroDocumento').addEventListener('keyup', (e) => {
    table.column(0).search(e.target.value).draw();
  });

  document.getElementById('filtroSexo').addEventListener('change', (e) => {
    table.column(9).search(e.target.value).draw();
  });

 // Evento click en fila
document.querySelector('#tablaPacientes tbody').addEventListener('click', (e) => {
  const row = e.target.closest('.paciente-row');
  if (!row) return;

  const paciente = JSON.parse(row.dataset.paciente);

  // Rellenar modal con datos
  document.getElementById('modalNombre').textContent = paciente.paciente_nombre_completo;
  document.getElementById('modalDocumento').textContent = paciente.documento_identificacion;
  document.getElementById('modalFecha').textContent = paciente.fecha_nacimiento;
  document.getElementById('modalFechaInput').value = paciente.fecha_nacimiento;
  document.getElementById('modalDireccion').textContent = paciente.direccion;
  document.getElementById('modalDireccionInput').value = paciente.direccion;
  document.getElementById('modalTelefono').textContent = paciente.telefono;
  document.getElementById('modalTelefonoInput').value = paciente.telefono;
  document.getElementById('modalEmail').textContent = paciente.correo_electronico;
  document.getElementById('modalEmailInput').value = paciente.correo_electronico;
  document.getElementById('modalEmergencia').textContent = paciente.persona_emergencia;
  document.getElementById('modalEmergenciaInput').value = paciente.persona_emergencia;
  document.getElementById('modalTelEmergencia').textContent = paciente.telefono_emergencia;
  document.getElementById('modalTelEmergenciaInput').value = paciente.telefono_emergencia;
  document.getElementById('modalNacionalidad').textContent = paciente.nacionalidad;
  document.getElementById('modalNacionalidadInput').value = paciente.nacionalidad;
  document.getElementById('modalSexo').textContent = paciente.sexo;
  // Ensure the select reflects the current sexo value
  const sexoInput = document.getElementById('modalSexoInput');
  sexoInput.value = paciente.sexo || 'Otro'; // Default to 'Otro' if sexo is null

  // Mostrar modal
  const modal = new bootstrap.Modal(document.getElementById('pacienteModal'));
  modal.show();
});
  // Modo edición
  let isEditing = false;
  const btnModificar = document.getElementById('btnModificar');
  const btnGuardar = document.getElementById('btnGuardar');
  const btnDescartar = document.getElementById('btnDescartar');

  btnModificar.addEventListener('click', () => {
    isEditing = true;
    btnModificar.classList.add('d-none');
    btnGuardar.classList.remove('d-none');
    btnDescartar.classList.remove('d-none');

    document.querySelectorAll('.editable').forEach(span => {
      const field = span.dataset.field;
      const input = document.getElementById(`${span.id}Input`);
      span.classList.add('d-none');
      input.classList.remove('d-none');
    });
  });

  btnDescartar.addEventListener('click', () => {
    isEditing = false;
    btnModificar.classList.remove('d-none');
    btnGuardar.classList.add('d-none');
    btnDescartar.classList.add('d-none');

    document.querySelectorAll('.editable').forEach(span => {
      const field = span.dataset.field;
      const input = document.getElementById(`${span.id}Input`);
      input.classList.add('d-none');
      span.classList.remove('d-none');
    });

    bootstrap.Modal.getInstance(document.getElementById('pacienteModal')).hide();
  });

  btnGuardar.addEventListener('click', async () => {
    const updatedData = {
      documento_identificacion: document.getElementById('modalDocumento').textContent,
      fecha_nacimiento: document.getElementById('modalFechaInput').value,
      direccion: document.getElementById('modalDireccionInput').value,
      telefono: document.getElementById('modalTelefonoInput').value,
      correo_electronico: document.getElementById('modalEmailInput').value,
      persona_emergencia: document.getElementById('modalEmergenciaInput').value,
      telefono_emergencia: document.getElementById('modalTelEmergenciaInput').value,
      nacionalidad: document.getElementById('modalNacionalidadInput').value,
      sexo: document.getElementById('modalSexoInput').value
    };

    try {
      const response = await fetch('/modificarDatosPaciente', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(updatedData)
      });

      console.log(response)
      if (response.ok) {
        window.location.reload();
      } else {
        alert('Error al guardar los datos');
      }
    } catch (error) {
      alert('Error en la conexión: ' + error.message);
    }
  });
});
    </script>
  </body>
</html>
