          <div class="copias-section">
            <div class="scrollable-content">
              <div class="container mt-3">
                <h2 class="mb-4">Consultar Pacientes</h2>
                <div class="row mb-4 g-2">
                  <div class="col-md-4 col-12">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-primary text-white">
                        <i class="fas fa-user"></i>
                      </span>
                      <input
                        type="text"
                        id="filtroNombre"
                        class="form-control"
                        placeholder="Filtrar por nombre"
                      />
                    </div>
                  </div>
                  <div class="col-md-4 col-12">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-primary text-white">
                        <i class="fas fa-id-card"></i>
                      </span>
                      <input
                        type="text"
                        id="filtroDocumento"
                        class="form-control"
                        placeholder="Filtrar por documento"
                      />
                    </div>
                  </div>
                  <div class="col-md-2 col-6">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-primary text-white">
                        <i class="fas fa-venus-mars"></i>
                      </span>
                      <select id="filtroSexo" class="form-select">
                        <option value="">Todos los sexos</option>
                        <option value="Hombre">Hombre</option>
                        <option value="Mujer">Mujer</option>
                      </select>
                    </div>
                  </div>
                 
                </div>
                <div class="card shadow copias-card">
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table
                        id="tablaPacientes"
                        class="table table-striped table-bordered table-hover mb-0"
                        style="width: 100%; min-width: 600px;"
                      >
                        <thead class="bg-primary text-white">
                          <tr>
                            <th>Documento</th>
                            <th>Nombre Completo</th>
                            <th>Fecha Nacimiento</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th>Emergencia</th>
                            <th>Tel. Emergencia</th>
                            <th>Nacionalidad</th>
                            <th>Sexo</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (info && info.pacientes && Array.isArray(info.pacientes)) { %>
                            <% info.pacientes.forEach(paciente => { %>
                              <tr
                                class="paciente-row"
                                data-paciente='<%- JSON.stringify(paciente) %>'
                              >
                                <td><%= paciente.documento_identificacion || 'No especificado' %></td>
                                <td><%= paciente.paciente_nombre_completo || 'No especificado' %></td>
                                <td><%= paciente.fecha_nacimiento || 'No especificado' %></td>
                                <td class="ubicacion"><%= paciente.direccion || 'No especificado' %></td>
                                <td><%= paciente.telefono || 'No especificado' %></td>
                                <td class="ubicacion"><%= paciente.correo_electronico || 'No especificado' %></td>
                                <td><%= paciente.persona_emergencia || 'No especificado' %></td>
                                <td><%= paciente.telefono_emergencia || 'No especificado' %></td>
                                <td><%= paciente.nacionalidad || 'No especificado' %></td>
                                <td><%= paciente.sexo || 'No especificado' %></td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="10" class="copias-no-data">No hay pacientes disponibles.</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
                <div class="bottom-spacer"></div>
              </div>
            </div>
          </div>
