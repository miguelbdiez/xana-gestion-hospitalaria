                    </div>
                    <div class="col-md-4">
                      <div class="input-group">
                        <span class="input-group-text">
                          <i class="fas fa-id-card"></i>
                        </span>
                        <input
                          type="text"
                          id="filtroDocumento"
                          class="form-control"
                          placeholder="Filtrar por documento"
                        />
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="input-group">
                        <span class="input-group-text">
                          <i class="fas fa-file-alt"></i>
                        </span>
                        <select id="filtroTipoDocumento" class="form-select">
                          <option value="">Todos los tipos</option>
                          <option value="cita_previa">Cita Previa</option>
                          <option value="consentimiento_paciente">Consentimiento Paciente</option>
                          <option value="registro_paciente">Registro Paciente</option>
                          <option value="justificante_paciente">Justificante Paciente</option>
                          <option value="receta_medica">Receta Médica</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <!-- Tabla -->
                  <div class="table-responsive">
                    <table
