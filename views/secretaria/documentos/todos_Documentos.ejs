                          <th>Nombre del Archivo</th>
                          <th>Documento Identificación</th>
                          <th>Nombre del Paciente</th>
                          <th>Fecha de Emisión</th>
                          <th>Tipo de Documento</th>
                        </tr>
                      </thead>
                      <tbody id="tablaDocumentosBody">
                        <% if (info && info.filasDocumentos && info.filasDocumentos.length > 0) { %>
                          <% info.filasDocumentos.forEach((documento, index) => { %>
                            <tr
                              class="documento-row"
                              data-id="<%= documento.id_documento %>"
                              data-tipo="<%= documento.tipo_documento %>"
                            >
                              <td id="nombreArchivo_<%= index %>">
                                <%= documento.nombre_archivo %>
                              </td>
                              <td id="documentoIdentificacion_<%= index %>">
                                <%= documento.documento_identificacion %>
                              </td>
                              <td id="nombrePaciente_<%= index %>">
                                <%= documento.nombre_paciente %>
                              </td>
                              <td id="fechaEmision_<%= index %>">
                                <%= documento.fecha_emision %>
                              </td>
                              <td id="tipoDocumento_<%= index %>">
                                <% if (documento.tipo_documento === 'cita_previa') { %> Cita Previa
                                <% } else if (documento.tipo_documento === 'consentimiento_paciente') { %> Consentimiento Paciente
                                <% } else if (documento.tipo_documento === 'registro_paciente') { %> Registro Paciente
                                <% } else if (documento.tipo_documento === 'justificante_paciente') { %> Justificante Paciente
                                <% } else if (documento.tipo_documento === 'receta_medica') { %> Receta Médica
                                <% } else { %> <%= documento.tipo_documento %> <% } %>
                              </td>
                            </tr>
                          <% }) %>
                        <% } else { %>
                          <tr>
                            <td colspan="5" class="text-center">No hay documentos disponibles</td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
                <div class="bottom-spacer"></div>
              </div>
            </div>
          </div>
