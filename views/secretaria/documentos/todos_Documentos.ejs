    <script>
      const documentos = <%- JSON.stringify(info.filasDocumentos) %>;

      // Función para filtrar la tabla
      function filtrarTabla() {
        const filtroNombre = document.getElementById("filtroNombre").value.toLowerCase();
        const filtroDocumento = document.getElementById("filtroDocumento").value.toLowerCase();
        const filtroTipoDocumento = document.getElementById("filtroTipoDocumento").value.toLowerCase();

        const tbody = document.getElementById("tablaDocumentosBody");
        const filas = tbody.getElementsByClassName("documento-row");

        for (let i = 0; i < filas.length; i++) {
          const nombrePaciente = (document.getElementById("nombrePaciente_" + i).textContent || "").toLowerCase();
          const documentoIdentificacion = (document.getElementById("documentoIdentificacion_" + i).textContent || "").toLowerCase();
          const tipoDocumento = (filas[i].getAttribute("data-tipo") || "").toLowerCase(); // Usar data-tipo

          const coincideNombre = nombrePaciente.includes(filtroNombre);
          const coincideDocumento = documentoIdentificacion.includes(filtroDocumento);
          const coincideTipo = filtroTipoDocumento === "" || tipoDocumento === filtroTipoDocumento;

          if (coincideNombre && coincideDocumento && coincideTipo) {
            filas[i].style.display = "";
          } else {
            filas[i].style.display = "none";
          }
        }
      }

      // Añadir eventos a los filtros
      document.getElementById("filtroNombre").addEventListener("input", function() {
        filtrarTabla();
      });

      document.getElementById("filtroDocumento").addEventListener("input", function() {
        filtrarTabla();
      });

      document.getElementById("filtroTipoDocumento").addEventListener("change", function() {
        filtrarTabla();
      });

      // Añadir evento de clic a las filas
      const filas = document.getElementsByClassName("documento-row");
      for (let i = 0; i < filas.length; i++) {
        filas[i].addEventListener("click", function() {
          const idDocumento = this.getAttribute("data-id");
          const index = Array.from(filas).indexOf(this);

          const nombreArchivo = document.getElementById("nombreArchivo_" + index).textContent;
          const documentoIdentificacion = document.getElementById("documentoIdentificacion_" + index).textContent;
          const nombrePaciente = document.getElementById("nombrePaciente_" + index).textContent;
          const fechaEmision = document.getElementById("fechaEmision_" + index).textContent;
          const tipoDocumento = document.getElementById("tipoDocumento_" + index).textContent;

          console.log("ID del documento seleccionado:", idDocumento);
          window.location.href = `/documentos/visorDocumento?idDocumento=${idDocumento}`;


        });
      }
    </script>
