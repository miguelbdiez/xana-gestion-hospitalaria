    <script>
      const canvas = document.getElementById("signature-pad");
      const ctx = canvas.getContext("2d");
      let drawing = false;

      canvas.addEventListener("mousedown", (e) => {
        drawing = true;
        ctx.beginPath();
        ctx.moveTo(e.offsetX, e.offsetY);
      });

      canvas.addEventListener("mousemove", (e) => {
        if (!drawing) return;
        ctx.lineTo(e.offsetX, e.offsetY);
        ctx.stroke();
      });

      canvas.addEventListener("mouseup", () => (drawing = false));

      function clearSignature() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }

      function getSignatureImageDataUrl() {
        return canvas.toDataURL("image/png");
      }
      document.addEventListener("DOMContentLoaded", () => {
        const formRegistroPaciente = document.getElementById(
          "formRegistroPaciente"
        );
        const documentoInput = document.getElementById("documento");
        const nombreInput = document.getElementById("nombre");
        const apellido1Input = document.getElementById("apellido1");
        const apellido2Input = document.getElementById("apellido2");
        const fechaNacimientoInput = document.getElementById("fechaNacimiento");
        const telefonoInput = document.getElementById("telefono");
        const sexoInput = document.getElementById("sexo");
        const direccionInput = document.getElementById("direccion");
        const correoInput = document.getElementById("correo");
        const personaEmergenciaInput =
          document.getElementById("personaEmergencia");
        const contactoEmergenciaInput =
          document.getElementById("contactoEmergencia");
        const nacionalidadInput = document.getElementById("nacionalidad");
        const parentescoRegistro=  document.getElementById("parentescoRegistro");

        let pdfId;


        document.getElementById("continuarBtn").addEventListener("click", async (e) => {
          e.preventDefault();

          // Recoger datos
          const campos = {
             documento_identificacion : documentoInput.value.trim(),
           nombreRegistro : nombreInput.value.trim(),
           apellido1Registro : apellido1Input.value.trim(),
           apellido2Registro : apellido2Input.value.trim(),
           fecha_nacimientoRegistro : fechaNacimientoInput.value,
           telefonoRegistro : telefonoInput.value.trim(),
           sexoRegistro : sexoInput.value,
           direccionRegistro : direccionInput.value.trim(),
           correo_electronicoRegistro : correoInput.value.trim(),
           persona_emergenciaRegistro :
            personaEmergenciaInput.value.trim(),
           contacto_emergenciaRegistro :
            contactoEmergenciaInput.value.trim(),
           nacionalidadRegistro : nacionalidadInput.value,
           parentescoRegistro:parentescoRegistro.value.trim(),
           firma : document
            .getElementById("signature-pad")
            .toDataURL("image/png"),

          }
         
         
          const body = {
              tipo_documento: "registro_paciente",
              campos: campos,
            };

            const response = await fetch("/secretaria/documentos/generarPdf", {
              method: "POST", 
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(body),
            });

            const data = await response.json();
            // Verificar si el DNI existe en la base de datos
            const errorMessage = document.getElementById("error-message");
            if (data.success) {
              // Si el DNI existe, cargar el PDF desde data.url
              errorMessage.style.display = "none";
              pdfId= data.pdfId

              const pdfIframe = document.getElementById("pdf");
              const pdfUrl = `/recuperarPDF?id=${data.pdfId}`; // Construimos la URL correcta: /recuperarPDF?id=4
              pdfIframe.src = pdfUrl; // Asignamos la URL
              // Mostrar el visor
              document.getElementById("continuarBtn").disabled = true;
              document.getElementById("pdfView").style.display = "block";

          
              return;
            } else {
              errorMessage.textContent =
                data.message ||
                "El documento de identificación del usuario no existe";
              errorMessage.style.display = "block";
            }
        });
      


        document.getElementById("enviarBtn").addEventListener("click", async (e) => {
          e.preventDefault();
          

          const documento_identificacion = documentoInput.value.trim();
          const nombreRegistro = nombreInput.value.trim();
          const apellido1Registro = apellido1Input.value.trim();
          const apellido2Registro = apellido2Input.value.trim();
          const fecha_nacimientoRegistro = fechaNacimientoInput.value;
          const telefonoRegistro = telefonoInput.value.trim();
          const sexoRegistro = sexoInput.value;
          const direccionRegistro = direccionInput.value.trim();
          const correo_electronicoRegistro = correoInput.value.trim();
          const persona_emergenciaRegistro =
            personaEmergenciaInput.value.trim() +" "
           parentescoRegistro.value.trim();

          const contacto_emergenciaRegistro =
            contactoEmergenciaInput.value.trim();
          const nacionalidadRegistro = nacionalidadInput.value;
          

          
         
          // Validaciones
          if (
            !documento_identificacion ||
            !nombreRegistro ||
            !apellido1Registro ||
            !fecha_nacimientoRegistro ||
            !telefonoRegistro ||
            !sexoRegistro ||
            !direccionRegistro ||
            !correo_electronicoRegistro ||
            !persona_emergenciaRegistro ||
            !contacto_emergenciaRegistro ||
            !nacionalidadRegistro
          ) {
            alert("Por favor, complete todos los campos obligatorios.");
            return;
          }

          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(correo_electronicoRegistro)) {
            alert("Por favor, ingrese un correo electrónico válido.");
            return;
          }

          const phoneRegex = /^[0-9]{9,13}$/;
          if (
            !phoneRegex.test(telefonoRegistro) ||
            !phoneRegex.test(contacto_emergenciaRegistro)
          ) {
            alert("Los números de teléfono deben tener entre 9 y 13 dígitos.");
            return;
          }

          const documento_identificacionEnvio = documentoInput.value.trim()
          const nombre_paciente= nombreInput.value.trim()+" "+ apellido1Input.value.trim()+" "+ apellido2Input.value.trim()
          const pdfIdEnvio = pdfId
           


          const camposEnvio = 
            documentoInput.value.trim()+"?"+
            nombreInput.value.trim()+"?"+
            apellido1Input.value.trim()+"?"+
            apellido2Input.value.trim()+"?"+
            fechaNacimientoInput.value+"?"+
            telefonoInput.value.trim()+"?"+
            sexoInput.value+"?"+
            direccionInput.value.trim()+"?"+
            correoInput.value.trim()+"?"+   
            personaEmergenciaInput.value.trim()+"?"+        
            contactoEmergenciaInput.value.trim()+"?"+
            nacionalidadInput.value+"?"+
            parentescoRegistro.value.trim()+"?"+
            document
            .getElementById("signature-pad")
            .toDataURL("image/png");
          

          try {
            const response = await fetch("/secretariaEnviarBandejaDocumentos", {
              method: "POST",
              body: JSON.stringify({
                camposEnvio : camposEnvio,
                documento_identificacion: documento_identificacionEnvio,
                nombre_paciente: nombre_paciente,
                pdfId: pdfIdEnvio,
                tipo_doc: "registro_paciente"

              }),
              headers: {
                "Content-Type": "application/json",
              },
            });

            const data = await response.json();

            if (data.success) {
              alert("La solicitud se envio con exito ,por favor, espere a ser atendido");
              window.location.reload()
              }
        } catch (error) {
            console.error("Error al registrar el paciente:", error);
            alert("Error al conectar con el servidor.");
          }
        });
      


      document
        .getElementById("descartarBtn")
        .addEventListener("click", async () => {

          const response = await fetch("/secretaria/documentos/accionPdf", {
              method: "POST", // Cambiamos a POST para enviar el cuerpo
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({accion: "descartar", pdfId:pdfId}),
            });

            const data = await response.json();
            if(data.success){
              document.getElementById("continuarBtn").disabled = false;  
              document.getElementById("pdfView").style.display = "none";
            }

          
        })
      });
    </script>

  

  
