    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>

    <!-- Scripts necesarios -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const formRegistroPaciente = document.getElementById("formRegistroPaciente");
        const documentoInput = document.getElementById("documento");
        const nombreInput = document.getElementById("nombre");
        const apellido1Input = document.getElementById("apellido1");
        const apellido2Input = document.getElementById("apellido2");
        const fechaNacimientoInput = document.getElementById("fechaNacimiento");
        const telefonoInput = document.getElementById("telefono");
        const sexoInput = document.getElementById("sexo");
        const direccionInput = document.getElementById("direccion");
        const correoInput = document.getElementById("correo");
        const personaEmergenciaInput = document.getElementById("personaEmergencia");
        const contactoEmergenciaInput = document.getElementById("contactoEmergencia");
        const nacionalidadInput = document.getElementById("nacionalidad");

        const ingresarPacienteBtn = document.getElementById("ingresarPacienteBtn"
        );
        const mensajeNoExistente = document.getElementById("mensajeNoExistente");

        document
          .getElementById("btnAutorrellenar")
          .addEventListener("click", async function () {
            const documento = documentoInput.value;

            try {
              const response = await fetch(
                `/verificarExistePaciente?documento=${documento}`
              );
              const data = await response.json();

              if (data.success === true) {
                console.log(data.paciente.nacionalidad);

                nombreInput.value = data.paciente.nombre;
                apellido1Input.value = data.paciente.apellido1;
                apellido2Input.value = data.paciente.apellido2;
                fechaNacimientoInput.value = data.paciente.fechaNacimiento;
                telefonoInput.value = data.paciente.telefono;
                sexoInput.value = data.paciente.sexo;
                direccionInput.value = data.paciente.direccion;
                correoInput.value = data.paciente.correo;
                personaEmergenciaInput.value = data.paciente.personaEmergencia;
                contactoEmergenciaInput.value =
                  data.paciente.contactoEmergencia;
                nacionalidadInput.value = data.paciente.nacionalidad;

                // Habilitar el botón de "Registrar Paciente"
                ingresarPacienteBtn.disabled = false;
                mensajeNoExistente.style.display = "none";
              } else {
                // Si no existe, mostrar el mensaje y habilitar el botón para registro
                mensajeNoExistente.style.display = "block";
              }
            } catch (error) {
              console.error("Error al verificar el paciente:", error);
              alert("Hubo un error al verificar el paciente.");
            }
          });
        document
          .getElementById("btnRegistrarPaciente")
          .addEventListener("click", async function () {
            window.location.href = "/secretaria/registrarPaciente";
          });

        document
          .getElementById("especialidad")
          .addEventListener("change", async function (event) {
            console.log("cambia", event.target.value);
            const especialidadSelecionada = event.target.value;

            try {
              const response = await fetch(
                `/cargarMedicosYCamas?especialidad=${especialidadSelecionada}`
              );
              const data = await response.json();
              console.log(data);
              if (data.success) {
                if (data.message) {
                  mensajeTexto.textContent = data.message;
                  mensaje.className = "mensaje-success";
                  mensaje.style.display = "block";
                  cerrarMensaje.onclick = () => {
                    mensaje.style.display = "none";
                  };
                }

                const cama = document.getElementById("cama");
                cama.innerHTML = ""; // Limpia todas las opciones previas

                // Agregar opciones de cama_id al select
                data.cama_id.forEach((op) => {
                  const option = document.createElement("option");
                  option.value = op.cama_id;
                  option.textContent = op.cama_id;
                  cama.appendChild(option);
                });

                const doctorSelect = document.getElementById("doctor");
                doctorSelect.innerHTML = ""; // Limpia todas las opciones previas

                // Agregar opciones de médicos al select
                data.medicos.forEach((medico) => {
                  const option = document.createElement("option");
                  option.value = medico.id;
                  option.textContent = medico.medico_nombre_completo;
                  doctorSelect.appendChild(option);
                });
              } else {
                if (data.message) {
                  mensajeTexto.textContent = data.message;
                  mensaje.className = "mensaje-error";
                  mensaje.style.display = "block";
                  cerrarMensaje.onclick = () => {
                    mensaje.style.display = "none";
                  };
                }
              }
            } catch {}
          });

        document
          .getElementById("ingresarPacienteBtn")
          .addEventListener("click", async function () {
            const fecha_nacimiento =
              document.getElementById("fechaNacimiento").value;

            const sexo = document.getElementById("sexo").value;

            const direccion = document.getElementById("direccion").value;

            const telefono = document.getElementById("telefono").value;

            const correo_electronico = document.getElementById("correo").value;

            const persona_emergencia =
              document.getElementById("personaEmergencia").value;

            const contacto_emergencia =
              document.getElementById("contactoEmergencia").value;

            const nacionalidad = document.getElementById("nacionalidad").value;

            const documento_identificacion =
              document.getElementById("documento").value;

            const nombre = document.getElementById("nombre").value;

            const apellido1 = document.getElementById("apellido1").value;

            const apellido2 = document.getElementById("apellido2").value;

            const especialidad = document.getElementById("especialidad").value;

            const cama_id = document.getElementById("cama").value;

            const doctor_id = document.getElementById("doctor").value;

            const motivoIngreso =
              document.getElementById("motivoIngreso").value;

            try {
              const response = await fetch("/ingresarPaciente", {
                method: "POST",
                body: JSON.stringify({
                  documento_identificacion,
                  nombre,
                  apellido1,
                  apellido2,
                  especialidad,
                  cama_id,
                  doctor_id,
                  motivoIngreso,
                  fecha_nacimiento,
                  sexo,
                  direccion,
                  telefono,
                  correo_electronico,
                  persona_emergencia,
                  contacto_emergencia,
                  nacionalidad,
                }),
                headers: {
                  "Content-Type": "application/json",
                },
              });

              if (response.ok) {
                const data = await response.json();
                if (data.success) {
                  mensajeTexto.textContent = data.message;
                  mensaje.className = "mensaje-success";
                  mensaje.style.display = "block";
                  cerrarMensaje.onclick = () => {
                    mensaje.style.display = "none";
                    window.location.href = "/secretaria/ingresoPaciente";
                  };
                } else {
                  mensajeTexto.textContent = data.message;
                  mensaje.className = "mensaje-error";
                  mensaje.style.display = "block";
                  cerrarMensaje.onclick = () => {
                    mensaje.style.display = "none";
                  };
                }

                nombre.value = "";
                apellido1.value = "";
                apellido2.value = "";
                fechaNacimiento.value = "";
                telefono.value = "";
                sexo.value = "";
                direccion.value = "";
                correo.value = "";
                personaEmergencia.value = "";
                contactoEmergencia.value = "";
                nacionalidad.value = "";
              } else {
                alert("Hubo un problema al ingresar el paciente.");
              }
            } catch (error) {
              console.error("Error al registrar el paciente:", error);
              alert("Error al registrar el paciente.");
            }
          });
      });
    </script>

  </body>
