        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario">Secretaría</h1>
            <div class="d-flex align-items-center">
              <a id="btnVolverLista" class="call-btn btn-img me-2" href="/secretaria/PacientesIngresados/ingresadosHome">
                <img
                  src="/imagenes/volver.png"
                  alt="Volver"
                  style="width: 24px; height: 24px"
                />
              </a>
              <h2 class="m-0">Ingresar Paciente</h2>
            </div>
          </div>
          <div class="ingreso-section">
            <div class="scrollable-content">
              <div class="container mt-3">
                <h2 class="mb-4">Ingresar Paciente</h2>
                <div class="card shadow ingreso-card p-4">
                  <!-- Documento de Identificación -->
                  <div class="mb-3 d-flex align-items-center">
                    <label for="documento" class="form-label me-2" style="min-width: 200px">Documento de Identificación</label>
                    <input
                      type="text"
                      class="form-control me-2"
                      id="documento"
                      name="documento"
                      required
                    />
                    <button type="button" class="btn btn-sm" id="btnAutorrellenar">
                      Autorrellenar
                    </button>
                  </div>
        
                  <!-- Mensaje en caso de que el paciente no exista -->
                  <div id="mensajeNoExistente" class="mb-3" style="display: none">
                    <p class="text-danger">
                      El paciente con ese documento no existe. Será necesario registrar a esta persona en la base de datos del hospital para poder proceder con el ingreso
                    </p>
                    <button type="button" class="btn btn-sm btn-warning" id="btnRegistrarPaciente">
                      Registrar Paciente
                    </button>
                  </div>
        
                  <!-- Cuadro de Datos del Paciente -->
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label for="nombre" class="form-label">Nombre</label>
                      <input
                        type="text"
                        class="form-control"
                        id="nombre"
                        name="nombre"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="primerApellido" class="form-label">Primer Apellido</label>
                      <input
                        type="text"
                        class="form-control"
                        id="apellido1"
                        name="primerApellido"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="segundoApellido" class="form-label">Segundo Apellido</label>
                      <input
                        type="text"
                        class="form-control"
                        id="apellido2"
                        name="segundoApellido"
                        disabled="true"
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="fechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                      <input
                        type="date"
                        class="form-control"
                        id="fechaNacimiento"
                        name="fechaNacimiento"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="telefono" class="form-label">Teléfono de Contacto</label>
                      <input
                        type="tel"
                        class="form-control"
                        id="telefono"
                        name="telefono"
                        pattern="[0-9]{9,13}"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="sexo" class="form-label">Sexo</label>
                      <input
                        type="text"
                        class="form-control"
                        id="sexo"
                        name="sexo"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="direccion" class="form-label">Dirección</label>
                      <input
                        type="text"
                        class="form-control ubicacion"
                        id="direccion"
                        name="direccion"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="correo" class="form-label">Correo Electrónico</label>
                      <input
                        type="email"
                        class="form-control ubicacion"
                        id="correo"
                        name="correo"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="personaEmergencia" class="form-label">Persona de Emergencia</label>
                      <input
                        type="text"
                        class="form-control"
                        id="personaEmergencia"
                        name="personaEmergencia"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="contactoEmergencia" class="form-label">Contacto de Emergencia</label>
                      <input
                        type="tel"
                        class="form-control"
                        id="contactoEmergencia"
                        name="contactoEmergencia"
                        pattern="[0-9]{9,13}"
                        disabled="true"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label for="nacionalidad" class="form-label">Nacionalidad</label>
                      <input
                        type="text"
                        class="form-control"
                        id="nacionalidad"
                        name="nacionalidad"
                        disabled="true"
                        required
                      />
                    </div>
        
                    <!-- Motivo de Ingreso -->
                    <div class="col-12">
                      <label for="motivoIngreso" class="form-label">Motivo de Ingreso</label>
                      <textarea
                        class="form-control ubicacion"
                        id="motivoIngreso"
                        name="motivoIngreso"
                        rows="8"
                      ></textarea>
                    </div>
        
                    <!-- Departamento/Especialidad y Cama Asignada -->
                    <div class="col-md-6">
                      <label for="especialidad" class="form-label">Departamento/Especialidad</label>
                      <select
                        class="form-select"
                        id="especialidad"
                        name="especialidades"
                      >
                        <option value="" disabled selected>Selecciona una especialidad</option>
                        <% info.especialidades.forEach(opcion => { %>
                        <option value="<%= opcion.especialidad %>"><%= opcion.especialidad %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label for="cama" class="form-label">Cama Asignada</label>
                      <select
                        class="form-select"
                        id="cama"
                        name="cama"
                      >
                        <option value="" selected disabled>Seleccione una Especialidad</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label for="doctor" class="form-label">Doctor Asignado</label>
                      <select
                        class="form-select"
                        id="doctor"
                        name="doctor"
                      >
                        <option value="" selected disabled>Seleccione una Especialidad</option>
                      </select>
                    </div>
                  </div>
        
                  <div id="error-message" style="display: none; color: red"></div>
        
                  <div class="confirm-section">
                    <button class="btn btn-sm" id="ingresarPacienteBtn" disabled="true">
                      Ingresar
                    </button>
                  </div>
        
                  <div
                    id="mensaje"
                    style="
                      display: none;
                      position: fixed;
                      top: 50%;
                      left: 50%;
                      transform: translate(-50%, -50%);
                      padding: 20px;
                      border-radius: 10px;
                      color: #000;
                      font-size: 18px;
                      text-align: center;
                      z-index: 1000;
                      width: 300px;
                      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                    "
                  >
                    <span
                      id="mensajeTexto"
                      style="display: block; margin-bottom: 20px"
                    ></span>
                    <button
                      id="cerrarMensaje"
                      style="
                        display: block;
                        margin: 0 auto;
                        padding: 10px 20px;
                        font-size: 16px;
                        border: none;
                        border-radius: 5px;
                        cursor: pointer;
                      "
                    >
                      Aceptar
                    </button>
                  </div>
                </div>
                <div class="bottom-spacer"></div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalLlamando"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name">Llamando</p>
                <p
                  data-Persona-a-la-que-se-llama-id=""
                  id="persona_a_la_que_se_llama"
                ></p>
              </div>
            </div>
            <div class="footer">
              <!-- Este bloque contiene el nombre y se coloca encima del segundo footer -->

              <!-- Segundo bloque de footer con los botones -->
              <button
                class="bouton raccrocher"
                id="btnFinalizarLlamando"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
