    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>


    <script>
      document.addEventListener("DOMContentLoaded", async () => {
        const searchButton = document.getElementById("search-btn");
        const resultadoDiv = document.getElementById("resultadoMedicamento");

        searchButton.addEventListener("click", async () => {
          resultadoDiv.innerHTML = "";
          const fecha = document.getElementById("fecha")?.value.trim() || "";
             const nregistro = document.getElementById("nregistro")?.value.trim() || "";

  // Validación básica
            if (!fecha) {
                resultadoDiv.innerHTML =
                '<p class="error">Por favor, introduce una fecha en formato dd/mm/yyyy.</p>';
                resultadoDiv.style.display = "block";
                return;
            }

  
    // Construir la URL con los parámetros
    

        try {
            let url = `https://cima.aemps.es/cima/rest/registroCambios`;

            let params = [];
            if (fecha) {
            params.push(`fecha=${fecha}`);
            }
            if (nregistro) {
            params.push(`nregistro=${nregistro}`);
            }
            if (params.length > 0) {
            url += `?${params.join("&")}`;
            }          
            const response = await fetch(url);
            if (!response.ok) {
              throw new Error(`Error HTTP: ${response.status}`);
            }
            const data = await response.json();
            console.log(data);

            if (
              !data ||
              (Array.isArray(data.resultados) && data.resultados.length === 0)
            ) {
              resultadoDiv.innerHTML =
                '<p class="error">No se encontraron medicamentos con estas especificaciones.</p>';
              resultadoDiv.style.display = "block";
              return;
            }

            let html = `
      <h3>Cambios en Registros </h3>
      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Nº Registro</th>
              <th>Fecha</th>
              <th>Tipo de Cambio</th>
              <th>Cambios Realizados</th>
            </tr>
          </thead>
          <tbody>
    `;
    data.resultados.forEach((cambio) => {
      const fechaLegible = new Date(cambio.fecha).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
      });
      // Interpretar tipoCambio
      let tipoCambioTexto = "No disponible";
      switch (cambio.tipoCambio) {
        case 1:
          tipoCambioTexto = "Nuevo";
          break;
        case 2:
          tipoCambioTexto = "Baja";
          break;
        case 3:
          tipoCambioTexto = "Modificado";
          break;
      }
      html += `
        <tr>
          <td>${cambio.nregistro || "No disponible"}</td>
          <td>${fechaLegible}</td>
          <td>${tipoCambioTexto}</td>
          <td>${
        cambio.cambio && cambio.cambio.length > 0
          ? cambio.cambio
              .map((c) => {
                switch(c) {
                  case "estado": return "Estado de autorización";
                  case "comerc": return "Estado de comercialización";
                  case "prosp": return "Prospecto";
                  case "ft": return "Ficha técnica";
                  case "psum": return "Problemas de suministro";
                  case "notasSeguridad": return "Notas de seguridad";
                  case "matinf": return "Materiales informativos";
                  case "otros": return "Otros cambios";
                  default: return c;
                }
              })
              .join(", ")
          : "Ninguno"
      }</td>
      `;
    });
    html += `
          </tbody>
        </table>
      </div>
    `;

    resultadoDiv.innerHTML = html;
    resultadoDiv.style.display = "block";
          } catch (error) {
            resultadoDiv.innerHTML = `<p class="error">Error al consultar la API: ${error.message}</p>`;
            resultadoDiv.style.display = "block";
          }
        });
      });
    </script>
  </body>
</html>
