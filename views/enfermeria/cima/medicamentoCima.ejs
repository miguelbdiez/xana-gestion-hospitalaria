                <span class="btn-text">Colgar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>

    <script>
      document
        .getElementById("buscarBtn")
        .addEventListener("click", async () => {
          const nregistro = document.getElementById("numeroDeRegistro").value.trim();
          const cn = document.getElementById("codigoNacional").value.trim();
          const resultadoDiv = document.getElementById("resultadoMedicamento");
         
          if (!nregistro && !cn) {
              alert("Por favor, introduce un número de registro o un código nacional");
              return;
          }
          let url;
          // Determinar qué endpoint usar según el campo rellenado
          if (nregistro) {
              url = `https://cima.aemps.es/cima/rest/medicamento?nregistro=${nregistro}`;
          } else if (cn) {
              url = `https://cima.aemps.es/cima/rest/medicamento?cn=${cn}`;
          }

         

          try {
            resultadoDiv.innerHTML = "Buscando...";
            const response = await fetch(url);
            if (!response.ok) {
              throw new Error(`Error HTTP: ${response.status}`);
              resultadoDiv.innerHTML = response.status;

            }
            const data = await response.json();
            console.log(data);

            // Verificar si hay datos válidos
            if (
              !data ||
              (Array.isArray(data.resultados) && data.resultados.length === 0)
            ) {
              resultadoDiv.innerHTML =
                '<p class="error">No se encontraron medicamentos con ese número de registro.</p>';
              resultadoDiv.style.display = "block";
              return;
            }

            // Si data es un array en resultados, tomamos el primero; si no, usamos data directamente
            const medicamento =
              data.resultados && data.resultados.length > 0
                ? data.resultados[0]
                : data;
                resultadoMedicamento.innerHTML = `
  <div class="table-responsive">
    <table class="table table-bordered table-custom">
      <thead>
        <tr>
          <th colspan="2">${medicamento.nombre || "Nombre no disponible"}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="title-col">Número de Registro</td>
          <td>${medicamento.nregistro || "No disponible"}</td>
        </tr>
        <tr>
          <td class="title-col">Laboratorio Titular</td>
          <td>${medicamento.labtitular || "No disponible"}</td>
        </tr>
        <tr>
          <td class="title-col">Laboratorio Comercializador</td>
          <td>${medicamento.labcomercializador || "No disponible"}</td>
        </tr>
        <tr>
          <td class="title-col">Estado</td>
          <td>${
            medicamento.estado && medicamento.estado.aut
              ? new Date(medicamento.estado.aut).toLocaleDateString("es-ES")
              : "Fecha no disponible"
          } - ${
  typeof medicamento.comerc === "boolean"
    ? medicamento.comerc
      ? "Comercializado"
      : "No comercializado"
    : "Estado de comercialización no disponible"
}</td>
        </tr>
        <tr>
          <td class="title-col">Características</td>
          <td>
            <ul class="list-unstyled">
              <li>Requiere receta: ${
                typeof medicamento.receta === "boolean"
                  ? medicamento.receta
                    ? "Sí"
                    : "No"
                  : "No disponible"
              }</li>
              <li>Genérico: ${
                typeof medicamento.generico === "boolean"
                  ? medicamento.generico
                    ? "Sí"
                    : "No"
                  : "No disponible"
              }</li>
              <li>Afecta a la conducción: ${
                typeof medicamento.conduc === "boolean"
                  ? medicamento.conduc
                    ? "Sí"
                    : "No"
                  : "No disponible"
              }</li>
              <li>Triángulo de advertencia: ${
                typeof medicamento.triangulo === "boolean"
                  ? medicamento.triangulo
                    ? "Sí"
                    : "No"
                  : "No disponible"
              }</li>
              <li>Medicamento huérfano: ${
                typeof medicamento.huerfano === "boolean"
                  ? medicamento.huerfano
                    ? "Sí"
                    : "No"
                  : "No disponible"
              }</li>
              <li>Biosimilar: ${
                typeof medicamento.biosimilar === "boolean"
                  ? medicamento.biosimilar
                    ? "Sí"
                    : "No"
                  : "No disponible"
              }</li>
              <li>No sustituible: ${
                medicamento.nosustituible && medicamento.nosustituible.id !== undefined
                  ? medicamento.nosustituible.id !== 0
                    ? "Sí"
                    : "No"
                  : "No disponible"
              } (${medicamento.nosustituible?.nombre || "N/A"})</li>
              <li>Problemas de suministro: ${
                typeof medicamento.psum === "boolean"
                  ? medicamento.psum
                    ? "Sí"
                    : "No"
                  : "No disponible"
              }</li>
            </ul>
          </td>
        </tr>
        <tr>
          <td class="title-col">Principios Activos</td>
          <td>${
            medicamento.principiosActivos && medicamento.principiosActivos.length > 0
              ? `<ul class="list-unstyled">${medicamento.principiosActivos
                  .map(
                    (pa) =>
                      `<li>${pa.nombre} - ${pa.cantidad} ${pa.unidad}</li>`
                  )
                  .join("")}</ul>`
              : "No hay principios activos disponibles"
          }</td>
        </tr>
        <tr>
          <td class="title-col">Excipientes</td>
          <td>${
            medicamento.excipientes && medicamento.excipientes.length > 0
              ? `<ul class="list-unstyled">${medicamento.excipientes
                  .map(
                    (exc) =>
                      `<li>${exc.nombre} - ${exc.cantidad} ${exc.unidad}</li>`
                  )
                  .join("")}</ul>`
              : "No hay excipientes disponibles"
          }</td>
        </tr>
        <tr>
          <td class="title-col">Vía de Administración</td>
          <td>${
            medicamento.viasAdministracion &&
            medicamento.viasAdministracion.length > 0
              ? medicamento.viasAdministracion.map((va) => va.nombre).join(", ")
              : "No hay vías de administración disponibles"
          }</td>
        </tr>
        <tr>
          <td class="title-col">Forma Farmacéutica</td>
          <td>${
            medicamento.formaFarmaceutica && medicamento.formaFarmaceutica.nombre
              ? medicamento.formaFarmaceutica.nombre
              : "No disponible"
          }</td>
        </tr>
        <tr>
          <td class="title-col">Presentaciones</td>
          <td>${
            medicamento.presentaciones && medicamento.presentaciones.length > 0
              ? `<ul class="list-unstyled">${medicamento.presentaciones
                  .map(
                    (p) =>
                      `<li>${p.nombre} (CN: ${p.cn}) - ${
                        p.comerc ? "Comercializado" : "No comercializado"
                      }</li>`
                  )
                  .join("")}</ul>`
              : "No hay presentaciones disponibles"
          }</td>
        </tr>
        <tr>
          <td class="title-col">Códigos ATC</td>
          <td>${
            medicamento.atcs && medicamento.atcs.length > 0
              ? `<ul class="list-unstyled">${medicamento.atcs
                  .map(
                    (atc) =>
                      `<li>${atc.codigo}: ${atc.nombre} (Nivel ${atc.nivel})</li>`
                  )
                  .join("")}</ul>`
              : "No hay códigos ATC disponibles"
          }</td>
        </tr>
        <tr>
          <td class="title-col">Documentos</td>
          <td>${
            medicamento.docs && medicamento.docs.length > 0
              ? `<ul class="list-unstyled">${medicamento.docs
                  .map(
                    (doc) =>
                      `<li><a href="${doc.urlHtml || "#"}" target="_blank">${
                        doc.tipo === 1 ? "Ficha Técnica" : "Prospecto"
                      }</a> (Actualizado: ${
                        doc.fecha
                          ? new Date(doc.fecha).toLocaleDateString("es-ES")
                          : "Fecha no disponible"
                      })</li>`
                  )
                  .join("")}</ul>`
              : "No hay documentos disponibles"
          }</td>
        </tr>
        <tr>
          <td class="title-col">Fotos</td>
          <td>${
            medicamento.fotos && medicamento.fotos.length > 0
              ? `<div class="fotos-container">${medicamento.fotos
                  .map(
                    (foto) =>
                      `<img src="${foto.url || "#"}" alt="${
                        foto.tipo || "Foto"
                      }" class="medicamento-foto">`
                  )
                  .join("")}</div>`
              : "No hay fotos disponibles"
          }</td>
        </tr>
      </tbody>
    </table>
  </div>
`;
resultadoMedicamento.style.display = "block";
          } catch (error) {
            resultadoDiv.innerHTML = `<p class="error">Error al consultar la API: ${error.message}</p>`;
            resultadoDiv.style.display = "block";
          }
        });
    </script>

  </body>
</html>
