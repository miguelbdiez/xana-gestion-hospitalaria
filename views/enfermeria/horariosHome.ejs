                    <li><a href="/comunicacion/chat" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Chat</a></li>
                    <li><a href="/comunicacion/contactos" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Contactos</a></li>
                    <li><a href="/comunicacion/mail/bandeja" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Mail</a></li>
                  </ul>
                </div>
              </li>
              <li class="border-top my-3"></li>        
              <li class="mb-1">
                <div class="d-flex align-items-center">
                  <a href="/enfermeria/Horarios" class="btn d-inline-flex align-items-center rounded border-0 text-decoration-none text-primary fw-semibold">Horarios</a>
                </div>
              </li>
              <li class="border-top my-3"></li>        

            </ul>
          </div>
        </div>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario">Enfermería</h1>
            <div class="d-flex align-items-center">
              <a id="btnVolverLista" class="call-btn btn-img me-2" href="/home">
                <img
                  src="/imagenes/volver.png"
                  alt="Volver"
                  style="width: 24px; height: 24px"
                />
              </a>
              <h2 class="m-0">Horarios Home</h2>
            </div>
           
          </div>
          <div class="album py-5 bg-body-tertiary">
            <div class="container">
              <div class="header">
                <div class="header-top">
                  <h1 class="especialidad-title"id ="tituloEspecialidad"><%= info.especialidad %></h1>
                  <span class="fecha-actual"><%= info.mes %> <%= info.año %></span>
                </div>
                <div class="trabajadores">
                  <h3>Plantilla</h3>
                  <p class="lista-trabajadores">
                    <% info.nombresPlantilla.forEach(trabajador => { %>
                      <%= trabajador.nombre_completo %>,
                    <% }) %>
                    </p>
                </div>
              </div>
            
              <!-- Sección del calendario -->
              <div class="calendario">
                <div class="calendario-header">
                  <h2 id="titulo-calendario">Horario de <%= info.mes %> <%= info.año %></h2>
                  <select class="selector-mes" id="selector-mes">
                    <% info.meses.forEach(mes => { %>
                      <option value="<%= mes %>" <%= mes === info.mes ? 'selected' : '' %>><%= mes %></option>
                    <% }) %>
                  </select>
                  <select class="selector-año" id="selector-año">
                    <% const años = [2024, 2025, 2026, 2027, 2028, 2029, 2030]; %> <!-- Ajusta los años según necesites -->
                    <% años.forEach(año => { %>
                      <option value="<%= año %>" <%= año === info.año ? 'selected' : '' %>><%= año %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="calendario-grid">
                  <!-- Días de la semana -->
                  <div class="dia-semana">Lun</div>
                  <div class="dia-semana">Mar</div>
                  <div class="dia-semana">Mié</div>
                  <div class="dia-semana">Jue</div>
                  <div class="dia-semana">Vie</div>
                  <div class="dia-semana">Sáb</div>
                  <div class="dia-semana">Dom</div>
              
                  <!-- Espacios vacíos antes del día 1 -->
                  <% for(let i = 0; i < info.offset; i++) { %>
                    <div class="dia-vacio"></div>
                  <% } %>
              
                  <!-- Días del mes -->
                  <% for(let dia = 1; dia <= info.diasEnMes; dia++) { %>
                    <div class="dia">
                      <div class="numero-dia"><%= dia %></div>
              
                      <!-- Turno Mañana -->
                      <div class="turno mañana <%= info.id_usuario && info.horarios.some(h => h.dia === dia && h.turno === 'Mañana' && h.id === info.id_usuario) ? 'resaltado' : '' %>"
                           data-bs-toggle="modal" data-bs-target="#turnoModal"
                           data-info='<%= JSON.stringify(info.horarios.filter(h => h.dia === dia && h.turno === "Mañana" && h.mes === info.mes && h.año === info.año).length > 0 ? info.horarios.filter(h => h.dia === dia && h.turno === "Mañana" && h.mes === info.mes && h.año === info.año) : [{ turno: "Mañana", dia: dia, nombre_trabajador: "-", id: null }]) %>'>
                        <% 
                          const mañana = info.horarios.filter(h => h.dia === dia && h.turno === 'Mañana' && h.mes === info.mes && h.año === info.año); 
                          if (mañana.length > 0) { 
                            mañana.forEach(trabajador => { %>
                              <div><%= trabajador.nombre_trabajador %></div>
                            <% });
                          } else { %>
                            <div>-</div>
                          <% } %>
                      </div>
              
                      <!-- Turno Tarde -->
                      <div class="turno tarde <%= info.id_usuario && info.horarios.some(h => h.dia === dia && h.turno === 'Tarde' && h.id === info.id_usuario) ? 'resaltado' : '' %>"
                           data-bs-toggle="modal" data-bs-target="#turnoModal"
                           data-info='<%= JSON.stringify(info.horarios.filter(h => h.dia === dia && h.turno === "Tarde" && h.mes === info.mes && h.año === info.año).length > 0 ? info.horarios.filter(h => h.dia === dia && h.turno === "Tarde" && h.mes === info.mes && h.año === info.año) : [{ turno: "Tarde", dia: dia, nombre_trabajador: "-", id: null }]) %>'>
                        <% 
                          const tarde = info.horarios.filter(h => h.dia === dia && h.turno === 'Tarde' && h.mes === info.mes && h.año === info.año); 
                          if (tarde.length > 0) { 
                            tarde.forEach(trabajador => { %>
                              <div><%= trabajador.nombre_trabajador %></div>
                            <% });
                          } else { %>
                            <div>-</div>
                          <% } %>
                      </div>
              
                      <!-- Turno Noche -->
                      <div class="turno noche <%= info.id_usuario && info.horarios.some(h => h.dia === dia && h.turno === 'Noche' && h.id === info.id_usuario) ? 'resaltado' : '' %>"
                           data-bs-toggle="modal" data-bs-target="#turnoModal"
                           data-info='<%= JSON.stringify(info.horarios.filter(h => h.dia === dia && h.turno === "Noche" && h.mes === info.mes && h.año === info.año).length > 0 ? info.horarios.filter(h => h.dia === dia && h.turno === "Noche" && h.mes === info.mes && h.año === info.año) : [{ turno: "Noche", dia: dia, nombre_trabajador: "-", id: null }]) %>'>
                        <% 
                          const noche = info.horarios.filter(h => h.dia === dia && h.turno === 'Noche' && h.mes === info.mes && h.año === info.año); 
                          if (noche.length > 0) { 
                            noche.forEach(trabajador => { %>
                              <div><%= trabajador.nombre_trabajador %></div>
                            <% });
                          } else { %>
                            <div>-</div>
                          <% } %>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
            
              <div class="eventos">
                  <!-- Sección de Solicitudes -->
                <div class="solicitudes">
                    <h2>Solicitudes de Cambio Recibidas</h2>
                  <% if (info.eventos.solicitudesRecibidas && info.eventos.solicitudesRecibidas.length > 0) { %>
                      <div class="solicitudes-container">
                          <% info.eventos.solicitudesRecibidas.forEach(solicitud => { %>
                              <div class="solicitud-card" 
                                  data-id="<%= solicitud.id_registro %>"
                                  data-id-turno-solicitado="<%= solicitud.id_turno_solicitado %>"
                                  data-id-turno-a-cambiar="<%= solicitud.id_turno_a_cambiar %>"
                                  data-id-empleado-receptor="<%= solicitud.id_empleado_receptor %>"
                                  data-id-empleado-solicitante="<%= solicitud.id_empleado_solicitante %>"
                                  data-nombre-receptor="<%= solicitud.nombre_receptor %>"
                                  data-fecha-evento="<%= solicitud.fecha_evento %>">
                                  <div class="solicitud-header">
                                      <span class="solicitante-nombre"><%= solicitud.nombre_solicitante %></span>
                                  </div>
                                  <div class="solicitud-content">
                                      <p><strong>Solicita:</strong> <%= solicitud.descripcion_turno_solicitado %></p>
                                      <p><strong>Ofrece:</strong> <%= solicitud.descripcion_turno_a_cambiar %></p>
                                      <p class="comentario"><strong>Comentario:</strong> <%= solicitud.comentario || 'Sin comentarios' %></p>
                                  </div>
                                  <div class="solicitud-actions">
                                      <button class="btn aceptar" data-id="<%= solicitud.id_registro %>">Aceptar</button>
                                      <button class="btn rechazar" data-id="<%= solicitud.id_registro %>">Rechazar</button>
                                  </div>
                              </div>
                          <% }) %>
                      </div>
                  <% } else { %>
                      <p class="no-solicitudes">No hay solicitudes pendientes</p>
                  <% } %>

                  <h2>Solicitudes de Cambio Enviadas</h2>
                  <% if (info.eventos.solicitudesEnviadas && info.eventos.solicitudesEnviadas.length > 0) { %>
                      <div class="solicitudes-container">
                          <% info.eventos.solicitudesEnviadas.forEach(solicitud => { %>
                              <div class="solicitud-card" 
                                  data-id="<%= solicitud.id_registro %>"
                                  data-id-turno-solicitado="<%= solicitud.id_turno_solicitado %>"
                                  data-id-turno-a-cambiar="<%= solicitud.id_turno_a_cambiar %>"
                                  data-id-empleado-receptor="<%= solicitud.id_empleado_receptor %>"
                                  data-id-empleado-solicitante="<%= solicitud.id_empleado_solicitante %>"
                                  data-nombre-receptor="<%= solicitud.nombre_receptor %>"
                                  data-fecha-evento="<%= solicitud.fecha_evento %>">
                                  <div class="solicitud-header">
                                      <span class="solicitante-nombre"><%= solicitud.nombre_solicitante %></span>
                                  </div>
                                  <div class="solicitud-content">
                                    <p><strong>Hacia:</strong> <%= solicitud.nombre_receptor %></p>
                                      <p><strong>Solicita:</strong> <%= solicitud.descripcion_turno_solicitado %></p>
                                      <p><strong>Ofrece:</strong> <%= solicitud.descripcion_turno_a_cambiar %></p>
                                      <p class="comentario"><strong>Comentario:</strong> <%= solicitud.comentario || 'Sin comentarios' %></p>
                                  </div>
                                  <div class="solicitud-actions">
                                      <button class="btn anular" data-id="<%= solicitud.id_registro %>">Anular</button>
                                  </div>
                              </div>
                          <% }) %>
                      </div>
                  <% } else { %>
                      <p class="no-solicitudes">No hay solicitudes pendientes</p>
                  <% } %>
                </div>
            
                <!-- Placeholder para Registro de Eventos -->
                <div class="registroEventos">
                    <h2>Registro de Eventos</h2>
                    <% if (info.eventos.registrosEventos && info.eventos.registrosEventos.length > 0) { %>
                      <% info.eventos.registrosEventos.forEach((evento, index) => { %>
                        <% if (['solicitudCambio', 'confirmacionCambio', 'rechazoCambio', 'anularCambio'].includes(evento.tipo_solicitud)) { %>
                          <div class="evento <%= evento.tipo_solicitud %>">
                            <div class="evento-fecha">
                              <%= evento.fecha_evento %>
                            </div>
                            <div class="evento-detalle">
                              <p>
                                <% if (evento.tipo_solicitud === 'solicitudCambio') { %>
                                  <%= evento.nombre_solicitante %> solicitó a <%= evento.nombre_receptor %> 
                                  el turno "<%= evento.descripcion_turno_solicitado %>".
                                <% } else if (evento.tipo_solicitud === 'confirmacionCambio') { %>
                                  <%= evento.nombre_solicitante %> confirmó el cambio de turno con <%= evento.nombre_receptor %> 
                                  por "<%= evento.descripcion_turno_solicitado %>".
                                <% } else if (evento.tipo_solicitud === 'rechazoCambio') { %>
                                  <%= evento.nombre_solicitante %> rechazó el cambio de turno con <%= evento.nombre_receptor %> 
                                  por "<%= evento.descripcion_turno_solicitado %>".
                                <% } else if (evento.tipo_solicitud === 'anularCambio') { %>
                                  <%= evento.nombre_solicitante %> anuló la solicitud de cambio con <%= evento.nombre_receptor %> 
                                  para el turno "<%= evento.descripcion_turno_solicitado %>".
                                <% } %>
                                Comentario: "<%= evento.comentario || 'Sin comentarios' %>"
                              </p>
                            </div>
                          </div>
                          <% if (index < info.eventos.registrosEventos.length - 1) { %>
                            <div class="separador"></div>
                          <% } %>
                        <% } %>
                      <% }) %>
                    <% } else { %>
                      <p class="no-eventos">No hay eventos registrados</p>
                    <% } %>
                </div>
              </div>
            </div>
              
              
          </div>
          
          </div>
        </main>
      </div>
    </div>

