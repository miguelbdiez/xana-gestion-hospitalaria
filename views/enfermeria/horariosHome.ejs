    color: #6c757d;
}

.solicitud-content .comentario {
    font-style: italic;
    color: #6c757d;
}

.solicitud-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding-top: 10px;
    border-top: 1px solid #e9ecef;
}

.btn {
    padding: 6px 15px;
    border: none;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
}

.aceptar {
    background-color: #28a745;
    color: white;
}

.rechazar {
    background-color: #dc3545;
    color: white;
}

.aceptar:hover {
    background-color: #218838;
}
.anular {
    background-color: #e7e960;
}
.anular:hover {
    background-color: #f3f712;
}

.rechazar:hover {
    background-color: #c82333;
}

.no-solicitudes {
    font-size: 16px;
    color: #6c757d;
    text-align: center;
    padding: 10px;
}
