   <script>
    // Función para inicializar los eventos de los turnos
    function inicializarEventosTurnos() {
        document.querySelectorAll('.turno').forEach(turno => {
            turno.addEventListener('click', async function() {
                const info = JSON.parse(this.getAttribute('data-info'));
                const mesActual = document.getElementById('selector-mes').value;

                document.getElementById('modalDia').textContent = `${info[0].dia} de ${mesActual} ${info[0].año}`;
                document.getElementById('modalTurno').textContent = info[0].turno;
                document.getElementById('modalHora').textContent = info[0].turno === 'Mañana' ? '08:00 - 14:00' : 
                                                                  info[0].turno === 'Tarde' ? '14:00 - 20:00' : '20:00 - 08:00';

                const trabajadoresList = document.getElementById('modalTrabajadoresList');
                trabajadoresList.innerHTML = '';
                if (info.length === 1 && info[0].nombre_trabajador === '-') {
                    const li = document.createElement('li');
                    li.textContent = 'No asignado';
                    trabajadoresList.appendChild(li);
                } else {
                    info.forEach(trabajador => {
                        const li = document.createElement('li');
                        const nombreSpan = document.createElement('span');
                        nombreSpan.textContent = trabajador.nombre_trabajador;
                        const boton = document.createElement('button');
                        boton.className = 'btn-solicitar';
                        boton.textContent = 'Solicitar Cambio';
                        boton.setAttribute('data-turno-id', trabajador.id);
                        boton.setAttribute('data-empleado-id', trabajador.id_empleado);
                        boton.setAttribute('data-trabajador', trabajador.nombre_trabajador);
                        boton.setAttribute('data-dia', info[0].dia);
                        boton.setAttribute('data-turno', info[0].turno);
                        boton.setAttribute('data-hora', info[0].turno === 'Mañana' ? '08:00 - 14:00' : 
                                                      info[0].turno === 'Tarde' ? '14:00 - 20:00' : '20:00 - 08:00');
                        boton.addEventListener('click', async function() {
                            const receptorIdTurno = this.getAttribute('data-turno-id');
                            const receptorIdEmpleado = this.getAttribute('data-empleado-id');
                            const receptorNombre = this.getAttribute('data-trabajador');
                            const receptorDia = this.getAttribute('data-dia');
                            const receptorTurno = this.getAttribute('data-turno');
                            const receptorHora = this.getAttribute('data-hora');

                            const turnoModal = bootstrap.Modal.getInstance(document.getElementById('turnoModal'));
                            turnoModal.hide();

                            document.getElementById('cambioModalDia').textContent = `${receptorDia} de ${mesActual} ${info[0].año}`;
                            document.getElementById('cambioModalTurno').textContent = receptorTurno;
                            document.getElementById('cambioModalHora').textContent = receptorHora;
                            document.getElementById('cambioModalTrabajador').textContent = receptorNombre;
                            document.getElementById('cambioModalUsuario').textContent = document.getElementById('nombreDelUsuario').textContent || receptorNombre;
                            document.getElementById('confirmarCambio').setAttribute('data-turno-id', receptorIdTurno);
                            document.getElementById('confirmarCambio').setAttribute('data-empleado-id', receptorIdEmpleado);

                            const selectTurnos = document.getElementById('cambioModalTurnos');
                            selectTurnos.innerHTML = '<option value="">Cargando turnos...</option>';

                            try {
                                const miIdEmpleado = localStorage.getItem("usuarioId");
                                console.log(miIdEmpleado)
                                const response = await fetch(`/enfermeria/horariosHome/recuperarTurnosTrabajador?id=${miIdEmpleado}`);
                                const data = await response.json();
                                console.log(data);

                                selectTurnos.innerHTML = '<option value="">Selecciona un turno</option>';
                                if (data.length === 0) {
                                    selectTurnos.innerHTML = '<option value="">No hay turnos futuros disponibles</option>';
                                } else {
                                    data.forEach(turno => {
                                        const option = document.createElement('option');
                                        option.value = turno.id;
                                        const horas = turno.turno === 'Mañana' ? '08:00 - 14:00' : 
                                                     turno.turno === 'Tarde' ? '14:00 - 20:00' : '20:00 - 08:00';
                                        option.textContent = `Día ${turno.dia}, ${turno.dia_semana} - ${turno.turno} (${horas})`;
                                        option.setAttribute('data-año', turno.año);
                                        option.setAttribute('data-mes', turno.mes);
                                        option.setAttribute('data-dia_semana', turno.dia_semana);
                                        option.setAttribute('data-nombre_trabajador', turno.nombre_trabajador);
                                        option.setAttribute('data-especialidad', turno.especialidad);
                                        option.setAttribute('data-empleado-id', turno.id_empleado);
                                        selectTurnos.appendChild(option);
                                    });
                                }
                            } catch (error) {
                                console.error('Error al cargar turnos:', error);
                                selectTurnos.innerHTML = '<option value="">Error al cargar turnos</option>';
                            }

                            document.getElementById('cambioModalComentarios').value = '';
                            const cambioModal = new bootstrap.Modal(document.getElementById('cambioTurnoModal'));
                            cambioModal.show();
                        });
                        li.appendChild(nombreSpan);
                        li.appendChild(boton);
                        trabajadoresList.appendChild(li);
                    });
                }
            });
        });
    }

    // Función para actualizar el calendario con fetch
    function actualizarCalendario() {
        const mes = document.getElementById('selector-mes').value;
        const año = document.getElementById('selector-año').value;
        const especialidad = document.getElementById('tituloEspecialidad').textContent;
        console.log(especialidad);

        document.getElementById('titulo-calendario').textContent = `Horario de ${mes} ${año}`;

        regenerarGrid(mes, año);

        fetch(`/enfermeria/horarios/actualizarCalendario?mes=${encodeURIComponent(mes)}&año=${año}&especialidad=${especialidad}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Datos recibidos:', data);
                    llenarTurnos(data.turnos, mes, año);
                    inicializarEventosTurnos(); // Reaplicamos los eventos después de llenar los turnos
                } else {
                    alert("EL HORARIO SELECCIONADO AUN NO ESTA DISPONIBLE");
                }
            })
            .catch(error => {
                console.error('Error en fetch:', error);
            });
    }

    function getDiasEnMes(mes, año) {
        const mesIndex = {
            'enero': 0, 'febrero': 1, 'marzo': 2, 'abril': 3, 'mayo': 4, 'junio': 5,
            'julio': 6, 'agosto': 7, 'septiembre': 8, 'octubre': 9, 'noviembre': 10, 'diciembre': 11
        }[mes.toLowerCase()];
        return new Date(año, mesIndex + 1, 0).getDate();
    }

    function regenerarGrid(mes, año) {
        const diasEnMes = getDiasEnMes(mes, año);
        const mesIndex = {
            'enero': 0, 'febrero': 1, 'marzo': 2, 'abril': 3, 'mayo': 4, 'junio': 5,
            'julio': 6, 'agosto': 7, 'septiembre': 8, 'octubre': 9, 'noviembre': 10, 'diciembre': 11
        }[mes.toLowerCase()];
        
        const primerDia = new Date(año, mesIndex, 1).getDay();
        const offset = (primerDia + 6) % 7;
        
        let html = `
            <div class="dia-semana">Lun</div>
            <div class="dia-semana">Mar</div>
            <div class="dia-semana">Mié</div>
            <div class="dia-semana">Jue</div>
            <div class="dia-semana">Vie</div>
            <div class="dia-semana">Sáb</div>
            <div class="dia-semana">Dom</div>
        `;
        
        for(let i = 0; i < offset; i++) {
            html += '<div class="dia-vacio"></div>';
        }
        
        for(let dia = 1; dia <= diasEnMes; dia++) {
            html += `
                <div class="dia">
                    <div class="numero-dia">${dia}</div>
                    <div class="turno mañana" data-bs-toggle="modal" data-bs-target="#turnoModal" data-info='[]'>-</div>
                    <div class="turno tarde" data-bs-toggle="modal" data-bs-target="#turnoModal" data-info='[]'>-</div>
                    <div class="turno noche" data-bs-toggle="modal" data-bs-target="#turnoModal" data-info='[]'>-</div>
                </div>
            `;
        }
        
        document.querySelector('.calendario-grid').innerHTML = html;
    }

    function llenarTurnos(turnos, mes, año) {
        const calendarioGrid = document.querySelector('.calendario-grid');
        const dias = calendarioGrid.querySelectorAll('.dia');
        const diasEnMes = getDiasEnMes(mes, año);

        turnos.forEach(turno => {
            if (turno.dia > 0 && turno.dia <= diasEnMes) {
                const diaNum = turno.dia;
                const diaElement = Array.from(dias).find(d => 
                    parseInt(d.querySelector('.numero-dia').textContent) === diaNum
                );

                if (diaElement) {
                    let turnoElement;
                    switch(turno.turno.toLowerCase()) {
                        case 'mañana':
                            turnoElement = diaElement.querySelector('.turno.mañana');
                            break;
                        case 'tarde':
                            turnoElement = diaElement.querySelector('.turno.tarde');
                            break;
                        case 'noche':
                            turnoElement = diaElement.querySelector('.turno.noche');
                            break;
                    }

                    if (turnoElement) {
                        turnoElement.innerHTML = `<div>${turno.nombre_trabajador}</div>`;
                        const turnoInfo = [{
                            turno: turno.turno,
                            dia: turno.dia,
                            nombre_trabajador: turno.nombre_trabajador,
                            id: turno.id,
                            mes: turno.mes,
                            año: turno.año,
                            id_empleado: turno.id_empleado // Añadimos id_empleado para el modal
                        }];
                        turnoElement.dataset.info = JSON.stringify(turnoInfo);
                    }
                }
            }
        });
    }

    // Evento para confirmar el cambio
    document.getElementById('confirmarCambio').addEventListener('click', async function() {
        const receptorIdTurno = this.getAttribute('data-turno-id');
        const receptorIdEmpleado = this.getAttribute('data-empleado-id');
        const receptorDia = document.getElementById('cambioModalDia').textContent;
        const receptorTurno = document.getElementById('cambioModalTurno').textContent;
        const receptorNombre = document.getElementById('cambioModalTrabajador').textContent;
        const selectTurnos = document.getElementById('cambioModalTurnos');
        const miTurnoId = selectTurnos.value;
        const selectedOption = selectTurnos.options[selectTurnos.selectedIndex];
        const miTurnoTexto = selectedOption.textContent;
        const miIdEmpleado = localStorage.getItem("usuarioId");
        const miNombreUsuario = "<%= info.nombre %>";
        const comentarios = document.getElementById('cambioModalComentarios').value;

        if (!miTurnoId || miTurnoId === "") {
            const existingAlert = document.querySelector('.alert-danger');
            if (!existingAlert) {
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger mt-3';
                alertDiv.setAttribute('role', 'alert');
                alertDiv.textContent = 'Por favor, selecciona un turno para continuar.';
                document.querySelector('.solicitud-info').appendChild(alertDiv);
                setTimeout(() => {
                    alertDiv.remove();
                }, 3000);
            }
            return;
        }

        const solicitudCambio = {
            receptorIdTurno,
            receptorIdEmpleado,
            receptorDia,
            receptorTurno,
            receptorNombre,
            miTurnoId,
            miIdEmpleado,
            miTurnoTexto,
            miNombreUsuario,
            comentarios
        };

        try {
            const response = await fetch('/enfermeria/horariosHome/solicitarCambioDeTurno', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(solicitudCambio)
            });

            const data = await response.json();
            console.log(data);

            if (data.success === true) {
                const cambioModal = bootstrap.Modal.getInstance(document.getElementById('cambioTurnoModal'));
                const successDiv = document.getElementById('infoProceso');
                successDiv.className = 'alert alert-success mt-3';
                successDiv.textContent = 'Solicitud de cambio enviada con éxito';
                document.querySelector('.solicitud-info').appendChild(successDiv);
                setTimeout(() => {
                    successDiv.remove();
                    cambioModal.hide();
                    window.location.href = "/enfermeria/horarios";
                }, 3000);
            } else {
                const successDiv = document.getElementById('infoProceso');
                successDiv.className = 'alert alert-danger mt-3';
                successDiv.textContent = data.message;
                document.querySelector('.solicitud-info').appendChild(successDiv);
                setTimeout(() => {
                    successDiv.remove();
                }, 3000);
            }
        } catch (error) {
            console.error('Error en la solicitud de cambio:', error);
        }
    });

