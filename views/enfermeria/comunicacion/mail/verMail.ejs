          </div>
        </div>


        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div
          class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
        >
          <h1><%= info.nombre %></h1>
          <div class=" d-flex align-items-center">
            <a id="btnVolverLista" class="call-btn btn-img me-2" href="/comunicacionHome">
              <img src="/imagenes/volver.png" alt="Volver" style="width: 24px; height: 24px;" />
            </a>
            <h2 class="m-0">Ver Mail</h2>
          </div>
        </div>
   
          
          <div class="container bootdey">
            <div class="email-app mb-4">   
              <nav>
                <a
                href="/comunicacion/mail/newMail"
                class="btn btn-danger btn-block"
                  >Redactar Mail</a
                >
                <ul class="nav">
                  <li class="nav-item">
                    <a class="nav-link" href="/comunicacion/mail/bandeja"
                      ><i class="fa fa-inbox"></i> Bandeja
                      <span class="badge badge-danger">4</span></a
                    >
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/comunicacion/mail/mailFavoritos"
                      ><i class="fa fa-star"></i> Favoritos</a
                    >
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/comunicacion/mail/mailEnviados"
                      ><i class="fa fa-rocket"></i> Enviados</a
                    >
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/comunicacion/mail/mailEliminados"
                      ><i class="fa fa-trash-o"></i> Eliminados</a
                    >
                  </li>
                 
                  
                </ul>
              </nav>
              <main class="inbox">
                <div class="panel-body message">
                  <div class="message-title"><%= info.mensaje.asunto %></div>
              
                  <div class="header">
                    <img class="avatar" src="https://bootdey.com/img/Content/avatar/avatar1.png" alt="Avatar">
              
                    <div class="from">
                      <span>                      <%= info.mensaje.emisorMail %>
                      </span>
                    </div>
              
                    <div class="date">
                      <span class="fa fa-paper-clip"></span> 
                      <%= info.mensaje.fecha.toLocaleDateString() %>, <b><%= info.mensaje.fecha.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></b>
                    </div>
                  </div>
              
                  <div class="content">
                    <p><%= info.mensaje.contenido %></p>
                  </div>
                </div>
              </main>
            </div>
          </div>

          
        </main>
      </div>
    </div>
    <script src="../assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="dashboard.js"></script>

  





    <script
      src="https://cdn.jsdelivr.net/npm/chart.js@4.3.2/dist/chart.umd.js"
