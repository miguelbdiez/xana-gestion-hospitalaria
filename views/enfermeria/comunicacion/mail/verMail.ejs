}

.inbox ul.messages-list li .title {
  margin: 0 0 5px 0;
  white-space: nowrap;
  overflow: hidden!important;
  text-overflow: ellipsis
}

.inbox ul.messages-list li .description {
  font-size: 12px;
  padding-left: 29px
