       <div id="chatIcon" style="display: block">
         <img
           src="/imagenes/chatIcon.png"
           alt="Chat"
           width="24"
           height="24"
         />
       </div>
   
       <!-- Imagen cuando hay mensajes nuevos -->
       <div id="chatIconNew" style="display: none">
         <img
           src="/imagenes/chatIconNew.png"
           alt="Chat Nuevo"
           width="24"
           height="24"
         />
       </div>
       </button>
   
       <button
       class="btn btn-secondary"
       data-bs-toggle="offcanvas"
       data-bs-target="#sidebarNotificaciones"
       aria-controls="sidebarMenu"
       aria-expanded="false"
       aria-label="Toggle navigation"
       >
       <div id="notIcon" style="display: block">
         <img
           src="/imagenes/campana.png"
           alt="notificacion"
           width="24"
           height="24"
         />
       </div>
   
       <!-- Imagen cuando hay mensajes nuevos -->
       <div id="notIconNew" style="display: none">
         <img
           src="/imagenes/campanaConNotificacion.png"
           alt="notificacion"
           width="24"
           height="24"
         />
       </div>
       </button>
       </div>
       </header>

