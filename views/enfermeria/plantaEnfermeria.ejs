        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario">Enfermería</h1>
            <div class=" d-flex align-items-center">
              <a id="btnVolverLista" class="call-btn btn-img me-2" href="/home">
                <img
                  src="/imagenes/volver.png"
                  alt="Volver"
                  style="width: 24px; height: 24px"
                />
              </a>
              <h2 class="m-0">Ingresados</h2>
            </div>
          </div>

          <!-- Contenedor para la lista de pacientes (vacío por ahora) -->
          <div class="album py-5 bg-body-tertiary">
            <div class="container">
              <div class="buttons">
                <button
                  id="btn-mapa-camas"
                  class="active"
                  title="Ver todas las camas de la especialidad"
                >
                  <i class="fas fa-bed"></i> Mapa de camas
                </button>
                <button
                  id="btn-area-trabajo"
                  title="Ver área de trabajo personalizada"
                >
                  <i class="fas fa-briefcase"></i> Área de trabajo
                </button>
              </div>
              <div id="mapa-camas">
                <% if (info.ingresadosInfo.length === 0) { %>
                <p>No hay camas registradas para esta especialidad.</p>
                <% } else { %> <% info.ingresadosInfo.forEach(cama => { %>
                <div
                  class="panel"
                  data-cama_id="<%= cama.cama_id %>"
                  data-id_ingreso="<%= cama.id_ingreso %>"
                  data-bloqueado="<%= cama.bloqueado %>""
                >
                  <% if (cama.panel) { %>
                  <img
                    src="<%= cama.panel %>"
                    alt="Panel para <%= cama.cama_id %>"
                  />
                  <% } else { %>
                  <p>No hay imagen disponible</p>
                  <% } %>
                </div>
                <% }); %> <% } %>
              </div>
              <div id="area-trabajo">
                <button
                  id="btn-config-area"
                  class="btn-config-sutil"
                  data-bs-toggle="modal"
                  data-bs-target="#areaTrabajoModal"
                  title="Editar Área de Trabajo"
                >
                  <i class="fas fa-pencil-alt"></i>
                </button>
