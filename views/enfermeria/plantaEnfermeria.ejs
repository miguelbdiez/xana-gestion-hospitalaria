    <div
      class="modal fade"
      id="modalLlamandaEntrante"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <!-- Header que ya tenías -->
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name">Llamanda Entrante</p>
                <p
                  class=""
                  data-Persona-que-llama-id=""
                  id="Persona_que_llama"
                ></p>
              </div>
            </div>
            <div class="footer">
              <!-- Segundo bloque de footer con los botones -->
              <button
                class="bouton accepter"
                id="btnAceptarLlamada"
                title="Aceptar"
              >
                <span class="icon green">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M20.707 5.293a1 1 0 00-1.414 0L9 15.586 4.707 11.293a1 1 0 00-1.414 1.414l5 5a1 1 0 001.414 0l11-11a1 1 0 000-1.414z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Aceptar</span>
              </button>

              <button
                class="bouton raccrocher"
                id="btnRechazarLlamada"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Colgar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>


    <script>
      // Configuración inicial
      const btnMapaCamas = document.getElementById('btn-mapa-camas');
      const btnAreaTrabajo = document.getElementById('btn-area-trabajo');
      const mapaCamas = document.getElementById('mapa-camas');
      const selectCama = document.getElementById('selectCama');
      const btnAnadirCama = document.getElementById('btnAnadirCama');
      const camasList = document.getElementById('camasList');
      const btnAplicar = document.getElementById('btnAplicar');
      let camasSeleccionadas = <%- JSON.stringify(info.ingresadosInfoZonaTrabajo.map(cama => cama.cama_id)) %>;
      const areaTrabajo = document.getElementById('area-trabajo');
      const especialidad = '<%= info.especialidad %>';
      const usuarioID = localStorage.getItem('usuarioId') || '1';
      const ingresadosInfo = <%- JSON.stringify(info.ingresadosInfo) %>;

      document.getElementById('areaTrabajoModal').addEventListener('show.bs.modal', () => {
        actualizarListaCamas();
      });

      function switchView(view) {
        if (view === 'mapa-camas') {
          mapaCamas.style.display = 'flex';
          areaTrabajo.style.display = 'none';
          btnMapaCamas.classList.add('active');
          btnAreaTrabajo.classList.remove('active');
        } else {
          mapaCamas.style.display = 'none';
          areaTrabajo.style.display = 'flex';
          btnMapaCamas.classList.remove('active');
          btnAreaTrabajo.classList.add('active');
        }
        localStorage.setItem('selectedView', view);
      }

      const savedView = localStorage.getItem('selectedView') || 'mapa-camas';
      switchView(savedView);

      btnMapaCamas.addEventListener('click', () => switchView('mapa-camas'));
      btnAreaTrabajo.addEventListener('click', () => switchView('area-trabajo'));

      document.querySelectorAll('.panel').forEach(panel => {
        panel.addEventListener('click', () => {
          const camaId = panel.getAttribute('data-cama_id');
          const idIngreso = panel.getAttribute('data-id_ingreso');
          const bloqueado = panel.getAttribute('data-bloqueado');
          
          window.location.href=`/paciente?cama_id=${camaId}&ingreso_id=${idIngreso}&bloqueado=${bloqueado}`
           

              });
            });

      btnAnadirCama.addEventListener('click', () => {
        const camaId = selectCama.value;
        if (camaId && !camasSeleccionadas.includes(camaId)) {
          camasSeleccionadas.push(camaId);
          actualizarListaCamas();
          selectCama.value = '';
        }
      });

      function actualizarListaCamas() {
        camasList.innerHTML = '';
        camasSeleccionadas.forEach(camaId => {
          const li = document.createElement('li');
          li.innerHTML = `
            <span>${camaId}</span>
            <button class="btn-remove-cama" data-cama-id="${camaId}">
              <i class="fas fa-minus-circle"></i>
            </button>
          `;
          camasList.appendChild(li);
        });

        document.querySelectorAll('.btn-remove-cama').forEach(button => {
          button.addEventListener('click', () => {
            const camaId = button.getAttribute('data-cama-id');
            camasSeleccionadas = camasSeleccionadas.filter(id => id !== camaId);
            actualizarListaCamas();
          });
        });
      }

      btnAplicar.addEventListener('click', async () => {
        try {
          console.log('Camas seleccionadas:', camasSeleccionadas);

          // Fetch a /enfermeria/actualizarZonaDeTrabajo
          const response = await fetch('/enfermeria/actualizarZonaDeTrabajo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ usuario_id: usuarioID, camas: camasSeleccionadas, especialidad })
          });

          if (!response.ok) {
            throw new Error('Error al actualizar zona de trabajo');
          }

          // Actualizar #area-trabajo con los paneles
          const camasActualizadas = ingresadosInfo.filter(cama => camasSeleccionadas.includes(cama.cama_id));
          areaTrabajo.innerHTML = `
            <button id="btn-config-area" class="btn-config-sutil" data-bs-toggle="modal" data-bs-target="#areaTrabajoModal" title="Editar Área de Trabajo">
              <i class="fas fa-pencil-alt"></i>
            </button>
          `;
          if (camasActualizadas.length === 0) {
            areaTrabajo.innerHTML += '<p>No hay camas seleccionadas en tu zona de trabajo.</p>';
          } else {
            camasActualizadas.forEach(cama => {
              const div = document.createElement('div');
              div.className = 'panel';
              div.setAttribute('data-cama_id', cama.cama_id);
              div.setAttribute('data-id_ingreso', cama.id_ingreso);
              div.innerHTML = `
                ${cama.panel ? `<img src="${cama.panel}" alt="Panel para ${cama.cama_id}">` : '<p>No hay imagen disponible</p>'}
              `;
              areaTrabajo.appendChild(div);
            });
          }

          
          bootstrap.Modal.getInstance(document.getElementById('areaTrabajoModal')).hide();
        } catch (error) {
          console.error('Error al aplicar cambios:', error);
        }
      });
    </script>
  
 
  </body>
</html>
