}

.medicacion-entry-field {
  display: flex;
  gap: 10px;
  align-items: baseline;
}

.medicacion-entry-label {
  font-weight: 500;
  color: #374151;
  min-width: 120px;
}

.medicacion-entry-value {
  color: #1f2937;
}
  
