}

#administrarMedicacionModal .medicacion-btn-secondary {
    background-color: #6b7280;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

#administrarMedicacionModal .medicacion-btn-secondary:hover {
    background-color: #4b5563;
}

#administrarMedicacionModal .form-group {
    margin-bottom: 10px;
    flex: 1;
    min-width: 200px;
}

#administrarMedicacionModal .form-group label {
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 5px;
    display: block;
}

#administrarMedicacionModal .form-group input,
#administrarMedicacionModal .form-group select,
#administrarMedicacionModal .form-group textarea {
    width: 100%;
    padding: 8px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 0.9rem;
    color: #1f2937;
    transition: border-color 0.2s ease;
}

#administrarMedicacionModal .form-group input:focus,
#administrarMedicacionModal .form-group select:focus,
#administrarMedicacionModal .form-group textarea:focus {
    outline: none;
    border-color: #2dd4bf;
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.1);
}

#administrarMedicacionModal .modal-footer {
    border-top: 1px solid #e5e7eb;
    padding: 15px 20px;
    background-color: #f8fafc;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

#administrarMedicacionModal .hidden {
    display: none;
}

#administrarMedicacionModal .form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 10px;
}

#administrarMedicacionModal .campos-administracion {
    padding: 10px;
    background-color: #f8fafc;
    border-radius: 6px;
    border: 1px solid #d1d5db;
    margin-top: 10px;
}

#administrarMedicacionModal .medicacion-item-even {
    background-color: #ffffff;
}

#administrarMedicacionModal .medicacion-item-odd {
    background-color: #f1f5f9;
}

#administrarMedicacionModal .medicacion-divider {
    border: 0;
    border-top: 1px solid #d1d5db;
    margin: 10px 0;
}

#administrarMedicacionModal .medicacion-checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
}

/* Nuevos estilos para entradas de administración */
.medicacion-entry {
  width: 100%;
  padding: 15px;
  margin-bottom: 15px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.medicacion-entry-even {
  background-color: #ffffff;
}

.medicacion-entry-odd {
