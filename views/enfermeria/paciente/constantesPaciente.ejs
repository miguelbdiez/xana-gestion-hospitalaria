                <!-- Botón para abrir el modal -->
                <button class="edit-button incidence-button" data-bs-toggle="modal" data-bs-target="#incidenciaModal">Incidencia</button>
                <button class="edit-button" data-bs-toggle="modal" data-bs-target="#editModal">Editar</button>
                <!-- Panel del paciente a la izquierda -->
                <div class="panel-paciente">
                  <% if (info.infoCabecera.panelPaciente) { %>
                    <img src="<%= info.infoCabecera.panelPaciente %>" 
                         alt="Panel Paciente" />
                  <% } else { %>
                    <p>Sin imagen de panel</p>
                  <% } %>
                </div>
                
                <!-- Campos de la cabecera en columnas -->
                <div class="info-paciente">
                  <div class="info-column">
                    <p>
                      <strong>PACIENTE:</strong> 
                      <span id="paciente-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %>">
                        <%= info.infoCabecera.paciente_nombre_completo || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.paciente_nombre_completo && info.infoCabecera.paciente_nombre_completo.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('paciente-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.paciente_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>MÉDICO:</strong> 
                      <span id="medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>">
                        <%= info.infoCabecera.medico_nombre_completo || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.medico_nombre_completo && info.infoCabecera.medico_nombre_completo.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('medico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.medico_nombre_completo.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>SERVICIO:</strong> 
                      <span id="servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.especialidad || 'No disponible' %>">
                        <%= info.infoCabecera.especialidad || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.especialidad && info.infoCabecera.especialidad.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('servicio-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.especialidad.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>FECHA DE INGRESO:</strong> <span class="text-limited" title="<%= info.infoCabecera.fecha_ini || 'No disponible' %>"><%= info.infoCabecera.fecha_ini || 'No disponible' %></span></p>
                    <p>
                      <strong>DIAGNÓSTICO:</strong> 
                      <span id="diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.diagnostico || 'No especificado' %>">
                        <%= info.infoCabecera.diagnostico || 'No especificado' %>
                      </span>
                      <% if (info.infoCabecera.diagnostico && info.infoCabecera.diagnostico.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('diagnostico-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.diagnostico.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p>
                      <strong>ALERGIAS:</strong> 
                      <span id="alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>
                      </span>
                      <% 
                        const alergiasText = `(${info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna'}) ${info.infoCabecera.alergia || 'Ninguna'}`;
                        if (alergiasText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= alergiasText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                  <div class="info-column">
                    <p>
                      <strong>DIETA:</strong> 
                      <span id="dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>
                      </span>
                      <% 
                        const dietaText = `(${info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna'}) ${info.infoCabecera.dieta || 'Ninguna'}`;
                        if (dietaText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= dietaText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>AISLAMIENTO:</strong> <span class="text-limited" id="aislamiento-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %>"><%= info.infoCabecera.aislamiento ? 'Sí' : 'No' %></span></p>
                    <p><strong>GRUPO SANGUÍNEO:</strong> <span class="text-limited" id="grupoSanguineo-<%= info.infoCabecera.ingreso_id || 'unknown' %>" title="<%= info.infoCabecera.grupo_rh || 'No especificado' %>"><%= info.infoCabecera.grupo_rh || 'No especificado' %></span></p>
                    <p>
                      <strong>HISTORIA:</strong> 
                      <span id="historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.historia || 'No disponible' %>">
                        <%= info.infoCabecera.historia || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.historia && info.infoCabecera.historia.length > 20) { %>
                        <button class="toggle-button" onclick="expandirTexto('historia-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.historia.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                    <p><strong>EPISODIO:</strong> <span class="text-limited" title="<%= info.infoCabecera.ingreso_id || 'No disponible' %>"><%= info.infoCabecera.ingreso_id || 'No disponible' %></span></p>
                    <p>
                      <strong>AT:</strong> 
                      <span id="antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="<%= info.infoCabecera.antecedentes || 'No disponible' %>">
                        <%= info.infoCabecera.antecedentes || 'No disponible' %>
                      </span>
                      <% if (info.infoCabecera.antecedentes && info.infoCabecera.antecedentes.length > 30) { %>
                        <button class="toggle-button" onclick="expandirTexto('antecedentes-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= info.infoCabecera.antecedentes.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="patient-info-container container">
              <p class="error-message">No se encontró información para el ingreso especificado.</p>
            </div>
          <% } %>
          <div class="constantes-section">
            <h1 class="constantes-title">Registro de Constantes del Paciente</h1>
            <button type="button" class="constantes-btn-primary" data-bs-toggle="modal" data-bs-target="#newConstantsModal">
                Añadir nueva Entrada
            </button>
            <% if (info.infoConstantesPaciente && info.infoConstantesPaciente.length > 0) { %>
                <div class="card shadow-sm rounded-3 mt-4"
                     data-ingreso-id="<%= info.ingreso_id %>"
                     data-paciente-id="<%= info.infoCabecera.documento_identificacion_paciente %>"
                     data-id-trabajador="<%= info.id_trabajador %>"
                     data-cama-id="<%= info.infoCabecera.cama_id %>"
                     data-historia="<%= info.infoCabecera.historia %>">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover mb-0" style="width: 100%;">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th class="py-3 px-3 text-left">Hora/Fecha</th>
                                        <th class="py-3 px-3 text-center">Temp. (°C)</th>
                                        <th class="py-3 px-3 text-left">Tos</th>
                                        <th class="py-3 px-3 text-left">Disnea</th>
                                        <th class="py-3 px-3 text-center">Sat. O2 (%)</th>
                                        <th class="py-3 px-3 text-center">Frec. Card. (lat/min)</th>
                                        <th class="py-3 px-3 text-center">TAS (mmHg)</th>
                                        <th class="py-3 px-3 text-center">TAD (mmHg)</th>
                                        <th class="py-3 px-3 text-center">Frec. Resp. (/min)</th>
                                        <th class="py-3 px-3 text-center">Glucemia (mg/dL)</th>
                                        <th class="py-3 px-3 text-center">Ins. Basal (UI)</th>
                                        <th class="py-3 px-3 text-center">Ins. Rápida (UI)</th>
                                        <th class="py-3 px-3 text-center">Conc. O2 (%)</th>
                                        <th class="py-3 px-3 text-center">Oxígeno (L/min)</th>
                                        <th class="py-3 px-3 text-center">Dispositivos</th>
                                        <th class="py-3 px-3 text-center">Peso (kg)</th>
                                        <th class="py-3 px-3 text-center">Talla (cm)</th>
                                        <th class="py-3 px-3 text-center">Per. Abd. (cm)</th>
                                        <th class="py-3 px-3 text-center">IMC (kg/m²)</th>
                                        <th class="py-3 px-3 text-center">Pérd. Peso (%)</th>
                                        <th class="py-3 px-3 text-center">Peso Ing. (kg)</th>
                                        <th class="py-3 px-3 text-center">Ingesta Oral (cc)</th>
                                        <th class="py-3 px-3 text-center">Agua End. (cc)</th>
                                        <th class="py-3 px-3 text-center">Medicación (cc)</th>
                                        <th class="py-3 px-3 text-center">Hemoderivados (cc)</th>
                                        <th class="py-3 px-3 text-center">Nut. Enteral (cc)</th>
                                        <th class="py-3 px-3 text-center">Sueroterapia (mL)</th>
                                        <th class="py-3 px-3 text-center">Agua Enteral (cc)</th>
                                        <th class="py-3 px-3 text-center">Suero Lav. Ent. (cc)</th>
                                        <th class="py-3 px-3 text-center">Diuresis (mL)</th>
                                        <th class="py-3 px-3 text-center">Drenajes (mL)</th>
                                        <th class="py-3 px-3 text-center">Suero Lav. Sal. (cc)</th>
                                        <th class="py-3 px-3 text-center">Pérd. Insens. (cc)</th>
                                        <th class="py-3 px-3 text-center">Vómitos Líq. (cc)</th>
                                        <th class="py-3 px-3 text-center">Nefrost. Der. (cc)</th>
                                        <th class="py-3 px-3 text-center">Nefrost. Izq. (cc)</th>
                                        <th class="py-3 px-3 text-center">Ureteral Der. (cc)</th>
                                        <th class="py-3 px-3 text-center">Ureteral Izq. (cc)</th>
                                        <th class="py-3 px-3 text-center">Cistotomía (cc)</th>
                                        <th class="py-3 px-3 text-center">PVC (cmH2O)</th>
                                        <th class="py-3 px-3 text-center">Dolor (EVA)</th>
                                        <th class="py-3 px-3 text-center">Micciones</th>
                                        <th class="py-3 px-3 text-center">Deposiciones</th>
                                        <th class="py-3 px-3 text-center">Vómitos</th>
                                        <th class="py-3 px-3 text-center">Cambio Postural</th>
                                        <th class="py-3 px-3 text-center">Asp. Gástrica (cc)</th>
                                        <th class="py-3 px-3 text-center">Frec. Card. Acum.</th>
                                        <th class="py-3 px-3 text-center">ENG</th>
                                        <th class="py-3 px-3 text-center">Expectoración</th>
                                        <th class="py-3 px-3 text-center">INR</th>
                                        <th class="py-3 px-3 text-center">Val. Ingesta</th>
                                    </tr>
                                </thead>
                                <tbody id="constantesTableBody">
                                    <% info.infoConstantesPaciente.forEach(row => { %>
                                        <tr>
                                            <td class="py-2 px-3 text-left"><%= row.fecha_emision || '-' %></td>
                                            <td class="py-2 px-3 text-center <%= row.temperatura > 37 ? 'text-danger fw-semibold' : '' %>">
                                                <%= row.temperatura || '-' %>
                                            </td>
                                            <td class="py-2 px-3 text-left"><%= row.tos || '-' %></td>
                                            <td class="py-2 px-3 text-left"><%= row.disnea || '-' %></td>
                                            <td class="py-2 px-3 text-center <%= row.saturacionO2 && row.saturacionO2 < 96 ? 'text-warning fw-semibold' : '' %>">
                                                <%= row.saturacionO2 || '-' %>
                                            </td>
                                            <td class="py-2 px-3 text-center"><%= row.frecCardiaca || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.tas || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.tad || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.frecRespiratoria || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.glucemia || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.insulinaBasal || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.insulinaRapida || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.concO2 || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.oxigeno || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.dispositivos || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.peso || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.talla || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.perimetroAbdominal || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.imc || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.perdidaPeso || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.pesoIngreso || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.ingestaOral || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.aguaEndogena || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.medicacion || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.hemoderivados || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.nutricionEnteral || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.sueroterapia || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.aguaEnteral || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.sueroLavadorEntrada || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.diuresis || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.drenajes || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.sueroLavadorSalida || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.perdidasInsensibles || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.vomitosLiquidos || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.nefrostomiaDerecha || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.nefrostomiaIzquierda || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.ureteralDerecha || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.ureteralIzquierda || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.cistotomia || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.pvc || '-' %></td>
                                            <td class="py-2 px-3 text-center <%= row.dolor >= 3 ? 'text-danger fw-semibold' : '' %>">
                                                <%= row.dolor || '-' %>
                                            </td>
                                            <td class="py-2 px-3 text-center"><%= row.micciones || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.deposiciones || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.vomitos || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.cambioPostural || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.aspiracionGastrica || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.frecCardiacaAcum || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.eng || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.expectoracion || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.inr || '-' %></td>
                                            <td class="py-2 px-3 text-center"><%= row.valoracionIngesta || '-' %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="card shadow-sm rounded-3 mt-4">
                    <div class="card-body text-center">
                        <p class="text-muted">Aún no se ha recogido ninguna constante</p>
                    </div>
                </div>
            <% } %>
        </div>
        <div class="graficos-section">
            <div class="checkbox-section">
                <h2 class="constantes-title">Seleccionar Constantes</h2>
                <div class="checkbox-grid">
