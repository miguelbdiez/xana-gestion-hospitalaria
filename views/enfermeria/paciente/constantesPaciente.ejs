                        <input type="checkbox" value="temperatura" data-label="Temperatura (°C)">
                        <span class="checkmark"></span>
                        Temperatura (°C)
                    </label>
                    <label class="checkbox-container">
                        <input type="checkbox" value="saturacionO2" data-label="Saturación O2 (%)">
                        <span class="checkmark"></span>
                        Saturación O2 (%)
                    </label>
                    <label class="checkbox-container">
                        <input type="checkbox" value="frecCardiaca" data-label="Frec. Cardíaca (lat/min)">
                        <span class="checkmark"></span>
                        Frec. Cardíaca (lat/min)
                    </label>
                    <label class="checkbox-container">
                        <input type="checkbox" value="tas" data-label="TAS (mmHg)">
                        <span class="checkmark"></span>
                        TAS (mmHg)
                    </label>
                    <label class="checkbox-container">
                        <input type="checkbox" value="tad" data-label="TAD (mmHg)">
                        <span class="checkmark"></span>
                        TAD (mmHg)
                    </label>
