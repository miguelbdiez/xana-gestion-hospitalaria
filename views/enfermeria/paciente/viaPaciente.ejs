        align-items: center;
        gap: 8px;
    }

    .mantenimiento-fecha {
        font-family: 'Roboto', Arial, sans-serif;
        font-size: 0.9rem;
        color: #064e3b;
        font-weight: 500;
    }

    .mantenimiento-item-body {
