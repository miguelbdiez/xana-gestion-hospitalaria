        flex-direction: column;
        gap: 8px;
    }

    .mantenimiento-detail {
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .mantenimiento-label {
        font-family: 'Roboto', Arial, sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: #064e3b;
