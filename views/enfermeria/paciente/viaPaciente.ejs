                        (<%= info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna' %>) <%= info.infoCabecera.alergia || 'Ninguna' %>
                      </span>
                      <% 
                        const alergiasText = `(${info.infoCabecera.tipo_alergia === 'grave' ? 'Grave' : info.infoCabecera.tipo_alergia === 'moderada' ? 'Moderada' : info.infoCabecera.tipo_alergia === 'leve' ? 'Leve' : 'Ninguna'}) ${info.infoCabecera.alergia || 'Ninguna'}`;
                        if (alergiasText.length > 30) { 
                      %>
                        <button class="toggle-button" onclick="expandirTexto('alergias-<%= info.infoCabecera.ingreso_id || 'unknown' %>', '<%= alergiasText.replace(/'/g, "\\'") %>')">Ver más</button>
                      <% } %>
                    </p>
                  </div>
                  <div class="info-column">
                    <p>
                      <strong>DIETA:</strong> 
                      <span id="dieta-<%= info.infoCabecera.ingreso_id || 'unknown' %>" class="text-limited" title="(<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>">
                        (<%= info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna' %>) <%= info.infoCabecera.dieta || 'Ninguna' %>
                      </span>
                      <% 
                        const dietaText = `(${info.infoCabecera.tipo_dieta === 'normal' ? 'Normal' : info.infoCabecera.tipo_dieta === 'blanda' ? 'Blanda' : info.infoCabecera.tipo_dieta === 'liquidos' ? 'Líquidos' : 'Ninguna'}) ${info.infoCabecera.dieta || 'Ninguna'}`;
                        if (dietaText.length > 30) { 
