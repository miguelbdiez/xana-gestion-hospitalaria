    <link href="/public/css/base/sideChat.css" rel="stylesheet" />
    

  


  </head>
  <body>
    <audio id="remoteAudio" autoplay></audio>
     <!-- Sidebar Chat -->
   <div
   class="offcanvas offcanvas-end"
   id="sidebarChat"
   tabindex="-1"
   aria-labelledby="sidebarLeftLabel"
   >
   <div id="plist" class="people-list">
     <div class="offcanvas-header border-bottom bg-primary text-white">
       <h5 class="offcanvas-title" id="sidebarLeftLabel">Chats</h5>
       <button
         type="button"
         class="btn-close btn-close-white"
         data-bs-dismiss="offcanvas"
         aria-label="Cerrar"
       ></button>
     </div>
     <div class="input-group p-3">
       <input
         type="text"
         class="form-control"
         id="searchInput"
         placeholder="Buscar..."
       />
     </div>
     <ul class="list-unstyled chat-list mb-0">
       <% info.listaPersonasChat.forEach(persona => { %>
       <li
         class="clearfix usuario-chat d-flex align-items-center p-3"
         data-user-id="<%= persona.id %>"
       >
         <img src="/imagenes/user.png" alt="Avatar" class="avatar" />
         <div class="about flex-grow-1">
           <div class="d-flex justify-content-between align-items-center">
             <div class="name"><%= persona.nombre %></div>
             <% if (persona.mensajes_no_leidos > 0) { %>
             <div class="mensaje-no-leido" style="display: block"></div>
             <% } %>
           </div>
           <div class="last-message">
             <%= persona.ultimo_mensaje || '' %>
           </div>
           <div class="message-data-time">
             <%= persona.fecha_ultimo_mensaje || '' %>
           </div>
         </div>
       </li>
       <% }) %>
     </ul>
   </div>

   <div class="chat" style="display: none">
     <div class="chat-header bg-primary text-white">
       <div
         class="row align-items-center d-flex justify-content-between p-3"
       >
         <div class="col-lg-6 d-flex align-items-center">
           <img src="/imagenes/user.png" alt="Avatar" class="avatar me-2" />
           <div class="chat-about" data-user-id="">
             <h6 class="m-0"></h6>
           </div>
         </div>
         <div class="col-lg-6 text-end d-flex justify-content-end gap-2">
           <button class="call-btn btn-img">
             <img src="/imagenes/llamada.png" alt="Llamar" />
           </button>
           <button id="btnVolverLista" class="call-btn btn-img">
             <img src="/imagenes/volver.png" alt="Volver" />
           </button>
         </div>
       </div>
     </div>

     <div class="chat-history" id="chat-box">
       <ul class="m-b-0"></ul>
     </div>
     <div class="chat-message">
       <div class="input-group">
         <input
           id="mensajeInput"
           type="text"
           class="form-control"
           placeholder="Escribe un mensaje..."
         />
         <button class="btn btn-primary" id="enviarBtn">Enviar</button>
       </div>
     </div>
   </div>
   </div>

   <!-- Sidebar Notificaciones -->

   <div
   class="offcanvas offcanvas-end bg-light"
   id="sidebarNotificaciones"
   tabindex="-1"
   aria-labelledby="sidebarRightLabel"
   >
   <div class="offcanvas-header border-bottom">
   <h5 class="offcanvas-title" id="sidebarRightLabel">Notificaciones</h5>
   <button
     type="button"
     class="btn-close"
     data-bs-dismiss="offcanvas"
     aria-label="Cerrar"
   ></button>
   </div>
   <div class="offcanvas-body p-0">
   <ul class="list-unstyled m-0" id="notificaciones">
     <% info.notificaciones.forEach(notificacion => { %>
     <li
       class="p-3 border-bottom <%= notificacion.tipo_notificacion %>"
       data-notificacion-id="<%= notificacion.id %>"
     >
       <small class="text-muted"
         ><%= notificacion.fecha_formateada %></small
       >
       <div class="fw-bold">
         <% if (notificacion.tipo_notificacion === 'tipo_mensaje') { %>
         Mensaje Nuevo <% } else if (notificacion.tipo_notificacion ===
         'tipo_horario') { %> Cambio de Horario <% } else if
         (notificacion.tipo_notificacion === 'tipo_llamada') { %> Llamada
         Perdida <% } else if (notificacion.tipo_notificacion ===
         'tipo_mail') { %> Nuevo Email <% } else if
         (notificacion.tipo_notificacion === 'tipo_bandeja_documentos') {
         %> Bandeja Documentos <% } else if (notificacion.tipo_notificacion
         === 'tipo_caducidad_3_dias_lote') { %> Lote Próximo a Caducar (3
         días) <% } else if (notificacion.tipo_notificacion ===
         'tipo_caducidad_1_dias_lote') { %> Lote a Punto de Caducar (1 día)
         <% } else { %> Notificación <% } %>
       </div>
       <div><%= notificacion.contenido_notificacion %></div>
       <button
         type="button"
         class="btn btn-sm btn-danger mt-1 borrar-notificacion"
         data-notificacion-id="<%= notificacion.id %>"
       >
         Borrar
       </button>
     </li>
     <% }) %>
   </ul>
   <div class="p-3">
     <a
       href="/enfermeria/notificaciones"
       class="btn btn-outline-primary w-100"
     >
       Ver todas las notificaciones
     </a>
   </div>
   </div>
   </div>

   <header class="navbar sticky-top bg-dark flex-md-nowrap p-0 shadow" data-bs-theme="">
    <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white" href="">XANA INDUSTRIES</a>
  
    <!--  botones para Cerrar Sesión y Manual-->
    <div style="display: flex; gap: 0.5rem; margin-left: 0;">
      <a class="btn btn-secondary" href="/cerrarSesion" aria-label="Cerrar Sesión">
        <div style="display: block">
          <img src="/imagenes/cerrar-sesion.png" alt="Cerrar Sesión" width="24" height="24" />
        </div>
      </a>
      <a class="btn btn-secondary" href="/consultarManual" aria-label="Manual">
        <div style="display: block">
          <img src="/imagenes/manual.png" alt="Manual" width="24" height="24" />
        </div>
      </a>
    </div>
  
    <!-- Espacio flexible para empujar los botones de chat y notificaciones a la derecha -->
    <div style="flex-grow: 1;"></div>
  
    <!-- Botones existentes (sin modificar) -->
    <div class="d-flex gap-2 me-3">
      <button
        class="btn btn-secondary"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#sidebarChat"
        aria-controls="sidebarMenu"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <div id="chatIcon" style="display: block">
          <img src="/imagenes/chatIcon.png" alt="Chat" width="24" height="24" />
        </div>
        <div id="chatIconNew" style="display: none">
          <img src="/imagenes/chatIconNew.png" alt="Chat Nuevo" width="24" height="24" />
        </div>
      </button>
  
      <button
        class="btn btn-secondary"
        data-bs-toggle="offcanvas"
        data-bs-target="#sidebarNotificaciones"
        aria-controls="sidebarMenu"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <div id="notIcon" style="display: block">
          <img src="/imagenes/campana.png" alt="notificacion" width="24" height="24" />
        </div>
        <div id="notIconNew" style="display: none">
          <img src="/imagenes/campanaConNotificacion.png" alt="notificacion" width="24" height="24" />
        </div>
      </button>
    </div>
  </header>

    <div class="container-fluid">
      <div class="row">
        <main class="ms-sm-auto px-md-4">
          <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"
          >
            <h1 id="nombreDelUsuario"><%= info.nombre %></h1>
            <h2>
              Enfermería<a
                href="http://"
                target="_blank"
                rel="noopener noreferrer"
              ></a>
            </h2>
          </div>
          <div class="album py-5 bg-body-tertiary">
            <div class="container">
              <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                <div class="col">
                  <div class="card shadow-sm text-center p-3">
                    <button
                      class="btn btn-light w-100"
                      id="plantaEnfermeriaBtn"
                    >
                      <img
                        src="../imagenes/imagenesEnfermeria/plantaHome.png"
                        alt="Imagen Planta"
                        class="img-fluid"
                      />
                      <span class="d-block mt-2 fw-bold">Planta</span>
                    </button>
                  </div>
                </div>
                <div class="col">
                  <div class="card shadow-sm text-center p-3">
                    <button class="btn btn-light w-100" id="cimaBtn">
                      <img
                        src="../imagenes/imagenesEnfermeria/cima.png"
                        alt="CIMA"
                        class="img-fluid"
                      />
                      <!-- Falta la imagen -->
                      <span class="d-block mt-2 fw-bold">Cima</span>
                    </button>
                  </div>
                </div>
                <div class="col">
                  <div class="card shadow-sm text-center p-3">
                    <button class="btn btn-light w-100" id="horariosBtn">
                      <img
                        src="../imagenes/imagenesEnfermeria/horarioHome.png"
                        alt="Imagen Horarios"
                        class="img-fluid"
                      />
                      <span class="d-block mt-2 fw-bold">Horarios</span>
                    </button>
                  </div>
                </div>

                <div class="col">
                  <div class="card shadow-sm text-center p-3">
                    <button
                      class="btn btn-light w-100"
                      id="comunicacionHomeBtn"
                    >
                      <img
                        src="../imagenes/imagenesEnfermeria/comunicacionHome.png"
                        alt="Imagen de Registrar paciente"
                        class="img-fluid"
                      />
                      <!-- Falta la imagen -->
                      <span class="d-block mt-2 fw-bold">Comunicación</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalLlamando"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name">Llamando</p>
                <p
                  data-Persona-a-la-que-se-llama-id=""
                  id="persona_a_la_que_se_llama"
                ></p>
              </div>
            </div>
            <div class="footer">
              <!-- Este bloque contiene el nombre y se coloca encima del segundo footer -->

              <!-- Segundo bloque de footer con los botones -->
              <button
                class="bouton raccrocher"
                id="btnFinalizarLlamando"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Finalizar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalLLamadaEnCurso"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name"></p>
                <p
                  class=""
                  data-Persona-Con-La-Que-Se-Habla-Id=""
                  id="persona_con_la_que_se_habla"
                ></p>
                <!-- Agregamos el cronómetro aquí -->
                <p id="callTimer">00:00</p>
              </div>
            </div>
            <div class="footer">
              <button
                class="bouton raccrocher"
                id="btnFinalizarLLamadaEnCurso"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Finalizar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalLlamandaEntrante"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="staticBackdropLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="card">
            <!-- Header que ya tenías -->
            <div class="header">
              <div class="contenedorInfoHeader">
                <p class="caller-name">Llamanda Entrante</p>
                <p
                  class=""
                  data-Persona-que-llama-id=""
                  id="Persona_que_llama"
                ></p>
              </div>
            </div>
            <div class="footer">
              <!-- Segundo bloque de footer con los botones -->
              <button
                class="bouton accepter"
                id="btnAceptarLlamada"
                title="Aceptar"
              >
                <span class="icon green">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M20.707 5.293a1 1 0 00-1.414 0L9 15.586 4.707 11.293a1 1 0 00-1.414 1.414l5 5a1 1 0 001.414 0l11-11a1 1 0 000-1.414z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Aceptar</span>
              </button>

              <button
                class="bouton raccrocher"
                id="btnRechazarLlamada"
                title="Rechazar"
              >
                <span class="icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24">
                    <path
                      d="M18.364 5.636a2 2 0 00-2.828 0L12 9.172 8.464 5.636a2 2 0 00-2.828 2.828L9.172 12l-3.536 3.536a2 2 0 102.828 2.828L12 14.828l3.536 3.536a2 2 0 002.828-2.828L14.828 12l3.536-3.536a2 2 0 000-2.828z"
                    />
                  </svg>
                </span>
                <span class="btn-text">Colgar</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="../assets/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/scripts/comunicacion.js"></script>




    <script>
      // Enviar mensaje al servidor

      document
        .getElementById("plantaEnfermeriaBtn")
        .addEventListener("click", () => {
          window.location.href = "/planta"; // Redirige a la página de ingreso
        });

      document.getElementById("cimaBtn").addEventListener("click", () => {
        window.location.href = "/cima/cimaHome"; // Redirige a la página de consulta
      });

      document.getElementById("horariosBtn").addEventListener("click", () => {
        window.location.href = "/enfermeria/horarios"; // Redirige a la página de ingresados
      });

      document
        .getElementById("comunicacionHomeBtn")
        .addEventListener("click", () => {
          window.location.href = "/comunicacionHome"; // Redirige a la página para modificar datos
        });
    </script>
  </body>
</html>
